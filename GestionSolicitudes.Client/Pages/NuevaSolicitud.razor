@page "/nueva-solicitud"
@page "/gestion-solicitud"
@layout MainLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject GestionSolicitudes.Client.Services.ExpedienteStateService StateService

<PageTitle>Solicitud de Residencia | DGM</PageTitle>

<div class="solicitud-container py-3 px-2 px-md-4">

    <!-- BARRA SUPERIOR LIMPIA -->
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #003876;">
                @(idiomaActual == "ES" ? "Solicitud de Residencia" : "Residence Application")
            </h2>
            <p class="text-muted small mb-0">
                @(idiomaActual == "ES" ? "Complete los datos y adjunte su documentación para radicar su expediente oficial." : "Complete the information and attach your documents to submit your official file.")
            </p>
        </div>

        <!-- Selector Bilingüe ES / EN -->
        <div class="btn-group p-1 bg-white rounded-pill border shadow-xs align-self-start align-self-sm-center">
            <button type="button" class="btn btn-sm rounded-pill py-1 px-3 fw-bold @(idiomaActual == "ES" ? "btn-primary text-white" : "btn-light text-muted")"
                    style="@(idiomaActual == "ES" ? "background-color: #003876; border-color: #003876;" : "")"
                    @onclick='() => idiomaActual = "ES"'>
                🇩🇴 ES
            </button>
            <button type="button" class="btn btn-sm rounded-pill py-1 px-3 fw-bold @(idiomaActual == "EN" ? "btn-primary text-white" : "btn-light text-muted")"
                    style="@(idiomaActual == "EN" ? "background-color: #003876; border-color: #003876;" : "")"
                    @onclick='() => idiomaActual = "EN"'>
                🇺🇸 EN
            </button>
        </div>
    </div>

    <!-- STEPPER DE 4 PASOS -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="d-flex justify-content-around position-relative align-items-center">
            <div class="step-indicator @(pasoActual >= 1 ? "active" : "") @(pasoActual > 1 ? "completed" : "")">
                <span class="step-num">1</span>
                <span class="step-text d-none d-md-inline">@(idiomaActual == "ES" ? "Datos Personales" : "Personal Info")</span>
            </div>
            <div class="step-line @(pasoActual >= 2 ? "active" : "")"></div>
            <div class="step-indicator @(pasoActual >= 2 ? "active" : "") @(pasoActual > 2 ? "completed" : "")">
                <span class="step-num">2</span>
                <span class="step-text d-none d-md-inline">@(idiomaActual == "ES" ? "Domicilio" : "Address")</span>
            </div>
            <div class="step-line @(pasoActual >= 3 ? "active" : "")"></div>
            <div class="step-indicator @(pasoActual >= 3 ? "active" : "") @(pasoActual > 3 ? "completed" : "")">
                <span class="step-num">3</span>
                <span class="step-text d-none d-md-inline">@(idiomaActual == "ES" ? "Condición" : "Status")</span>
            </div>
            <div class="step-line @(pasoActual >= 4 ? "active" : "")"></div>
            <div class="step-indicator @(pasoActual >= 4 ? "active" : "")">
                <span class="step-num">4</span>
                <span class="step-text d-none d-md-inline">@(idiomaActual == "ES" ? "Documentación" : "Documents")</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger py-2 px-3 small rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@mensajeError</div>
        </div>
    }

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white mb-5">

        @switch (pasoActual)
        {
            case 1:
                <!-- SECCIÓN 1: DATOS PERSONALES -->
                <div class="section-fade-in">
                    <div class="d-flex align-items-center gap-2 pb-2 mb-4 border-bottom">
                        <i class="bi bi-person-badge fs-4" style="color: #003876;"></i>
                        <h5 class="fw-bold mb-0" style="color: #003876;">
                            @(idiomaActual == "ES" ? "1. INFORMACIÓN DE LA PERSONA" : "1. PERSONAL INFORMATION")
                        </h5>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Nacionalidad *" : "Nationality *")</label>
                                <select class="form-select custom-input" @bind="solicitud.Nacionalidad">
                                    <option value="">-- @(idiomaActual == "ES" ? "Seleccionar" : "Select") --</option>
                                    <option value="ARG">[ARG] ARGENTINA</option>
                                    <option value="CAN">[CAN] CANADÁ</option>
                                    <option value="COL">[COL] COLOMBIA</option>
                                    <option value="ESP">[ESP] ESPAÑA</option>
                                    <option value="USA">[USA] ESTADOS UNIDOS</option>
                                    <option value="FRA">[FRA] FRANCIA</option>
                                    <option value="ITA">[ITA] ITALIA</option>
                                    <option value="MEX">[MEX] MÉXICO</option>
                                    <option value="VEN">[VEN] VENEZUELA</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Categoría de Residencia *" : "Residence Category *")</label>
                                <select class="form-select custom-input" @bind="solicitud.CategoriaResidencia">
                                    <option value="Trabajo">Residencia Temporal de Trabajo (RT-3)</option>
                                    <option value="Estudiante">Residencia Temporal de Estudiante (RE-1)</option>
                                    <option value="Familiar">Residencia por Vínculo Familiar</option>
                                    <option value="Inversionista">Residencia Inversionista / Rentista</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "No. Residencia Previa (Si aplica)" : "Previous Residence No. (If any)")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. R-098231" @bind="solicitud.NumeroResidenciaPrevia" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Nombres *" : "Given Names *")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. Camila" @bind="solicitud.Nombres" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Apellidos *" : "Surnames *")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. Batista Encarnación" @bind="solicitud.Apellidos" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Número de Pasaporte *" : "Passport Number *")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. P0948214" @bind="solicitud.NumeroPasaporte" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Fecha de Nacimiento *" : "Date of Birth *")</label>
                                <input type="date" class="form-control custom-input" @bind="solicitud.FechaNacimiento" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Sexo Correspondiente *" : "Gender *")</label>
                                <div class="toggle-pill-container custom-input p-1">
                                    <button type="button"
                                            class="toggle-pill-btn @(solicitud.Sexo == "M" ? "active" : "")"
                                            @onclick='() => solicitud.Sexo = "M"'>
                                        <i class="bi bi-gender-male me-1"></i> @(idiomaActual == "ES" ? "Masculino" : "Male")
                                    </button>
                                    <button type="button"
                                            class="toggle-pill-btn @(solicitud.Sexo == "F" ? "active" : "")"
                                            @onclick='() => solicitud.Sexo = "F"'>
                                        <i class="bi bi-gender-female me-1"></i> @(idiomaActual == "ES" ? "Femenino" : "Female")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-3 border-top">
                        <button type="button" class="btn text-white rounded-pill px-5 py-2 fw-semibold shadow-sm"
                                style="background-color: #003876;"
                                @onclick="IrAPaso2">
                            @(idiomaActual == "ES" ? "Siguiente: Domicilio y Contacto" : "Next: Address & Contact")
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>
                break;

            case 2:
                <!-- SECCIÓN 2: DOMICILIO DECLARADO -->
                <div class="section-fade-in">
                    <div class="d-flex align-items-center gap-2 pb-2 mb-4 border-bottom">
                        <i class="bi bi-geo-alt-fill fs-4" style="color: #003876;"></i>
                        <h5 class="fw-bold mb-0" style="color: #003876;">
                            @(idiomaActual == "ES" ? "2. DOMICILIO DECLARADO Y CONTACTO" : "2. RESIDENCE ADDRESS & CONTACT")
                        </h5>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Correo Electrónico *" : "Email Address *")</label>
                                <input type="email" class="form-control custom-input" placeholder="correo@ejemplo.com" @bind="solicitud.Correo" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Teléfono Fijo" : "Phone Number")</label>
                                <input type="tel" class="form-control custom-input" placeholder="809-000-0000" @bind="solicitud.Telefono" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Celular / Móvil *" : "Mobile Phone *")</label>
                                <input type="tel" class="form-control custom-input" placeholder="829-000-0000" @bind="solicitud.Celular" />
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Provincia *" : "Province *")</label>
                                <select class="form-select custom-input" @onchange="OnProvinciaChanged">
                                    <option value="">-- @(idiomaActual == "ES" ? "Seleccionar" : "Select") --</option>
                                    @foreach (var prov in ProvinciasDisponibles)
                                    {
                                        <option value="@prov" selected="@(solicitud.Provincia == prov)">@prov</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Municipio *" : "Municipality *")</label>
                                <select class="form-select custom-input" @bind="solicitud.Municipio" disabled="@(MunicipiosDisponibles.Count == 0)">
                                    <option value="">-- @(idiomaActual == "ES" ? "Seleccionar" : "Select") --</option>
                                    @foreach (var mun in MunicipiosDisponibles)
                                    {
                                        <option value="@mun">@mun</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Sector *" : "Sector *")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. Piantini, Bella Vista..." @bind="solicitud.Sector" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="floating-group">
                                <label class="floating-label">@(idiomaActual == "ES" ? "Calle, Edificio y Número *" : "Street & Building Number *")</label>
                                <input type="text" class="form-control custom-input" placeholder="Ej. Av. Central #45, Edif. Torre Real, Apto 4B" @bind="solicitud.Calle" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" @onclick="() => pasoActual = 1">
                            <i class="bi bi-arrow-left me-1"></i> @(idiomaActual == "ES" ? "Anterior" : "Back")
                        </button>
                        <button type="button" class="btn text-white rounded-pill px-5 py-2 fw-semibold shadow-sm"
                                style="background-color: #003876;"
                                @onclick="IrAPaso3">
                            @(idiomaActual == "ES" ? "Siguiente: Condición Migratoria" : "Next: Immigration Status")
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>
                break;

            case 3:
                <!-- SECCIÓN 3: CONDICIÓN MIGRATORIA -->
                <div class="section-fade-in">
                    <div class="d-flex align-items-center gap-2 pb-2 mb-4 border-bottom">
                        <i class="bi bi-question-diamond-fill fs-4" style="color: #003876;"></i>
                        <h5 class="fw-bold mb-0" style="color: #003876;">
                            @(idiomaActual == "ES" ? "3. CONDICIÓN MIGRATORIA Y ANTECEDENTES" : "3. IMMIGRATION STATUS")
                        </h5>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="p-3 rounded-4 border bg-light d-flex align-items-center justify-content-between gap-3">
                                <span class="small fw-semibold text-dark">
                                    @(idiomaActual == "ES" ? "¿Es actualmente extranjero residente en el país?" : "Are you currently a foreign resident in the country?")
                                </span>
                                <div class="toggle-pill-container" style="width: 150px;">
                                    <button type="button" class="toggle-pill-btn @(solicitud.EsResidenteActual ? "active" : "")"
                                            @onclick="() => solicitud.EsResidenteActual = true">
                                        @(idiomaActual == "ES" ? "Sí" : "Yes")
                                    </button>
                                    <button type="button" class="toggle-pill-btn @(!solicitud.EsResidenteActual ? "active" : "")"
                                            @onclick="() => solicitud.EsResidenteActual = false">
                                        No
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="p-3 rounded-4 border bg-light d-flex align-items-center justify-content-between gap-3">
                                <span class="small fw-semibold text-dark">
                                    @(idiomaActual == "ES" ? "¿Tiene nacionalidad distinta a su lugar de origen?" : "Do you hold nationality other than your birthplace?")
                                </span>
                                <div class="toggle-pill-container" style="width: 150px;">
                                    <button type="button" class="toggle-pill-btn @(solicitud.PoseeDobleNacionalidad ? "active" : "")"
                                            @onclick="() => solicitud.PoseeDobleNacionalidad = true">
                                        @(idiomaActual == "ES" ? "Sí" : "Yes")
                                    </button>
                                    <button type="button" class="toggle-pill-btn @(!solicitud.PoseeDobleNacionalidad ? "active" : "")"
                                            @onclick="() => solicitud.PoseeDobleNacionalidad = false">
                                        No
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" @onclick="() => pasoActual = 2">
                            <i class="bi bi-arrow-left me-1"></i> @(idiomaActual == "ES" ? "Anterior" : "Back")
                        </button>
                        <button type="button" class="btn text-white rounded-pill px-5 py-2 fw-semibold shadow-sm"
                                style="background-color: #003876;"
                                @onclick="() => pasoActual = 4">
                            @(idiomaActual == "ES" ? "Siguiente: Carga de Documentos" : "Next: Upload Documents")
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>
                break;

            case 4:
                <!-- SECCIÓN 4: DEPÓSITO Y CARGA DOCUMENTAL -->
                <div class="section-fade-in">
                    <div class="d-flex align-items-center gap-2 pb-2 mb-2 border-bottom">
                        <i class="bi bi-folder-check fs-4" style="color: #003876;"></i>
                        <h5 class="fw-bold mb-0" style="color: #003876;">
                            @(idiomaActual == "ES" ? "4. DEPÓSITO DE DOCUMENTOS REQUERIDOS" : "4. REQUIRED DOCUMENTS UPLOAD")
                        </h5>
                    </div>
                    <p class="text-muted small mb-4">
                        @(idiomaActual == "ES"
                                        ? "Adjunte archivos legibles en formato PDF, PNG o JPG (máximo 5 MB por documento). Estos recaudos serán evaluados por el departamento legal en el visor de auditoría."
                                        : "Attach legible files in PDF, PNG or JPG format (maximum 5 MB per document). These will be audited by the legal department in the viewer.")
            </p>

                    <div class="row g-4 mb-4">
                        <!-- Doc 1: Pasaporte -->
                        <div class="col-12 col-md-6">
                            <div class="document-upload-card @(!string.IsNullOrEmpty(docPasaporteNombre) ? "has-file" : "")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="doc-icon-box">
                                        <i class="bi bi-person-vcard fs-3 text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1">@(idiomaActual == "ES" ? "Página Biográfica del Pasaporte *" : "Passport Biographical Page *")</h6>
                                        <small class="text-muted d-block mb-2">Vigencia mínima exigida de 6 meses.</small>

                                @if (string.IsNullOrEmpty(docPasaporteNombre))
                                        {
                                            <label class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer">
                                                <i class="bi bi-upload me-1"></i> Seleccionar Archivo
                                                <InputFile OnChange="@(e => CargarArchivo(e, "Pasaporte"))" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                                                <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 80%;">
                                                    <i class="bi bi-file-earmark-check-fill text-success"></i>
                                                    <span class="small fw-semibold text-truncate">@docPasaporteNombre</span>
                                                </div>
                                                <button type="button" class="btn btn-sm text-danger p-0" @onclick='() => { docPasaporteNombre = ""; docPasaporteData = ""; }'>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Doc 2: Certificado de Antecedentes -->
                        <div class="col-12 col-md-6">
                            <div class="document-upload-card @(!string.IsNullOrEmpty(docAntecedentesNombre) ? "has-file" : "")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="doc-icon-box">
                                        <i class="bi bi-shield-check fs-3 text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1">@(idiomaActual == "ES" ? "Certificado de No Antecedentes *" : "Police Clearance Certificate *")</h6>
                                        <small class="text-muted d-block mb-2">Legalizado o apostillado oficialmente.</small>

                                        @if (string.IsNullOrEmpty(docAntecedentesNombre))
                                        {
                                            <label class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer">
                                                <i class="bi bi-upload me-1"></i> Seleccionar Archivo
                                                <InputFile OnChange="@(e => CargarArchivo(e, "Antecedentes"))" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                                                <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 80%;">
                                                    <i class="bi bi-file-earmark-check-fill text-success"></i>
                                                    <span class="small fw-semibold text-truncate">@docAntecedentesNombre</span>
                                                </div>
                                                <button type="button" class="btn btn-sm text-danger p-0" @onclick='() => { docAntecedentesNombre = ""; docAntecedentesData = ""; }'>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Doc 3: Fotografía Frontal 2x2 -->
                        <div class="col-12 col-md-6">
                            <div class="document-upload-card @(!string.IsNullOrEmpty(docFotoNombre) ? "has-file" : "")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="doc-icon-box">
                                        <i class="bi bi-person-bounding-box fs-3 text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1">@(idiomaActual == "ES" ? "Fotografía Tipo Carnet (2x2) *" : "Passport Photo (2x2) *")</h6>
                                        <small class="text-muted d-block mb-2">Fondo blanco, vista frontal sin accesorios.</small>

                                        @if (string.IsNullOrEmpty(docFotoNombre))
                                        {
                                            <label class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer">
                                                <i class="bi bi-upload me-1"></i> Seleccionar Foto
                                                <InputFile OnChange="@(e => CargarArchivo(e, "Foto"))" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                                                <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 80%;">
                                                    <i class="bi bi-image text-success"></i>
                                                    <span class="small fw-semibold text-truncate">@docFotoNombre</span>
                                                </div>
                                                <button type="button" class="btn btn-sm text-danger p-0" @onclick='() => { docFotoNombre = ""; docFotoData = ""; }'>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Doc 4: Soporte de Actividad -->
                        <div class="col-12 col-md-6">
                            <div class="document-upload-card @(!string.IsNullOrEmpty(docSoporteNombre) ? "has-file" : "")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="doc-icon-box">
                                        <i class="bi bi-file-earmark-text fs-3 text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1">@(idiomaActual == "ES" ? "Soporte de Respaldo *" : "Supporting Document *")</h6>
                                        <small class="text-muted d-block mb-2">Contrato laboral registrado o matrícula.</small>

                                        @if (string.IsNullOrEmpty(docSoporteNombre))
                                        {
                                            <label class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer">
                                                <i class="bi bi-upload me-1"></i> Seleccionar Archivo
                                                <InputFile OnChange="@(e => CargarArchivo(e, "Soporte"))" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                                                <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 80%;">
                                                    <i class="bi bi-file-earmark-check-fill text-success"></i>
                                                    <span class="small fw-semibold text-truncate">@docSoporteNombre</span>
                                                </div>
                                                <button type="button" class="btn btn-sm text-danger p-0" @onclick='() => { docSoporteNombre = ""; docSoporteData = ""; }'>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" @onclick="() => pasoActual = 3">
                            <i class="bi bi-arrow-left me-1"></i> @(idiomaActual == "ES" ? "Anterior" : "Back")
                        </button>

                        <button type="button" class="btn btn-success rounded-pill px-5 py-3 fw-bold shadow-sm"
                                @onclick="FinalizarYRadicarExpediente" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>@(idiomaActual == "ES" ? "Radicando expediente..." : "Submitting file...")</span>
                            }
                            else
                            {
                                <i class="bi bi-send-check me-1"></i>
                                <span>@(idiomaActual == "ES" ? "Finalizar y Radicar Solicitud" : "Submit Application")</span>
                            }
                        </button>
                    </div>
                </div>
                break;
        }

    </div>

</div>

<style>
