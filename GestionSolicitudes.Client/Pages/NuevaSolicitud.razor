@code {
    private int pasoActual = 1;
    private string idiomaActual = "ES";
    private string mensajeError = string.Empty;
    private bool guardando = false;

    private string docPasaporteNombre = string.Empty;
    private string docPasaporteData = string.Empty;
    private string docAntecedentesNombre = string.Empty;
    private string docAntecedentesData = string.Empty;
    private string docFotoNombre = string.Empty;
    private string docFotoData = string.Empty;
    private string docSoporteNombre = string.Empty;
    private string docSoporteData = string.Empty;

    private SolicitudModelo solicitud = new();

    private List<string> ProvinciasDisponibles = new()
    {
        "DISTRITO NACIONAL", "LA ALTAGRACIA", "LA ROMANA", "LA VEGA",
        "SANTIAGO", "PUERTO PLATA", "SAN CRISTÓBAL", "DUARTE", "SAMANÁ"
    };

    private List<string> MunicipiosDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var correo = await JS.InvokeAsync<string>("localStorage.getItem", "correoUsuario");
            var nombre = await JS.InvokeAsync<string>("localStorage.getItem", "nombreUsuario");

            if (!string.IsNullOrWhiteSpace(correo)) solicitud.Correo = correo;
            if (!string.IsNullOrWhiteSpace(nombre)) solicitud.Nombres = nombre;
        }
        catch { }
    }

    private void IrAPaso2()
    {
        mensajeError = string.Empty;
        if (string.IsNullOrWhiteSpace(solicitud.Nacionalidad) ||
            string.IsNullOrWhiteSpace(solicitud.Nombres) ||
            string.IsNullOrWhiteSpace(solicitud.Apellidos) ||
            string.IsNullOrWhiteSpace(solicitud.NumeroPasaporte))
        {
            mensajeError = idiomaActual == "ES"
                ? "Por favor complete la nacionalidad, nombres, apellidos y número de pasaporte antes de continuar."
                : "Please complete nationality, given names, surnames, and passport number before continuing.";
            return;
        }
        pasoActual = 2;
    }

    private void IrAPaso3()
    {
        mensajeError = string.Empty;
        if (string.IsNullOrWhiteSpace(solicitud.Correo) ||
            string.IsNullOrWhiteSpace(solicitud.Celular) ||
            string.IsNullOrWhiteSpace(solicitud.Provincia))
        {
            mensajeError = idiomaActual == "ES"
                ? "Por favor complete el correo, celular y provincia de residencia."
                : "Please complete email, mobile phone, and residence province.";
            return;
        }
        pasoActual = 3;
    }

    private void OnProvinciaChanged(ChangeEventArgs e)
    {
        solicitud.Provincia = e.Value?.ToString() ?? "";
        MunicipiosDisponibles.Clear();

        if (solicitud.Provincia == "LA ALTAGRACIA")
        {
            MunicipiosDisponibles.AddRange(new[] { "HIGÜEY", "SAN RAFAEL DEL YUMA", "PUNTA CANA / BÁVARO" });
        }
        else if (solicitud.Provincia == "DISTRITO NACIONAL")
        {
            MunicipiosDisponibles.AddRange(new[] { "SANTO DOMINGO DE GUZMÁN" });
        }
        else if (solicitud.Provincia == "SANTIAGO")
        {
            MunicipiosDisponibles.AddRange(new[] { "SANTIAGO DE LOS CABALLEROS", "VILLA BISONÓ", "TAMBORIL" });
        }
        else
        {
            MunicipiosDisponibles.Add("MUNICIPIO CABECERA");
        }
    }

    private async Task CargarArchivo(InputFileChangeEventArgs e, string tipo)
    {
        var archivo = e.File;
        if (archivo != null)
        {
            try
            {
                using var stream = archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                var base64 = Convert.ToBase64String(ms.ToArray());
                var dataUrl = $"data:{archivo.ContentType};base64,{base64}";
                var esImg = archivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

                switch (tipo)
                {
                    case "Pasaporte":
                        docPasaporteNombre = archivo.Name;
                        docPasaporteData = dataUrl;
                        StateService.DocPasaporteNombre = archivo.Name;
                        StateService.DocPasaporteData = dataUrl;
                        StateService.RegistrarDocumento("Página Biográfica del Pasaporte", archivo.Name, dataUrl, esImg, "bi-person-vcard");
                        break;
                    case "Foto":
                        docFotoNombre = archivo.Name;
                        docFotoData = dataUrl;
                        StateService.DocFotoNombre = archivo.Name;
                        StateService.DocFotoData = dataUrl;
                        StateService.RegistrarDocumento("Fotografía Frontal 2x2", archivo.Name, dataUrl, esImg, "bi-person-bounding-box");
                        break;
                    case "Antecedentes":
                        docAntecedentesNombre = archivo.Name;
                        docAntecedentesData = dataUrl;
                        StateService.DocAntecedentesNombre = archivo.Name;
                        StateService.DocAntecedentesData = dataUrl;
                        StateService.RegistrarDocumento("Certificado de No Antecedentes Penales", archivo.Name, dataUrl, esImg, "bi-shield-check");
                        break;
                    case "Soporte":
                        docSoporteNombre = archivo.Name;
                        docSoporteData = dataUrl;
                        StateService.DocSoporteNombre = archivo.Name;
                        StateService.DocSoporteData = dataUrl;
                        StateService.RegistrarDocumento("Soporte de Actividad (Contrato Laboral)", archivo.Name, dataUrl, esImg, "bi-file-earmark-text");
                        break;
                }
            }
            catch (Exception ex)
            {
                mensajeError = $"Error al procesar '{archivo.Name}': {ex.Message}";
            }
        }
    }

    private async Task FinalizarYRadicarExpediente()
    {
        mensajeError = string.Empty;
        guardando = true;
        try
        {
            bool sinDocumentos = string.IsNullOrEmpty(docPasaporteNombre) && string.IsNullOrEmpty(docFotoNombre) && string.IsNullOrEmpty(docAntecedentesNombre) && string.IsNullOrEmpty(docSoporteNombre);

            StateService.SolicitudIniciada = true;
            StateService.Titular = $"{solicitud.Nombres} {solicitud.Apellidos}";
            StateService.Categoria = solicitud.CategoriaResidencia;
            StateService.Pasaporte = solicitud.NumeroPasaporte;
            StateService.Correo = solicitud.Correo;
            StateService.Nacionalidad = solicitud.Nacionalidad;
            StateService.EstadoGeneral = sinDocumentos ? "Sin Documentación" : "Pendiente";

            StateService.DocPasaporteNombre = docPasaporteNombre;
            StateService.DocPasaporteData = docPasaporteData;
            StateService.DocFotoNombre = docFotoNombre;
            StateService.DocFotoData = docFotoData;
            StateService.DocAntecedentesNombre = docAntecedentesNombre;
            StateService.DocAntecedentesData = docAntecedentesData;
            StateService.DocSoporteNombre = docSoporteNombre;
            StateService.DocSoporteData = docSoporteData;

            int nuevoId = StateService.ListaExpedientes.Count + 1;
            var nuevoExpediente = new ExpedienteDto
            {
                Id = nuevoId,
                Radicado = $"#{nuevoId:D3}",
                Titular = StateService.Titular,
                Categoria = $"Residencia ({StateService.Categoria})",
                Pasaporte = StateService.Pasaporte,
                Nacionalidad = StateService.Nacionalidad,
                Correo = StateService.Correo,
                FechaRegistro = DateTime.Now.ToString("dd/MM/yyyy"),
                Estado = StateService.EstadoGeneral,
                DocPasaporteNombre = docPasaporteNombre,
                DocPasaporteData = docPasaporteData,
                DocFotoNombre = docFotoNombre,
                DocFotoData = docFotoData,
                DocAntecedentesNombre = docAntecedentesNombre,
                DocAntecedentesData = docAntecedentesData,
                DocSoporteNombre = docSoporteNombre,
                DocSoporteData = docSoporteData
            };

            StateService.RegistrarExpediente(nuevoExpediente);

            await JS.InvokeVoidAsync("localStorage.setItem", "solicitudIniciada", "true");
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_titular", StateService.Titular);
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_categoria", StateService.Categoria);
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_pasaporte", StateService.Pasaporte);
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_correo", StateService.Correo);
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_nacionalidad", StateService.Nacionalidad);
            await JS.InvokeVoidAsync("localStorage.setItem", "expediente_estado", StateService.EstadoGeneral);

            await Task.Delay(500);
            Navigation.NavigateTo("/mis-solicitudes");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al radicar solicitud: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    public class SolicitudModelo
    {
        public string Nacionalidad { get; set; } = string.Empty;
        public string CategoriaResidencia { get; set; } = "Trabajo";
        public string NumeroResidenciaPrevia { get; set; } = string.Empty;
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string NumeroPasaporte { get; set; } = string.Empty;
        public DateTime? FechaNacimiento { get; set; } = new DateTime(1996, 1, 1);
        public string Sexo { get; set; } = "F";
        public string Correo { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Celular { get; set; } = string.Empty;
        public string Provincia { get; set; } = string.Empty;
        public string Municipio { get; set; } = string.Empty;
        public string Sector { get; set; } = string.Empty;
        public string Calle { get; set; } = string.Empty;
        public bool EsResidenteActual { get; set; } = false;
        public bool PoseeDobleNacionalidad { get; set; } = false;
    }
}