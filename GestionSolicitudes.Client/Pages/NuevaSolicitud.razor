@code {
    private int pasoActual = 1;
    private string idiomaActual = "ES";
    private string mensajeError = string.Empty;
    private bool guardando = false;
    private int idCreado = 0;

    private SolicitudModelo solicitud = new();

    private List<DocSlot> slots = new()
    {
        new DocSlot { Tipo = "Página Biográfica del Pasaporte", TituloEs = "Página Biográfica del Pasaporte *", TituloEn = "Passport Biographical Page *", Nota = "Vigencia mínima exigida de 6 meses.", Icono = "bi-person-vcard" },
        new DocSlot { Tipo = "Certificado de Antecedentes Penales", TituloEs = "Certificado de No Antecedentes *", TituloEn = "Police Clearance Certificate *", Nota = "Legalizado o apostillado oficialmente.", Icono = "bi-shield-check" },
        new DocSlot { Tipo = "Fotografía Tipo Carnet (2x2)", TituloEs = "Fotografía Tipo Carnet (2x2) *", TituloEn = "Passport Photo (2x2) *", Nota = "Fondo blanco, vista frontal sin accesorios.", Icono = "bi-person-bounding-box" },
        new DocSlot { Tipo = "Soporte de Respaldo / Contrato", TituloEs = "Soporte de Respaldo *", TituloEn = "Supporting Document *", Nota = "Contrato laboral registrado o matrícula.", Icono = "bi-file-earmark-text" }
    };

    private List<string> ProvinciasDisponibles = new()
    {
        "DISTRITO NACIONAL", "LA ALTAGRACIA", "LA ROMANA", "LA VEGA",
        "SANTIAGO", "PUERTO PLATA", "SAN CRISTÓBAL", "DUARTE", "SAMANÁ"
    };

    private List<string> MunicipiosDisponibles = new();

    private string T(string es, string en) => idiomaActual == "ES" ? es : en;

    protected override async Task OnInitializedAsync()
    {
        await ConfigurarHeaderAuth();

        try
        {
            var correo = await JS.InvokeAsync<string>("localStorage.getItem", "correoUsuario");
            var nombre = await JS.InvokeAsync<string>("localStorage.getItem", "nombreUsuario");

            if (!string.IsNullOrWhiteSpace(correo)) solicitud.Correo = correo;
            if (!string.IsNullOrWhiteSpace(nombre)) solicitud.Nombres = nombre;
        }
        catch { }
    }

    // Envía el token para que la solicitud quede asociada al usuario que la radica
    private async Task ConfigurarHeaderAuth()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
        }
        catch { }
    }

    private void IrAPaso2()
    {
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(solicitud.Nacionalidad) ||
            string.IsNullOrWhiteSpace(solicitud.Nombres) ||
            string.IsNullOrWhiteSpace(solicitud.Apellidos) ||
            string.IsNullOrWhiteSpace(solicitud.NumeroPasaporte))
        {
            mensajeError = T(
                "Por favor complete la nacionalidad, nombres, apellidos y número de pasaporte antes de continuar.",
                "Please complete nationality, given names, surnames, and passport number before continuing.");
            return;
        }

        if (solicitud.FechaNacimiento == null || solicitud.FechaNacimiento.Value.Date >= DateTime.Today)
        {
            mensajeError = T(
                "Indique una fecha de nacimiento válida.",
                "Please enter a valid date of birth.");
            return;
        }

        pasoActual = 2;
    }

    private void IrAPaso3()
    {
        mensajeError = string.Empty;
        if (string.IsNullOrWhiteSpace(solicitud.Correo) ||
            string.IsNullOrWhiteSpace(solicitud.Celular) ||
            string.IsNullOrWhiteSpace(solicitud.Provincia))
        {
            mensajeError = T(
                "Por favor complete el correo, celular y provincia de residencia.",
                "Please complete email, mobile phone, and residence province.");
            return;
        }
        pasoActual = 3;
    }

    private void OnProvinciaChanged(ChangeEventArgs e)
    {
        solicitud.Provincia = e.Value?.ToString() ?? "";
        MunicipiosDisponibles.Clear();

        if (solicitud.Provincia == "LA ALTAGRACIA")
        {
            MunicipiosDisponibles.AddRange(new[] { "HIGÜEY", "SAN RAFAEL DEL YUMA", "PUNTA CANA / BÁVARO" });
        }
        else if (solicitud.Provincia == "DISTRITO NACIONAL")
        {
            MunicipiosDisponibles.AddRange(new[] { "SANTO DOMINGO DE GUZMÁN" });
        }
        else if (solicitud.Provincia == "SANTIAGO")
        {
            MunicipiosDisponibles.AddRange(new[] { "SANTIAGO DE LOS CABALLEROS", "VILLA BISONÓ", "TAMBORIL" });
        }
        else
        {
            MunicipiosDisponibles.Add("MUNICIPIO CABECERA");
        }
    }

    // ---------- Documentos ----------
    private async Task CargarArchivo(InputFileChangeEventArgs e, DocSlot slot)
    {
        mensajeError = string.Empty;
        var archivo = e.File;
        if (archivo == null) return;

        var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
        {
            mensajeError = T(
                $"'{archivo.Name}' no es un formato permitido. Use PDF, JPG o PNG.",
                $"'{archivo.Name}' is not an allowed format. Use PDF, JPG or PNG.");
            return;
        }

        if (archivo.Size > MaxBytes)
        {
            mensajeError = T(
                $"'{archivo.Name}' supera el máximo de 5 MB.",
                $"'{archivo.Name}' exceeds the 5 MB limit.");
            return;
        }

        try
        {
            using var stream = archivo.OpenReadStream(maxAllowedSize: MaxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            slot.Bytes = ms.ToArray();
            slot.Nombre = archivo.Name;
            slot.Subido = false;
            slot.Error = string.Empty;
        }
        catch (Exception ex)
        {
            mensajeError = T(
                $"Error al procesar '{archivo.Name}': {ex.Message}",
                $"Error processing '{archivo.Name}': {ex.Message}");
        }
    }

    private void QuitarArchivo(DocSlot slot)
    {
        slot.Bytes = null;
        slot.Nombre = string.Empty;
        slot.Subido = false;
        slot.Error = string.Empty;
    }

    // ---------- Radicación ----------
    private async Task FinalizarYRadicarExpediente()
    {
        if (guardando) return;
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(solicitud.Nombres) || string.IsNullOrWhiteSpace(solicitud.Apellidos))
        {
            mensajeError = T("El nombre y apellido del solicitante son obligatorios.", "Given names and surnames are required.");
            return;
        }

        var faltantes = slots.Where(s => s.Bytes == null).ToList();
        if (faltantes.Any())
        {
            var lista = string.Join(", ", faltantes.Select(s => s.Tipo));
            mensajeError = T(
                $"Debe adjuntar todos los documentos requeridos. Faltan: {lista}.",
                $"You must attach all required documents. Missing: {lista}.");
            return;
        }

        guardando = true;

        try
        {
            await ConfigurarHeaderAuth();

            // 1) Crear la solicitud (solo una vez, aunque se reintente la subida)
            if (idCreado == 0)
            {
                int categoriaInt = solicitud.CategoriaResidencia switch
                {
                    "Estudiante" => 2,
                    "Familiar" => 3,
                    "Inversionista" => 4,
                    _ => 1
                };

                var dto = new
                {
                    Titulo = $"Residencia Temporal ({solicitud.CategoriaResidencia})",
                    Solicitante = $"{solicitud.Nombres} {solicitud.Apellidos}".Trim(),
                    Descripcion = $"Trámite de residencia radicado por {solicitud.Nombres} {solicitud.Apellidos}.",
                    Tipo = 1, // TipoSolicitud.Nueva
                    Categoria = categoriaInt,
                    Nombres = solicitud.Nombres.Trim(),
                    Apellidos = solicitud.Apellidos.Trim(),
                    NumeroPasaporte = solicitud.NumeroPasaporte.Trim(),
                    Nacionalidad = solicitud.Nacionalidad,
                    FechaNacimiento = solicitud.FechaNacimiento,
                    Sexo = solicitud.Sexo,
                    Correo = solicitud.Correo.Trim(),
                    Telefono = solicitud.Telefono.Trim(),
                    Celular = solicitud.Celular.Trim(),
                    Provincia = solicitud.Provincia,
                    Municipio = solicitud.Municipio,
                    Sector = solicitud.Sector.Trim(),
                    Calle = solicitud.Calle.Trim(),
                    EsResidenteActual = solicitud.EsResidenteActual,
                    PoseeDobleNacionalidad = solicitud.PoseeDobleNacionalidad,
                    NumeroResidenciaPrevia = solicitud.NumeroResidenciaPrevia.Trim()
                };

                var response = await Http.PostAsJsonAsync("api/solicitud/radicar", dto);

                if (!response.IsSuccessStatusCode)
                {
                    var errorContenido = await response.Content.ReadAsStringAsync();
                    mensajeError = T(
                        $"Error al radicar en el servidor: {Resumir(errorContenido)}",
                        $"Error submitting to the server: {Resumir(errorContenido)}");
                    return;
                }

                var radicadoResult = await response.Content.ReadFromJsonAsync<RadicarRespuestaDto>();
                idCreado = radicadoResult?.Id ?? 0;

                if (idCreado <= 0)
                {
                    mensajeError = T(
                        "El servidor no devolvió el número de la solicitud. Intente nuevamente.",
                        "The server did not return the application number. Please try again.");
                    return;
                }
            }

            // 2) Subir los documentos pendientes y verificar cada respuesta
            var fallidos = new List<string>();

            foreach (var slot in slots.Where(s => !s.Subido))
            {
                var error = await SubirArchivoReal(idCreado, slot);
                if (error == null)
                {
                    slot.Subido = true;
                    slot.Error = string.Empty;
                }
                else
                {
                    slot.Error = error;
                    fallidos.Add(slot.Tipo);
                }
            }

            if (fallidos.Any())
            {
                mensajeError = T(
                    $"Su solicitud fue radicada, pero no se pudieron enviar estos documentos: {string.Join(", ", fallidos)}. Presione \"Reintentar envío de documentos\".",
                    $"Your application was submitted, but these documents could not be sent: {string.Join(", ", fallidos)}. Press \"Retry document upload\".");
                return;
            }

            await Task.Delay(400);
            Navigation.NavigateTo("/mis-solicitudes");
        }
        catch (Exception ex)
        {
            mensajeError = T(
                $"Error de conexión con el servidor: {ex.Message}",
                $"Connection error with the server: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }

    // Devuelve null si se subió bien, o el mensaje de error
    private async Task<string?> SubirArchivoReal(int solicitudId, DocSlot slot)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(solicitudId.ToString()), "solicitudId");
            content.Add(new StringContent(slot.Tipo), "tipoDocumento");

            var fileContent = new ByteArrayContent(slot.Bytes!);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(ObtenerMimeType(slot.Nombre));
            content.Add(fileContent, "archivo", slot.Nombre);

            var response = await Http.PostAsync("api/solicitud/subir-documento", content);
            if (response.IsSuccessStatusCode) return null;

            var detalle = await response.Content.ReadAsStringAsync();
            return T(
                $"No se pudo enviar (código {(int)response.StatusCode}). {Resumir(detalle)}",
                $"Could not be sent (code {(int)response.StatusCode}). {Resumir(detalle)}");
        }
        catch (Exception ex)
        {
            return ex.Message;
        }
    }

    private static string Resumir(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;
        texto = texto.Trim();
        return texto.Length > 120 ? texto.Substring(0, 120) + "..." : texto;
    }

    private string ObtenerMimeType(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLower();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            _ => "application/octet-stream"
        };
    }

    private const int MaxBytes = 5 * 1024 * 1024;

    // ---------- Modelos ----------
    private class DocSlot
    {
        public string Tipo { get; set; } = string.Empty;
        public string TituloEs { get; set; } = string.Empty;
        public string TituloEn { get; set; } = string.Empty;
        public string Nota { get; set; } = string.Empty;
        public string Icono { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public byte[]? Bytes { get; set; }
        public bool Subido { get; set; }
        public string Error { get; set; } = string.Empty;
    }

    public class SolicitudModelo
    {
        public string Nacionalidad { get; set; } = string.Empty;
        public string CategoriaResidencia { get; set; } = "Trabajo";
        public string NumeroResidenciaPrevia { get; set; } = string.Empty;
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string NumeroPasaporte { get; set; } = string.Empty;
        public DateTime? FechaNacimiento { get; set; }
        public string Sexo { get; set; } = "F";
        public string Correo { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Celular { get; set; } = string.Empty;
        public string Provincia { get; set; } = string.Empty;
        public string Municipio { get; set; } = string.Empty;
        public string Sector { get; set; } = string.Empty;
        public string Calle { get; set; } = string.Empty;
        public bool EsResidenteActual { get; set; } = false;
        public bool PoseeDobleNacionalidad { get; set; } = false;
    }

    public class RadicarRespuestaDto
    {
        public string Mensaje { get; set; } = string.Empty;
        public int Id { get; set; }
    }
}