@page "/solicitudes"
@layout MainLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject GestionSolicitudes.Client.Services.ExpedienteStateService StateService
@using GestionSolicitudes.Client.DTOs
<PageTitle>Gestión de Solicitudes | DGM</PageTitle>

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- ========================================================================= -->
    <!-- 1. CABECERA Y BARRA DE BÚSQUEDA                                           -->
    <!-- ========================================================================= -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #003876;">
                <i class="bi bi-folder2-open me-2"></i> Gestión de Solicitudes
            </h3>
            <p class="text-muted small mb-0">Administración, seguimiento y resolución de expedientes migratorios</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1 bg-white shadow-xs" @onclick="ActualizarBandeja">
                <i class="bi bi-arrow-clockwise"></i> Actualizar Bandeja
            </button>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                Total de expedientes: @TotalExpedientes
            </span>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA RÁPIDA -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="input-group">
            <span class="input-group-text bg-light border-0 ps-3 rounded-start-pill text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control border-0 bg-light py-2 shadow-none"
                   placeholder="Buscar por radicado, título o solicitante..."
                   @bind="terminoBusqueda" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                <button class="btn btn-light border-0 text-muted px-3" @onclick="() => terminoBusqueda = string.Empty">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. TABLA DE GESTIÓN DE EXPEDIENTES                                        -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #003876; color: #ffffff;">
                    <tr class="small text-uppercase tracking-wider">
                        <th class="py-3 px-3">Radicado</th>
                        <th class="py-3">Título / Asunto</th>
                        <th class="py-3">Solicitante</th>
                        <th class="py-3">Fecha Registro</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="py-3 text-end px-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ExpedientesPaginados.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                <span>No se encontraron expedientes registrados con los criterios de búsqueda.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ExpedientesPaginados)
                        {
                            <tr>
                                <td class="px-3 fw-bold text-primary">@item.Radicado</td>
                                <td>
                                    <strong class="d-block text-dark small">@item.Categoria</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Pasaporte: @item.Pasaporte</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">@GetIniciales(item.Titular)</div>
                                        <span class="fw-semibold text-dark small">@GetNombreTitular(item.Titular)</span>
                                    </div>
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-calendar3 me-1"></i> @item.FechaRegistro
                                </td>
                                <td class="text-center">
                                    <span class="badge @ObtenerBadgeEstado(item.Estado) px-3 py-1 rounded-pill" style="font-size: 0.75rem;">
                                        @item.Estado
                                    </span>
                                </td>
                                <td class="text-end px-3">
                                    <!-- Botón Directo a Revisión para auditar datos y documentos reales -->
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs"
                                            @onclick="() => MandarARevision(item.Id)" title="Auditar expediente y ver documentos">
                                        <i class="bi bi-eye"></i>
                                        <span>Revisar</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. PAGINACIÓN MINIMALISTA Y CONTADOR INFERIOR                             -->
    <!-- ========================================================================= -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 px-1">
        <span class="text-muted small">
            Mostrando @ExpedientesPaginados.Count de @TotalExpedientes solicitudes registradas
        </span>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold shadow-xs"
                    @onclick="PaginaAnterior" disabled="@(!TieneAnterior())"
                    style="@(!TieneAnterior() ? "background-color: #f1f5f9; color: #94a3b8; border-color: #cbd5e1;" : "")">
                <i class="bi bi-chevron-left me-1"></i> Anterior
            </button>

            <span class="small fw-bold text-dark px-2">
                Página @paginaActual de @Math.Max(1, TotalPaginas)
            </span>

            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold shadow-xs"
                    @onclick="PaginaSiguiente" disabled="@(!TieneSiguiente())"
                    style="@(!TieneSiguiente() ? "background-color: #f1f5f9; color: #94a3b8; border-color: #cbd5e1;" : "")">
                Siguiente <i class="bi bi-chevron-right ms-1"></i>
            </button>
        </div>
    </div>

</div>

<style>
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #e2e8f0;
        color: #003876;
        font-weight: bold;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private string terminoBusqueda = string.Empty;
    private int paginaActual = 1;
    private const int elementosPorPagina = 20;

    // MÉTODO: OnInitializedAsync (Carga y sincroniza el estado global)
    protected override async Task OnInitializedAsync()
    {
        await StateService.InicializarAsync();
    }

    // PROPIEDAD: Lista filtrada por la barra de búsqueda en tiempo real
    private List<GestionSolicitudes.Client.DTOs.ExpedienteDto> ExpedientesFiltrados
    {
        get
        {
            var lista = StateService.ListaExpedientes ?? new();
            if (string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                return lista;
            }
            return lista.Where(e =>
                (!string.IsNullOrEmpty(e.Radicado) && e.Radicado.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Titular) && e.Titular.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Categoria) && e.Categoria.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Pasaporte) && e.Pasaporte.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    private int TotalExpedientes => ExpedientesFiltrados.Count;

    private int TotalPaginas => (int)Math.Ceiling((double)TotalExpedientes / elementosPorPagina);

    // PROPIEDAD: Aplica el límite de 20 elementos por página con paginación
    private List<GestionSolicitudes.Client.DTOs.ExpedienteDto> ExpedientesPaginados
    {
        get
        {
            if (paginaActual > TotalPaginas && TotalPaginas > 0)
            {
                paginaActual = TotalPaginas;
            }
            return ExpedientesFiltrados
                .Skip((paginaActual - 1) * elementosPorPagina)
                .Take(elementosPorPagina)
                .ToList();
        }
    }

    private bool TieneAnterior() => paginaActual > 1;
    private bool TieneSiguiente() => paginaActual < TotalPaginas;

    private void PaginaAnterior()
    {
        if (TieneAnterior()) paginaActual--;
    }

    private void PaginaSiguiente()
    {
        if (TieneSiguiente()) paginaActual++;
    }

    private async Task ActualizarBandeja()
    {
        await StateService.InicializarAsync();
        terminoBusqueda = string.Empty;
        paginaActual = 1;
    }

    private void MandarARevision(int id)
    {
        Navigation.NavigateTo($"/revision/{id}");
    }

    private static string GetIniciales(string? titular)
    {
        if (string.IsNullOrWhiteSpace(titular))
            return "US";

        var nombre = titular.Trim();

        return nombre.Length >= 2
            ? nombre.Substring(0, 2).ToUpperInvariant()
            : nombre.ToUpperInvariant();
    }

    private static string GetNombreTitular(string? titular)
    {
        return string.IsNullOrWhiteSpace(titular) ? "Solicitante" : titular;
    }

    private string ObtenerBadgeEstado(string estado) => estado switch
    {
        "Aprobado" => "bg-success text-white",
        "En Revisión" => "bg-primary text-white",
        "Pendiente" => "bg-warning text-dark",
        "Subsanación Requerida" => "bg-warning text-dark",
        "Rechazado" => "bg-danger text-white",
        "Sin Documentación" => "bg-dark text-white",
        _ => "bg-secondary text-white"
    };
}