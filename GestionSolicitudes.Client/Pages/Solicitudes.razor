@code {
    private List<SolicitudDto> solicitudes = new();
    private bool cargando = true;
    private bool guardando = false;
    private string terminoBusqueda = string.Empty;
    private int paginaActual = 1;
    private int tamanoPagina = 6;
    private int totalRegistros = 0;

    private bool mostrarModal = false;
    private SolicitudDto? solicitudSeleccionada;
    private int idEdicion = 0;
    private int estadoEdicion = 1;

    // Control de documentos en el modal
    private List<DocumentoDto> documentosExpediente = new();
    private bool cargandoDocsModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        cargando = true;
        try
        {
            var resultado = await SolicitudService.ObtenerTodasAsync(terminoBusqueda, paginaActual, tamanoPagina);
            totalRegistros = resultado.Total;
            solicitudes = resultado.Solicitudes;
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error de conexión", "No se pudieron cargar las solicitudes: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Buscar()
    {
        paginaActual = 1;
        await CargarSolicitudes();
    }

    private async Task LimpiarBusqueda()
    {
        terminoBusqueda = string.Empty;
        await Buscar();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (nuevaPagina - 1) * tamanoPagina >= totalRegistros) return;
        paginaActual = nuevaPagina;
        await CargarSolicitudes();
    }

    private async Task MandarARevision(SolicitudDto item)
    {
        try
        {
            var respuesta = await Http.PatchAsJsonAsync($"api/solicitud/{item.Id}/estado", new { NuevoEstado = 2 });
            if (respuesta.IsSuccessStatusCode)
            {
                item.Estado = 2;
                if (solicitudSeleccionada != null && solicitudSeleccionada.Id == item.Id)
                {
                    solicitudSeleccionada.Estado = 2;
                    estadoEdicion = 2;
                }

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "En Revisión",
                    Text = $"El expediente #{item.Id:D4} ha sido enviado a revisión operativa.",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });

                await CargarSolicitudes();
            }
            else
            {
                await Swal.FireAsync("Error", "No se pudo cambiar el estado a revisión.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Ocurrió un problema: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task AbrirModalDetalle(SolicitudDto solicitud)
    {
        solicitudSeleccionada = solicitud;
        idEdicion = solicitud.Id;
        estadoEdicion = solicitud.Estado;
        mostrarModal = true;
        await CargarDocumentosDelExpediente(solicitud.Id);
    }

    private async Task CargarDocumentosDelExpediente(int solicitudId)
    {
        cargandoDocsModal = true;
        documentosExpediente.Clear();
        try
        {
            var docs = await Http.GetFromJsonAsync<List<DocumentoDto>>($"api/solicitud/{solicitudId}/documentos");
            if (docs != null)
            {
                documentosExpediente = docs;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar documentos: {ex.Message}");
        }
        finally
        {
            cargandoDocsModal = false;
        }
    }

    private async Task CambiarEstadoDocumento(DocumentoDto doc, string nuevoEstado)
    {
        try
        {
            var respuesta = await Http.PatchAsJsonAsync($"api/solicitud/documento/{doc.Id}/estado", new { NuevoEstado = nuevoEstado });
            if (respuesta.IsSuccessStatusCode)
            {
                doc.Estado = nuevoEstado;
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Requisito Auditado",
                    Text = $"El documento '{doc.Nombre}' fue marcado como: {nuevoEstado}.",
                    Icon = nuevoEstado == "Aprobado" ? SweetAlertIcon.Success : SweetAlertIcon.Warning,
                    Timer = 1500,
                    ShowConfirmButton = false
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "No se pudo cambiar el estado del documento: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        solicitudSeleccionada = null;
        documentosExpediente.Clear();
    }

    private async Task ActualizarEstadoModal()
    {
        guardando = true;
        try
        {
            var respuesta = await Http.PatchAsJsonAsync($"api/solicitud/{idEdicion}/estado", new { NuevoEstado = estadoEdicion });
            if (respuesta.IsSuccessStatusCode)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Actualizado!",
                    Text = "El estado del expediente fue actualizado correctamente.",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });

                await CargarSolicitudes();
                CerrarModal();
            }
            else
            {
                await Swal.FireAsync("Error", "No se pudo actualizar el estado.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Ocurrió un problema: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task ConfirmarEliminar(int id, string nombreSolicitante)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar expediente?",
            Text = $"¿Confirma la eliminación de la solicitud de {nombreSolicitante}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar",
            ConfirmButtonColor = "#dc3545",
            CancelButtonColor = "#6c757d"
        });

        if (result.IsConfirmed)
        {
            var exito = await SolicitudService.DesactivarAsync(id);
            if (exito)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Eliminado",
                    Text = "El expediente ha sido eliminado del sistema.",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });
                await CargarSolicitudes();
            }
            else
            {
                await Swal.FireAsync("Error", "No se pudo eliminar la solicitud.", SweetAlertIcon.Error);
            }
        }
    }

    private string ObtenerClaseBadgeDoc(string estado) => estado switch
    {
        "Aprobado" => "bg-success-subtle text-success border border-success-subtle",
        "Rechazado" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning border border-warning-subtle"
    };

    private string ObtenerClaseEstado(int estado)
    {
        return estado switch
        {
            1 => "status-pendiente",
            2 => "status-proceso",
            3 => "status-aprobada",
            4 => "status-rechazada",
            5 => "status-cancelada",
            _ => "status-cancelada"
        };
    }

    private string ObtenerNombreEstado(int estado)
    {
        return estado switch
        {
            1 => "Pendiente",
            2 => "En proceso",
            3 => "Aprobada",
            4 => "Rechazada",
            5 => "Cancelada",
            _ => "Desconocido"
        };
    }
}