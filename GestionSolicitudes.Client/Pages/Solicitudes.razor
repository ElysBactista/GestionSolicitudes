@page "/solicitudes"
@inject IJSRuntime JS
@using GestionSolicitudes.Client.DTOs
@using GestionSolicitudes.Client.Services
@inject SweetAlertService Swal
@inject SolicitudClientService SolicitudService
@inject HttpClient Http

<PageTitle>Gestión de Solicitudes - DGM</PageTitle>

<div class="container-fluid px-4 py-4">

    <!-- Encabezado Institucional -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 header-title">
                <i class="bi bi-folder2-open text-primary me-2"></i>Gestión de Solicitudes
            </h2>
            <p class="text-muted mb-0 small">
                Administración, seguimiento y resolución de expedientes migratorios
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <button class="btn btn-sm btn-light border text-dark fw-medium px-3 shadow-sm" @onclick="CargarSolicitudes">
                <i class="bi bi-arrow-clockwise text-primary me-1"></i> Actualizar Bandeja
            </button>
        </div>
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 filter-card">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-7 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por radicado, título o solicitante..."
                               @bind="terminoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="Buscar" />
                        @if (!string.IsNullOrEmpty(terminoBusqueda))
                        {
                            <button class="btn btn-outline-secondary border-start-0 border-end-0" type="button" @onclick="LimpiarBusqueda">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                        <button class="btn text-white px-4"
                                style="background: #003876 !important; border-color: #003876 !important;"
                                type="button"
                                @onclick="Buscar">
                            Buscar
                        </button>
                    </div>
                </div>

                <div class="col-md-5 col-lg-4 text-md-end text-muted small">
                    <span>Total de expedientes: <strong>@totalRegistros</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido: Spinner, Vacío o Tabla -->
    @if (cargando)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-3 fw-semibold">Consultando registros...</p>
        </div>
    }
    else if (solicitudes == null || !solicitudes.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center p-5 my-4">
            <div class="card-body">
                <i class="bi bi-inbox text-muted display-3 mb-3"></i>
                <h5 class="fw-bold text-secondary">No se encontraron solicitudes</h5>
                <p class="text-muted small mb-0">
                    @(string.IsNullOrEmpty(terminoBusqueda) ? "Aún no se han registrado expedientes por parte de los residentes." : $"No hay resultados para la búsqueda '{terminoBusqueda}'.")
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- Tabla de Datos Principal -->
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-header">
                        <tr>
                            <th class="ps-4">RADICADO</th>
                            <th>TÍTULO / ASUNTO</th>
                            <th>SOLICITANTE</th>
                            <th>FECHA REGISTRO</th>
                            <th>ESTADO</th>
                            <th class="text-center pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in solicitudes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-primary border border-primary fw-bold">
                                        #@item.Id.ToString("D4")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Titulo</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 280px;">
                                            @item.Descripcion
                                        </small>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            @(string.IsNullOrWhiteSpace(item.Solicitante) ? "U" : item.Solicitante.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@item.Solicitante</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                                        @item.FechaCreacion.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-status @ObtenerClaseEstado(item.Estado)">
                                        @ObtenerNombreEstado(item.Estado)
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <!-- Botón Ver / Detalle -->
                                        <button class="btn btn-action btn-edit"
                                                title="Ver detalle del expediente"
                                                @onclick="() => AbrirModalDetalle(item)">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        <!-- Botón Mandar a Revisión (solo si está Pendiente) -->
                                        @if (item.Estado == 1)
                                        {
                                            <button class="btn btn-action btn-revision"
                                                    title="Mandar a Revisión"
                                                    @onclick="() => MandarARevision(item)">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        }

                                        <!-- Botón Eliminar -->
                                        <button class="btn btn-action btn-delete"
                                                title="Eliminar Expediente"
                                                @onclick="() => ConfirmarEliminar(item.Id, item.Solicitante)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginador Footer -->
            <div class="card-footer bg-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center border-0">
                <small class="text-muted">
                    Mostrando <strong>@solicitudes.Count</strong> de <strong>@totalRegistros</strong> solicitudes registradas
                </small>

                <nav aria-label="Navegación de solicitudes">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">
                                <i class="bi bi-chevron-left me-1"></i> Anterior
                            </button>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link px-3 fw-bold text-dark">@paginaActual</span>
                        </li>
                        <li class="page-item @(paginaActual * tamanoPagina >= totalRegistros ? "disabled" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">
                                Siguiente <i class="bi bi-chevron-right ms-1"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- Modal Detalle y Gestión de Estado -->
@if (mostrarModal && solicitudSeleccionada != null)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Modal Header -->
                <div class="modal-header modal-header-dgm text-white rounded-top-4 py-3 px-4" style="background: #003876; color: #ffffff !important;">
                    <h5 class="modal-title fw-bold" style="color: #ffffff !important;">
                        <i class="bi bi-file-earmark-text me-2" style="color: #ffffff !important;"></i>
                        Expediente #@solicitudSeleccionada.Id.ToString("D4")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4 bg-light">
                    <!-- Resumen del Solicitante y Trámite -->
                    <div class="bg-white p-3 rounded-3 border mb-3 shadow-xs">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="small text-muted fw-semibold d-block mb-1">SOLICITANTE</label>
                                <span class="fw-bold text-dark">@solicitudSeleccionada.Solicitante</span>
                            </div>
                            <div class="col-sm-6">
                                <label class="small text-muted fw-semibold d-block mb-1">TÍTULO / ASUNTO</label>
                                <span class="fw-semibold text-dark">@solicitudSeleccionada.Titulo</span>
                            </div>
                            <div class="col-sm-6">
                                <label class="small text-muted fw-semibold d-block mb-1">FECHA DE REGISTRO</label>
                                <span class="text-dark">@solicitudSeleccionada.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="col-sm-6">
                                <label class="small text-muted fw-semibold d-block mb-1">ESTADO ACTUAL</label>
                                <span class="badge-status @ObtenerClaseEstado(solicitudSeleccionada.Estado)">
                                    @ObtenerNombreEstado(solicitudSeleccionada.Estado)
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Descripción del expediente -->
                    <div class="bg-white p-3 rounded-3 border mb-3 shadow-xs">
                        <label class="small text-muted fw-semibold d-block mb-1">DESCRIPCIÓN / COMENTARIOS DEL RESIDENTE</label>
                        <p class="text-dark small mb-0 lh-base" style="white-space: pre-line;">
                            @(string.IsNullOrWhiteSpace(solicitudSeleccionada.Descripcion) ? "Sin descripción adicional proporcionada." : solicitudSeleccionada.Descripcion)
                        </p>
                    </div>

                    <!-- Documentos y Requisitos Adjuntos -->
                    <div class="bg-white p-3 rounded-3 border mb-3 shadow-xs">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="small text-muted fw-bold d-block mb-0">DOCUMENTOS Y REQUISITOS ADJUNTOS</label>
                            <span class="badge bg-light text-dark border">@documentosExpediente.Count adjuntos</span>
                        </div>

                        @if (cargandoDocsModal)
                        {
                            <div class="text-center py-3">
                                <span class="spinner-border spinner-border-sm text-primary"></span>
                                <small class="text-muted ms-2">Cargando anexos...</small>
                            </div>
                        }
                        else if (!documentosExpediente.Any())
                        {
                            <p class="text-muted small mb-0 py-2 text-center fst-italic">El solicitante aún no ha subido anexos a este expediente.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var doc in documentosExpediente)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @doc.Icono fs-5"></i>
                                            <div>
                                                <span class="d-block fw-semibold text-dark small">@doc.Nombre</span>
                                                <small class="text-muted" style="font-size: 0.70rem;">Subido el: @doc.FechaSubida.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @ObtenerClaseBadgeDoc(doc.Estado)" style="font-size: 0.72rem;">@doc.Estado</span>

                                            <a href="@doc.UrlDescarga" target="_blank" class="btn btn-sm btn-light border py-0 px-2" title="Abrir / Descargar">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>

                                            <!-- Botones de Auditoría -->
                                            <button class="btn btn-sm btn-outline-success py-0 px-2" title="Aprobar requisito" @onclick='() => CambiarEstadoDocumento(doc, "Aprobado")'>
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Rechazar requisito" @onclick='() => CambiarEstadoDocumento(doc, "Rechazado")'>
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Cambiar Estado Manualmente -->
                    <div class="bg-white p-3 rounded-3 border shadow-xs">
                        <label class="form-label fw-bold small text-primary d-block mb-2">
                            <i class="bi bi-sliders me-1"></i> ACTUALIZAR ESTADO DEL EXPEDIENTE
                        </label>
                        <select class="form-select form-control-dgm" @bind="estadoEdicion">
                            <option value="1">🟡 Pendiente</option>
                            <option value="2">🔵 En Proceso / Revisión</option>
                            <option value="3">🟢 Aprobada</option>
                            <option value="4">🔴 Rechazada</option>
                            <option value="5">⚫ Cancelada</option>
                        </select>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-white py-3 px-4 border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="CerrarModal" disabled="@guardando">
                        Cerrar
                    </button>

                    <div class="d-flex gap-2">
                        @if (solicitudSeleccionada.Estado == 1)
                        {
                            <button type="button" class="btn btn-info text-white px-3" @onclick="() => MandarARevision(solicitudSeleccionada)" disabled="@guardando">
                                <i class="bi bi-arrow-repeat me-1"></i> Mandar a Revisión
                            </button>
                        }

                        <button type="button" class="btn btn-primary px-4 btn-institucional" @onclick="ActualizarEstadoModal" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Guardar Cambios</span>
                            }
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .header-title {
        color: #003876;
        letter-spacing: -0.5px;
    }

    .btn-institucional {
        background-color: #003876;
        border-color: #003876;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }

        .btn-institucional:hover {
            background-color: #00234b;
            border-color: #00234b;
        }

    .filter-card {
        background: #ffffff;
        border: 1px solid #eef2f6 !important;
    }

    /* Tabla */
    .custom-table thead th {
        background-color: #003876;
        color: #ffffff;
        font-size: 0.78rem;
        letter-spacing: 0.8px;
        font-weight: 600;
        padding-top: 14px;
        padding-bottom: 14px;
        border: none;
    }

    .custom-table tbody tr {
        transition: background-color 0.15s ease-in-out;
    }

        .custom-table tbody tr:hover {
            background-color: #f8fafd;
        }

    /* Círculo con Inicial */
    .avatar-circle {
        width: 32px;
        height: 32px;
        background-color: #e9ecef;
        color: #003876;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    /* Badges de Estado */
    .badge-status {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 50rem;
    }

    .status-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-proceso {
        background-color: #cfe2ff;
        color: #084298;
    }

    .status-aprobada {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-rechazada {
        background-color: #f8d7da;
        color: #842029;
    }

    .status-cancelada {
        background-color: #e2e3e5;
        color: #41464b;
    }

    /* Botones de Acción */
    .btn-action {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: all 0.2s;
    }

    .btn-edit {
        color: #003876;
        background-color: #e8f0fe;
    }

        .btn-edit:hover {
            background-color: #003876;
            color: #ffffff;
        }

    .btn-revision {
