@page "/mis-solicitudes"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using GestionSolicitudes.Client.DTOs
@using GestionSolicitudes.Client.Layout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject GestionSolicitudes.Client.Services.ExpedienteStateService StateService
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<PageTitle>@(Idioma.EsEspanol ? "Expediente Digital del Residente | DGM" : "Resident Digital File | DGM")</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3">

    @if (cargando)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">@(Idioma.EsEspanol ? "Cargando expediente..." : "Loading file...")</span>
            </div>
            <p class="text-muted mt-3 fw-semibold">
                @(Idioma.EsEspanol ? "Consultando expedientes oficiales..." : "Retrieving official files...")
            </p>
        </div>
    }
    else if (!listaSolicitudes.Any() && expediente == null)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center my-4">
            <div class="mb-3">
                <i class="bi bi-folder-x text-muted" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">
                @(Idioma.EsEspanol ? "No posee expedientes radicados" : "You do not have any submitted files")
            </h4>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 500px;">
                @(Idioma.EsEspanol
                            ? "Actualmente no cuenta con trámites de residencia en curso. Puede iniciar la radicación oficial de su expediente en línea."
                            : "You currently have no ongoing residence applications. You can start the official submission of your file online.")
        </p>
        @if (!string.IsNullOrWhiteSpace(errorCarga))
            {
                <div class="alert alert-danger small rounded-3 mx-auto" style="max-width: 500px;">@errorCarga</div>
            }
            <div>
                <a href="/nueva-solicitud" class="btn text-white rounded-pill px-4 py-2 fw-semibold" style="background-color: #003876;">
                    <i class="bi bi-plus-circle me-1"></i> @(Idioma.EsEspanol ? "Iniciar Solicitud" : "Start Application")
                </a>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(mensajeOk))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@mensajeOk
                <button type="button" class="btn-close" @onclick='() => mensajeOk = ""'></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick='() => mensajeError = ""'></button>
            </div>
        }

        @if (listaSolicitudes.Count > 1)
        {
            <div class="d-flex align-items-center gap-2 mb-3 overflow-auto pb-2">
                <span class="text-muted small fw-semibold text-nowrap">
                    <i class="bi bi-collection me-1"></i>@(Idioma.EsEspanol ? "Mis trámites:" : "My applications:")
                </span>
                @foreach (var item in listaSolicitudes)
                {
                    <button class="btn btn-sm rounded-pill px-3 py-1 text-nowrap @(solicitudSeleccionadaId == item.Id ? "btn-primary text-white" : "btn-light border")"
                            style="@(solicitudSeleccionadaId == item.Id ? "background-color: #003876; border-color: #003876;" : "")"
                            @onclick="() => CambiarSolicitud(item.Id)">
                        @item.Codigo - @item.Categoria
                    </button>
                }
            </div>
        }

        <!-- 1. ENCABEZADO Y PERFIL DEL EXPEDIENTE -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-2 bg-white p-4 rounded-4 shadow-sm">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-3 py-2 rounded-pill fs-6" style="background-color: #003876 !important;">
                        #@CodigoMostrado
                    </span>
                    <span class="badge @ObtenerClaseBadgeGeneral(EstadoActual) px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i>@(ObtenerTextoEstado(EstadoActual))
                    </span>
                </div>
                <h3 class="fw-bold text-dark mt-2 mb-1">@TituloExpediente</h3>
                <p class="text-muted small mb-0">
                    @(Idioma.EsEspanol ? "Titular:" : "Holder:") <strong>@(string.IsNullOrWhiteSpace(expediente?.NombreTitular) ? nombreUsuarioSesion : expediente.NombreTitular)</strong>
                    | @(Idioma.EsEspanol ? "Pasaporte:" : "Passport:") <strong>@(string.IsNullOrWhiteSpace(expediente?.NumeroPasaporte) ? (Idioma.EsEspanol ? "En trámite" : "In process") : expediente.NumeroPasaporte)</strong>
                    | @(Idioma.EsEspanol ? "Nacionalidad:" : "Nationality:") <strong>@(string.IsNullOrWhiteSpace(expediente?.PaisOrigen) ? (Idioma.EsEspanol ? "Registrada" : "Registered") : expediente.PaisOrigen)</strong>
                </p>
            </div>

            @if (EstadoActual == 3)
            {
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 px-3 py-2 rounded-3" @onclick="DescargarConstancia">
                        <i class="bi bi-file-earmark-pdf-fill text-danger fs-6"></i>
                        <span class="fw-semibold">@(Idioma.EsEspanol ? "Descargar Constancia" : "Download Certificate")</span>
                    </button>
                </div>
            }
    </div>

    <!-- 2. LÍNEA DE TIEMPO DEL TRÁMITE -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold mb-4" style="color: #003876;">
            <i class="bi bi-diagram-3-fill me-2"></i>@(Idioma.EsEspanol ? "Estado del Trámite Migratorio" : "Immigration Process Status")
        </h5>

        <div class="row text-center g-3">
            <div class="col-12 col-md-3">
                <div class="p-3 rounded-4 border step-card @(PasoActual >= 1 ? (PasoActual == 1 ? "step-active" : "step-completed") : "step-pending")">
                    <div class="step-icon mb-2"><i class="bi bi-file-earmark-check fs-3"></i></div>
                    <h6 class="fw-bold mb-1">@(Idioma.EsEspanol ? "1. Radicación" : "1. Submission")</h6>
                    <small class="text-muted d-block">@(Idioma.EsEspanol ? "Documentos depositados" : "Documents filed")</small>
                    <span class="badge @(PasoActual > 1 ? "bg-success" : "bg-warning text-dark") mt-2">
                        @(PasoActual > 1 ? (Idioma.EsEspanol ? "Completado" : "Completed") : (Idioma.EsEspanol ? "En Proceso" : "In Process"))
                    </span>
                </div>
            </div>

            <div class="col-12 col-md-3">
                <div class="p-3 rounded-4 border step-card @(PasoActual >= 2 ? (PasoActual == 2 ? "step-active" : "step-completed") : "step-pending")">
                    <div class="step-icon mb-2"><i class="bi bi-search fs-3"></i></div>
                    <h6 class="fw-bold mb-1">@(Idioma.EsEspanol ? "2. Evaluación Legal" : "2. Legal Review")</h6>
                    <small class="text-muted d-block">@(Idioma.EsEspanol ? "Verificación de antecedentes" : "Background verification")</small>
                    <span class="badge @(PasoActual >= 2 ? (PasoActual > 2 ? "bg-success" : "bg-warning text-dark") : "bg-secondary-subtle text-muted") mt-2">
                        @(PasoActual >= 2
                                                ? (PasoActual > 2 ? (Idioma.EsEspanol ? "Aprobado" : "Approved") : (EstadoActual == 6 ? (Idioma.EsEspanol ? "Subsanación" : "Correction") : (Idioma.EsEspanol ? "En Revisión" : "Under Review")))
                                                : (Idioma.EsEspanol ? "Pendiente" : "Pending"))
                    </span>
                </div>
            </div>

                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 3 ? (PasoActual == 3 ? "step-active" : "step-completed") : "step-pending")">
                        <div class="step-icon mb-2"><i class="bi bi-check-circle fs-3"></i></div>
                        <h6 class="fw-bold mb-1">@(Idioma.EsEspanol ? "3. Resolución" : "3. Resolution")</h6>
                        <small class="text-muted d-block">@(Idioma.EsEspanol ? "Aprobación de residencia" : "Residence approval")</small>
                        <span class="badge @(PasoActual >= 3 ? "bg-success" : "bg-secondary-subtle text-muted") mt-2">
                            @(PasoActual >= 3 ? (Idioma.EsEspanol ? "Aprobada" : "Approved") : (Idioma.EsEspanol ? "Pendiente" : "Pending"))
                        </span>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 4 ? "step-completed" : "step-pending")">
                        <div class="step-icon mb-2"><i class="bi bi-person-badge fs-3"></i></div>
                        <h6 class="fw-bold mb-1">@(Idioma.EsEspanol ? "4. Emisión de Carnet" : "4. Card Issuance")</h6>
                        <small class="text-muted d-block">@(Idioma.EsEspanol ? "Listo para entrega física" : "Ready for physical pickup")</small>
                        <span class="badge @(PasoActual >= 4 ? "bg-success" : "bg-secondary-subtle text-muted") mt-2">
                            @(PasoActual >= 4 ? (Idioma.EsEspanol ? "Listo" : "Ready") : (Idioma.EsEspanol ? "Pendiente" : "Pending"))
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. NOTIFICACIONES DEL TRÁMITE -->
    @if (EstadoActual == 3)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm p-4 mb-4 d-flex align-items-start gap-3">
                <i class="bi bi-patch-check-fill fs-2 text-success flex-shrink-0 mt-1"></i>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">
                        @(Idioma.EsEspanol ? "Expediente Aprobado Oficialmente" : "File Officially Approved")
                    </h5>
                    <p class="small text-muted mb-0">
                        @(Idioma.EsEspanol
                                        ? "Su resolución de residencia ha sido validada satisfactoriamente. Puede presentarse a la sede para la toma biométrica y emisión de carnet."
                                        : "Your residence resolution has been successfully validated. You may visit the branch for biometric capture and ID issuance.")
            </p>
        </div>
    </div>
        }
        else if (EstadoActual == 4)
        {
            <div class="alert alert-danger border-0 rounded-4 shadow-sm p-4 mb-4 d-flex align-items-start gap-3">
                <i class="bi bi-x-octagon-fill fs-2 text-danger flex-shrink-0 mt-1"></i>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">
                        @(Idioma.EsEspanol ? "Expediente Rechazado" : "File Rejected")
                    </h5>
                    <p class="small text-muted mb-0">
                        @(Idioma.EsEspanol
                                        ? "El expediente no cumple con los requisitos reglamentarios de la Ley General de Migración."
                                        : "The file does not meet the regulatory requirements of the General Migration Law.")
            </p>
        </div>
    </div>
        }
        else if (EstadoActual == 6 || DocsRechazados.Any())
        {
            <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 mb-4 d-flex align-items-start gap-3">
                <i class="bi bi-exclamation-octagon-fill fs-2 text-warning flex-shrink-0 mt-1"></i>
                <div class="flex-grow-1">
                    <h5 class="fw-bold mb-1 text-dark">
                        @(Idioma.EsEspanol ? "Acción Requerida: Subsanación de Documentación" : "Action Required: Document Correction")
                    </h5>
                    <p class="small text-dark mb-2">
                        @(Idioma.EsEspanol
                                        ? "El departamento de auditoría legal de la DGM revisó su expediente y rechazó los siguientes documentos. Reemplácelos para continuar con el trámite:"
                                        : "The DGM legal audit department reviewed your file and rejected the following documents. Replace them to continue your application:")
            </p>
            @if (DocsRechazados.Any())
                    {
                        <ul class="small text-dark mb-0 ps-3">
                            @foreach (var d in DocsRechazados)
                            {
                                <li>
                                    <strong>@d.Nombre</strong>
                                    @if (!string.IsNullOrWhiteSpace(d.Comentario))
                                    {
                                        <span> — @d.Comentario</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }

        <!-- 4. DOCUMENTOS Y VIGENCIA -->
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0" style="color: #003876;">
                                <i class="bi bi-folder-symlink-fill me-2"></i>@(Idioma.EsEspanol ? "Documentos Depositados" : "Deposited Documents")
                            </h5>
                            <small class="text-muted">
                                @(Idioma.EsEspanol ? "Expediente digital verificado por la DGM" : "Digital file verified by the DGM")
                            </small>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorDocs))
                    {
                        <div class="alert alert-danger small rounded-3 d-flex align-items-center justify-content-between gap-2">
                            <span>@errorDocs</span>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="CargarDocumentos">
                                @(Idioma.EsEspanol ? "Reintentar" : "Retry")
                            </button>
                        </div>
                    }

                    <div class="list-group list-group-flush mt-2">
                        @if (DocumentosActuales.Any())
                        {
                            @foreach (var doc in DocumentosActuales)
                            {
                                var rechazado = DocNormal(doc.Estado) == "Rechazado";
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="p-2 rounded-3 bg-light text-primary border">
                                                <i class="bi @doc.Icono fs-4"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">@doc.Nombre</div>
                                                <small class="text-muted">
                                                    @(Idioma.EsEspanol ? "Actualizado el:" : "Updated on:") @doc.FechaSubida.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @ObtenerClaseDoc(doc.Estado)">@TextoDoc(doc.Estado)</span>
                                            @if (!string.IsNullOrEmpty(doc.UrlDescarga))
                                            {
                                                <a href="@ResolverUrl(doc.UrlDescarga)" target="_blank" rel="noopener" class="btn btn-sm btn-light border rounded-circle" title="@(Idioma.EsEspanol ? "Ver documento" : "View document")">
                                                    <i class="bi bi-eye text-muted"></i>
                                                </a>
                                            }
                                            @if (rechazado && PuedeReemplazar)
                                            {
                                                @if (reemplazandoNombre == doc.Nombre)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-danger"></span>
                                                }
                                                else
                                                {
                                                    <label class="btn btn-sm btn-outline-danger rounded-pill px-3 mb-0" style="cursor: pointer;">
                                                        <i class="bi bi-arrow-repeat me-1"></i>@(Idioma.EsEspanol ? "Reemplazar" : "Replace")
                                                        <InputFile OnChange="@(e => ReemplazarDocumento(e, doc))" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </label>
                                                }
                                            }
                                        </div>
                                    </div>
                                    @if (rechazado && !string.IsNullOrWhiteSpace(doc.Comentario))
                                    {
                                        <div class="small text-danger mt-2 ms-5 ps-2">
                                            <i class="bi bi-chat-left-text me-1"></i>@doc.Comentario
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (string.IsNullOrWhiteSpace(errorDocs))
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-file-earmark-arrow-up fs-3 d-block mb-1"></i>
                                @(Idioma.EsEspanol
                                                        ? "No hay documentos registrados en este expediente."
                                                        : "No documents registered in this file.")
                    </div>
                                        }
                    </div>
                </div>
            </div>

            <!-- DETALLE DE VIGENCIA Y AUDITORÍA ASIGNADA -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <h5 class="fw-bold mb-3" style="color: #003876;">
                        <i class="bi bi-info-circle-fill me-2"></i>@(Idioma.EsEspanol ? "Detalle de Vigencia" : "Validity Details")
                    </h5>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted d-block fw-semibold">@(Idioma.EsEspanol ? "FECHA DE REGISTRO" : "REGISTRATION DATE")</small>
                        <span class="fw-bold text-dark">@((expediente?.FechaEmision ?? DateTime.UtcNow).ToString("dd MMMM, yyyy"))</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted d-block fw-semibold">@(Idioma.EsEspanol ? "PRÓXIMA RENOVACIÓN ESTIMADA" : "ESTIMATED NEXT RENEWAL")</small>
                        <span class="fw-bold text-dark">@((expediente?.FechaVencimiento ?? DateTime.UtcNow.AddYears(1)).ToString("dd MMMM, yyyy"))</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted d-block fw-semibold">@(Idioma.EsEspanol ? "SEDE DE ATENCIÓN ASIGNADA" : "ASSIGNED SERVICE BRANCH")</small>
                        <span class="fw-bold text-dark">@(Idioma.EsEspanol ? "Sede Central DGM" : "DGM Headquarters")</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-2">
                        <small class="text-muted d-block fw-semibold">@(Idioma.EsEspanol ? "REVISIÓN LEGAL" : "LEGAL REVIEW")</small>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div style="width: 28px; height: 28px; border-radius: 50%; background-color: #003876; color: #fff; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <span class="fw-bold text-dark text-truncate" style="font-size: 0.85rem;">@ObtenerNombreAuditor()</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .step-card {
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .step-completed {
        background-color: #F0FDF4;
        border-color: #BBF7D0 !important;
        color: #15803D;
    }

    .step-active {
        background-color: #FEFCE8;
        border-color: #FEF08A !important;
        color: #A16207;
        box-shadow: 0 4px 12px rgba(234, 179, 8, 0.15);
    }

    .step-pending {
        background-color: #F8FAFC;
        border-color: #E2E8F0 !important;
        color: #94A3B8;
    }
</style>

@code {
    private ExpedienteResidenteResponseDto? expediente;
    private List<MiSolicitudResumenItem> listaSolicitudes = new();
    private List<DocResidenteItem> documentos = new();
    private int solicitudSeleccionadaId = 0;
    private int? estadoLocal;
    private bool cargando = true;
    private string nombreUsuarioSesion = "Residente";
    private string mensajeOk = string.Empty;
    private string mensajeError = string.Empty;
    private string errorCarga = string.Empty;
    private string errorDocs = string.Empty;
    private string reemplazandoNombre = string.Empty;

    // ---------- Estado calculado ----------
    private MiSolicitudResumenItem? ItemSeleccionado => listaSolicitudes.FirstOrDefault(s => s.Id == solicitudSeleccionadaId);
    private int IdActual => solicitudSeleccionadaId > 0 ? solicitudSeleccionadaId : (expediente?.Id ?? 0);
    private int EstadoActual => estadoLocal ?? ItemSeleccionado?.Estado ?? expediente?.Estado ?? 1;
    private bool PuedeReemplazar => EstadoActual is not (3 or 4 or 5);

    private string CodigoMostrado => ItemSeleccionado?.Codigo ?? expediente?.NumeroRadicado ?? StateService.Radicado;

    private string TituloExpediente
    {
        get
        {
            if (expediente != null && expediente.Id == IdActual && !string.IsNullOrWhiteSpace(expediente.TipoResidencia))
                return expediente.TipoResidencia;
            if (ItemSeleccionado != null && !string.IsNullOrWhiteSpace(ItemSeleccionado.Categoria))
                return $"Residencia ({ItemSeleccionado.Categoria})";
            if (!string.IsNullOrWhiteSpace(StateService.Categoria))
                return $"Residencia ({StateService.Categoria})";
            return Idioma.EsEspanol ? "Residencia Temporal" : "Temporary Residence";
        }
    }

    private int PasoActual => EstadoActual switch
    {
        1 => 1,
        2 => 2,
        6 => 2,
        3 => 4,
        4 => 2,
        _ => 1
    };

    // Si el residente reemplazó un documento, solo se muestra la versión más reciente de cada tipo
    private List<DocResidenteItem> DocumentosActuales => documentos
        .GroupBy(d => d.Nombre)
        .Select(g => g.OrderByDescending(x => x.FechaSubida).ThenByDescending(x => x.Id).First())
        .OrderBy(d => d.Id)
        .ToList();

    private List<DocResidenteItem> DocsRechazados => DocumentosActuales
        .Where(d => DocNormal(d.Estado) == "Rechazado")
        .ToList();

    // ---------- Ciclo de vida ----------
    protected override async Task OnInitializedAsync()
    {
        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;
        await CargarDatos();
    }

    private void RefrescarPorIdioma()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ConfigurarHeaderAuth()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
        }
        catch { }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        errorCarga = string.Empty;
        estadoLocal = null;

        try
        {
            await ConfigurarHeaderAuth();

            try
            {
                var nombre = await JS.InvokeAsync<string>("localStorage.getItem", "nombreUsuario");
                if (!string.IsNullOrWhiteSpace(nombre)) nombreUsuarioSesion = nombre;
            }
            catch { }

            await CargarListaMias();
            await CargarDetalleExpediente();
            await CargarDocumentos();
        }
        catch (Exception ex)
        {
            expediente = null;
            errorCarga = $"No se pudo cargar su información: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    // Lectura tolerante: acepta números o textos para estado/categoría
    private async Task CargarListaMias()
    {
        listaSolicitudes = new();
        try
        {
            var json = await Http.GetStringAsync("api/solicitud/mias");
            using var doc = JsonDocument.Parse(json);

            if (doc.RootElement.ValueKind != JsonValueKind.Array) return;

            foreach (var e in doc.RootElement.EnumerateArray())
            {
                int.TryParse(Txt(e, "id"), out var id);
                int.TryParse(Txt(e, "estado"), out var estadoNumero);
                var estadoTexto = Txt(e, "estado");

                listaSolicitudes.Add(new MiSolicitudResumenItem
                {
                    Id = id,
                    Codigo = Txt(e, "codigo"),
                    Tipo = Txt(e, "tipo"),
                    Categoria = NombreCategoria(Txt(e, "categoria")),
                    Estado = estadoNumero > 0 ? estadoNumero : EstadoDesdeTexto(estadoTexto),
                    EstadoTexto = Txt(e, "estadoTexto")
                });
            }

            if (listaSolicitudes.Any())
            {
                solicitudSeleccionadaId = listaSolicitudes.First().Id;
            }
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudo cargar la lista de sus trámites: {ex.Message}";
        }
    }

    private async Task CambiarSolicitud(int id)
    {
        solicitudSeleccionadaId = id;
        estadoLocal = null;
        mensajeOk = string.Empty;
        mensajeError = string.Empty;
        cargando = true;
        await CargarDocumentos();
        cargando = false;
    }

    private async Task CargarDetalleExpediente()
    {
        try
        {
            var correo = await JS.InvokeAsync<string>("localStorage.getItem", "correoUsuario");
            string url = "api/solicitud/mi-expediente";
            if (!string.IsNullOrWhiteSpace(correo))
            {
                url += $"?email={Uri.EscapeDataString(correo)}";
            }

            expediente = await Http.GetFromJsonAsync<ExpedienteResidenteResponseDto>(url);
        }
        catch
        {
            // Sin expediente por correo: se usa la lista de "mis trámites" si existe
            expediente = null;
        }
    }

    private async Task CargarDocumentos()
    {
        errorDocs = string.Empty;

        if (IdActual <= 0)
        {
            documentos = new();
            return;
        }

        try
        {
            documentos = await Http.GetFromJsonAsync<List<DocResidenteItem>>($"api/solicitud/{IdActual}/documentos") ?? new();
        }
        catch (Exception ex)
        {
            documentos = new();
            errorDocs = Idioma.EsEspanol
                ? $"No se pudieron cargar los documentos ({ex.Message})."
                : $"Documents could not be loaded ({ex.Message}).";
        }
    }

    // ---------- Reemplazo de documentos rechazados ----------
    private async Task ReemplazarDocumento(InputFileChangeEventArgs e, DocResidenteItem doc)
    {
        mensajeOk = string.Empty;
        mensajeError = string.Empty;

        var archivo = e.File;
        if (archivo == null) return;

        var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
        {
            mensajeError = Idioma.EsEspanol ? "Formato no permitido. Use PDF, JPG o PNG." : "Format not allowed. Use PDF, JPG or PNG.";
            return;
        }

        if (archivo.Size > 5 * 1024 * 1024)
        {
            mensajeError = Idioma.EsEspanol ? "El archivo supera el máximo de 5 MB." : "The file exceeds the 5 MB limit.";
            return;
        }

        reemplazandoNombre = doc.Nombre;

        try
        {
            using var stream = archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(IdActual.ToString()), "solicitudId");
            content.Add(new StringContent(doc.Nombre), "tipoDocumento");

            var fileContent = new ByteArrayContent(ms.ToArray());
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(ObtenerMime(ext));
            content.Add(fileContent, "archivo", archivo.Name);

            var res = await Http.PostAsync("api/solicitud/subir-documento", content);
            if (!res.IsSuccessStatusCode)
            {
                mensajeError = Idioma.EsEspanol
                    ? $"No se pudo subir el documento (código {(int)res.StatusCode}). Intente nuevamente."
                    : $"The document could not be uploaded (code {(int)res.StatusCode}). Please try again.";
                return;
            }

            await CargarDocumentos();

            // Si ya no quedan documentos rechazados, el expediente vuelve a revisión
            if (EstadoActual == 6 && !DocsRechazados.Any())
            {
                var patch = await Http.PatchAsJsonAsync($"api/solicitud/{IdActual}/estado", new { nuevoEstado = 2 });
                if (patch.IsSuccessStatusCode)
                {
                    estadoLocal = 2;
                    var item = ItemSeleccionado;
                    if (item != null) item.Estado = 2;

                    mensajeOk = Idioma.EsEspanol
                        ? "Documento reemplazado. Su expediente volvió a revisión legal."
                        : "Document replaced. Your file is back under legal review.";
                    return;
                }
            }

            mensajeOk = Idioma.EsEspanol
                ? "Documento reemplazado correctamente."
                : "Document replaced successfully.";
        }
        catch (Exception ex)
        {
            mensajeError = Idioma.EsEspanol
                ? $"Error al subir el documento: {ex.Message}"
                : $"Error uploading the document: {ex.Message}";
        }
        finally
        {
            reemplazandoNombre = string.Empty;
        }
    }

    private static string ObtenerMime(string ext) => ext switch
    {
        ".pdf" => "application/pdf",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        _ => "application/octet-stream"
    };

    // ---------- Utilidades ----------
    // La API devuelve rutas relativas (uploads/archivo.pdf): se completan con la dirección de la API
    private string ResolverUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;

        if (Uri.TryCreate(url, UriKind.Absolute, out var abs) &&
            (abs.Scheme == Uri.UriSchemeHttp || abs.Scheme == Uri.UriSchemeHttps))
        {
            return url;
        }

        if (Http.BaseAddress != null)
        {
            return new Uri(Http.BaseAddress, url.TrimStart('/')).ToString();
        }

        return url;
    }

    private static string Txt(JsonElement e, string nombre)
    {
        foreach (var p in e.EnumerateObject())
        {
            if (p.Name.Equals(nombre, StringComparison.OrdinalIgnoreCase))
            {
                return p.Value.ValueKind switch
                {
                    JsonValueKind.String => p.Value.GetString() ?? string.Empty,
                    JsonValueKind.Number => p.Value.GetRawText(),
                    JsonValueKind.Null => string.Empty,
                    _ => p.Value.ToString()
                };
            }
        }
        return string.Empty;
    }

    private static string NombreCategoria(string valor) => valor switch
    {
        "1" => "Trabajo",
        "2" => "Estudiante",
        "3" => "Familiar",
        "4" => "Inversionista",
        _ => valor
    };

    private static int EstadoDesdeTexto(string texto) => (texto ?? string.Empty).Replace(" ", "") switch
    {
        "Pendiente" => 1,
        "EnProceso" => 2,
        "Aprobada" or "Aprobado" => 3,
        "Rechazada" or "Rechazado" => 4,
        "Cancelada" or "Cancelado" => 5,
        "RequiereCorreccion" or "RequiereCorrección" => 6,
        _ => 1
    };

    private static string DocNormal(string? estado)
    {
        var x = (estado ?? string.Empty).Replace(" ", "").ToLowerInvariant();
        return x switch
        {
            "aprobado" or "aprobada" => "Aprobado",
            "rechazado" or "rechazada" or "novigente" => "Rechazado",
            _ => "EnRevision"
        };
    }

    private string TextoDoc(string? estado) => DocNormal(estado) switch
    {
        "Aprobado" => Idioma.EsEspanol ? "Aprobado" : "Approved",
        "Rechazado" => Idioma.EsEspanol ? "Rechazado" : "Rejected",
        _ => Idioma.EsEspanol ? "En revisión" : "Under review"
    };

    private static string ObtenerClaseDoc(string? estado) => DocNormal(estado) switch
    {
        "Aprobado" => "bg-success-subtle text-success border border-success-subtle",
        "Rechazado" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning border border-warning-subtle"
    };

    private string ObtenerNombreAuditor()
    {
        if (EstadoActual == 1)
        {
            return Idioma.EsEspanol ? "En espera de revisión" : "Pending Review";
        }

        return Idioma.EsEspanol ? "Auditoría Legal DGM" : "DGM Legal Audit";
    }

    private void DescargarConstancia()
    {
        Navigation.NavigateTo(ResolverUrl($"api/solicitud/{IdActual}/constancia"), forceLoad: true);
    }

    private string ObtenerClaseBadgeGeneral(int estado) => estado switch
    {
        3 => "bg-success-subtle text-success border border-success-subtle",
        4 => "bg-danger-subtle text-danger border border-danger-subtle",
        6 => "bg-warning-subtle text-warning border border-warning-subtle",
        _ => "bg-primary-subtle text-primary border border-primary-subtle"
    };

    private string ObtenerTextoEstado(int estado) => estado switch
    {
        1 => Idioma.EsEspanol ? "Pendiente" : "Pending",
        2 => Idioma.EsEspanol ? "En Proceso" : "In Process",
        3 => Idioma.EsEspanol ? "Aprobada" : "Approved",
        4 => Idioma.EsEspanol ? "Rechazada" : "Rejected",
        5 => Idioma.EsEspanol ? "Cancelada" : "Cancelled",
        6 => Idioma.EsEspanol ? "Requiere Corrección" : "Requires Correction",
        _ => Idioma.EsEspanol ? "En Trámite" : "In Progress"
    };

