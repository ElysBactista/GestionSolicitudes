@page "/mis-solicitudes"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using GestionSolicitudes.Client.DTOs
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Expediente Digital del Residente | DGM</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3">

    @if (cargando)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando expediente...</span>
            </div>
            <p class="text-muted mt-3 fw-semibold">Consultando expediente oficial...</p>
        </div>
    }
    else
    {
        <!-- 1. ENCABEZADO Y PERFIL DEL EXPEDIENTE -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-2">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-3 py-2 rounded-pill fs-6" style="background-color: #003876 !important;">
                        #@(expediente?.NumeroRadicado ?? "EXP-2026-0001")
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i>Expediente Activo
                    </span>
                </div>
                <h3 class="fw-bold text-dark mt-2 mb-1">
                    @(string.IsNullOrWhiteSpace(expediente?.TipoResidencia) ? "Residencia Temporal por Trabajo (RT-3)" : expediente.TipoResidencia)
                </h3>
                <p class="text-muted small mb-0">
                    Titular: <strong>@(string.IsNullOrWhiteSpace(expediente?.NombreTitular) ? nombreUsuarioSesion : expediente.NombreTitular)</strong>
                    | Pasaporte: <strong>@(string.IsNullOrWhiteSpace(expediente?.NumeroPasaporte) ? "P0948214" : expediente.NumeroPasaporte)</strong>
                    | País de Origen: <strong>@(string.IsNullOrWhiteSpace(expediente?.PaisOrigen) ? "República Dominicana" : expediente.PaisOrigen)</strong>
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 px-3 py-2 rounded-3"
                        @onclick="DescargarConstancia">
                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-6"></i>
                    <span class="fw-semibold">Descargar Constancia</span>
                </button>
            </div>
        </div>

        <!-- 2. LÍNEA DE TIEMPO DEL TRÁMITE -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold mb-4" style="color: #003876;">
                <i class="bi bi-diagram-3-fill me-2"></i>Estado del Trámite Migratorio
            </h5>

            <div class="row text-center g-3">
                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 1 ? (PasoActual == 1 ? "step-active" : "step-completed") : "step-pending")">
                        <div class="step-icon mb-2">
                            <i class="bi bi-file-earmark-check fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-1">1. Radicación</h6>
                        <small class="text-muted d-block">Documentos depositados</small>
                        <span class="badge @(PasoActual > 1 ? "bg-success" : "bg-warning text-dark") mt-2">
                            @(PasoActual > 1 ? "Completado" : "En Proceso")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 2 ? (PasoActual == 2 ? "step-active" : "step-completed") : "step-pending")">
                        <div class="step-icon mb-2">
                            <i class="bi bi-search fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-1">2. Evaluación Legal</h6>
                        <small class="text-muted d-block">Verificación de antecedentes</small>
                        <span class="badge @(PasoActual >= 2 ? (PasoActual > 2 ? "bg-success" : "bg-warning text-dark") : "bg-secondary-subtle text-muted") mt-2">
                            @(PasoActual >= 2 ? (PasoActual > 2 ? "Aprobado" : "En Revisión") : "Pendiente")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 3 ? (PasoActual == 3 ? "step-active" : "step-completed") : "step-pending")">
                        <div class="step-icon mb-2">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-1">3. Resolución</h6>
                        <small class="text-muted d-block">Aprobación de residencia</small>
                        <span class="badge @(PasoActual >= 3 ? "bg-success" : "bg-secondary-subtle text-muted") mt-2">
                            @(PasoActual >= 3 ? "Aprobada" : "Pendiente")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="p-3 rounded-4 border step-card @(PasoActual >= 4 ? "step-completed" : "step-pending")">
                        <div class="step-icon mb-2">
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-1">4. Emisión de Carnet</h6>
                        <small class="text-muted d-block">Listo para entrega física</small>
                        <span class="badge @(PasoActual >= 4 ? "bg-success" : "bg-secondary-subtle text-muted") mt-2">
                            @(PasoActual >= 4 ? "Listo" : "Pendiente")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. DOCUMENTOS Y VIGENCIA -->
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0" style="color: #003876;">
                                <i class="bi bi-folder-symlink-fill me-2"></i>Documentos Depositados
                            </h5>
                            <small class="text-muted">Expediente digital verificado por la DGM</small>
                        </div>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="AbrirModalSubirDoc">
                            <i class="bi bi-upload me-1"></i> Subir Anexo
                        </button>
                    </div>

                    <div class="list-group list-group-flush mt-2">
                        @if (ListaDocumentos.Any())
                        {
                            @foreach (var doc in ListaDocumentos)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-2 rounded-3 bg-light text-primary border">
                                            <i class="bi @doc.Icono fs-4"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@doc.Nombre</div>
                                            <small class="text-muted">Actualizado el: @doc.FechaSubida.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @ObtenerClaseDoc(doc.Estado)">@doc.Estado</span>
                                        @if (!string.IsNullOrEmpty(doc.UrlDescarga))
                                        {
                                            <a href="@doc.UrlDescarga" target="_blank" class="btn btn-sm btn-light border rounded-circle" title="Ver documento">
                                                <i class="bi bi-eye text-muted"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-file-earmark-arrow-up fs-3 d-block mb-1"></i>
                                No hay documentos adicionales registrados. Presiona "Subir Anexo" para cargar tus requisitos.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <h5 class="fw-bold mb-3" style="color: #003876;">
                        <i class="bi bi-info-circle-fill me-2"></i>Detalle de Vigencia
                    </h5>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted d-block fw-semibold">FECHA DE REGISTRO</small>
                        <span class="fw-bold text-dark">@((expediente?.FechaEmision ?? DateTime.UtcNow).ToString("dd MMMM, yyyy"))</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <small class="text-muted d-block fw-semibold">PRÓXIMA RENOVACIÓN ESTIMADA</small>
                        <span class="fw-bold text-dark">@((expediente?.FechaVencimiento ?? DateTime.UtcNow.AddYears(1)).ToString("dd MMMM, yyyy"))</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <small class="text-muted d-block fw-semibold">SEDE DE ATENCIÓN ASIGNADA</small>
                        <span class="fw-bold text-dark">Sede Central DGM</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL PARA SUBIR DOCUMENTOS -->
@if (mostrarModalDoc)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header text-white rounded-top-4 py-3 px-4" style="background: #003876;">
                    <h5 class="modal-title fw-bold text-white mb-0">
                        <i class="bi bi-file-earmark-arrow-up me-2"></i>Adjuntar Documento al Expediente
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalDoc = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(mensajeErrorUpload))
                    {
                        <div class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0">
                            @mensajeErrorUpload
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">TIPO DE DOCUMENTO</label>
                        <select class="form-select" @bind="tipoDocSeleccionado">
                            <option value="Récord Policial Actualizado">Récord Policial Actualizado</option>
                            <option value="Certificado Médico">Certificado Médico</option>
                            <option value="Contrato de Trabajo / Carta de Garantía">Contrato de Trabajo / Carta de Garantía</option>
                            <option value="Renovación de Pasaporte">Copia de Pasaporte Renovado</option>
                            <option value="Otro Documento Anexo">Otro Documento Anexo</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">SELECCIONAR ARCHIVO (PDF, JPG, PNG)</label>
                        <InputFile OnChange="SeleccionarArchivo" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <button class="btn btn-outline-secondary px-4" @onclick="() => mostrarModalDoc = false" disabled="@subiendoArchivo">
                            Cancelar
                        </button>
                        <button class="btn btn-primary px-4" style="background-color: #003876;" @onclick="SubirArchivoAlBackend" disabled="@(archivoSeleccionado == null || subiendoArchivo)">
                            @if (subiendoArchivo)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Subiendo...</span>
                            }
                            else
                            {
                                <span>Subir Anexo</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .step-card {
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .step-completed {
        background-color: #F0FDF4;
        border-color: #BBF7D0 !important;
        color: #15803D;
    }

    .step-active {
        background-color: #FEFCE8;
        border-color: #FEF08A !important;
        color: #A16207;
        box-shadow: 0 4px 12px rgba(234, 179, 8, 0.15);
    }

    .step-pending {
        background-color: #F8FAFC;
        border-color: #E2E8F0 !important;
        color: #94A3B8;
    }

    .modal-backdrop-custom {
        background-color: rgba(0, 30, 60, 0.55);
        backdrop-filter: blur(2px);
    }
</style>

@code {
    private ExpedienteResidenteResponseDto? expediente;
    private bool cargando = true;
    private string nombreUsuarioSesion = "Residente";

    private int PasoActual => expediente?.PasoActual > 0 ? expediente.PasoActual : 1;

    private List<DocumentoDto> ListaDocumentos => expediente?.Documentos?.Any() == true
        ? expediente.Documentos
        : documentosPorDefecto;

    private List<DocumentoDto> documentosPorDefecto = new()
    {
        new DocumentoDto { Id = 101, Nombre = "Copia de Pasaporte (Página Biográfica)", Icono = "bi-file-earmark-pdf text-danger", FechaSubida = DateTime.UtcNow.AddDays(-2), Estado = "En Revisión" },
        new DocumentoDto { Id = 102, Nombre = "Certificado de No Antecedentes Penales", Icono = "bi-file-earmark-pdf text-danger", FechaSubida = DateTime.UtcNow.AddDays(-2), Estado = "En Revisión" }
    };

    // Subida de archivos
    private bool mostrarModalDoc = false;
    private string tipoDocSeleccionado = "Récord Policial Actualizado";
    private IBrowserFile? archivoSeleccionado;
    private bool subiendoArchivo = false;
    private string mensajeErrorUpload = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarExpediente();
    }

    private async Task CargarExpediente()
    {
        cargando = true;
        try
        {
            var nombre = await JS.InvokeAsync<string>("sessionStorage.getItem", "nombreUsuario");
            if (!string.IsNullOrWhiteSpace(nombre)) nombreUsuarioSesion = nombre;

            var correo = await JS.InvokeAsync<string>("sessionStorage.getItem", "correoUsuario");
            string url = "api/solicitud/mi-expediente";
            if (!string.IsNullOrWhiteSpace(correo))
            {
                url += $"?email={Uri.EscapeDataString(correo)}";
            }

            expediente = await Http.GetFromJsonAsync<ExpedienteResidenteResponseDto>(url);
        }
        catch
        {
            // Si el backend aún no tiene registro, se utiliza el fallback visual para no romper la pantalla
            expediente = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalSubirDoc()
    {
        mensajeErrorUpload = string.Empty;
        archivoSeleccionado = null;
        mostrarModalDoc = true;
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        mensajeErrorUpload = string.Empty;
    }

    private async Task SubirArchivoAlBackend()
    {
        if (archivoSeleccionado == null) return;

        subiendoArchivo = true;
        mensajeErrorUpload = string.Empty;

        try
        {
            int solId = expediente?.Id ?? 1;

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(solId.ToString()), "solicitudId");
            content.Add(new StringContent(tipoDocSeleccionado), "tipoDocumento");

            var fileContent = new StreamContent(archivoSeleccionado.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(archivoSeleccionado.ContentType);
            content.Add(fileContent, "archivo", archivoSeleccionado.Name);

            var respuesta = await Http.PostAsync("api/solicitud/subir-documento", content);

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModalDoc = false;
                await CargarExpediente();
            }
            else
            {
                var err = await respuesta.Content.ReadAsStringAsync();
                mensajeErrorUpload = !string.IsNullOrWhiteSpace(err) ? err : "Error al subir el archivo.";
            }
        }
        catch (Exception ex)
        {
            mensajeErrorUpload = $"Error: {ex.Message}";
        }
        finally
        {
            subiendoArchivo = false;
        }
    }

    private void DescargarConstancia()
    {
        int solId = expediente?.Id ?? 1;
        Navigation.NavigateTo($"api/solicitud/{solId}/constancia", forceLoad: true);
    }

    private string ObtenerClaseDoc(string estado) => estado switch
    {
        "Aprobado" => "bg-success-subtle text-success border border-success-subtle",
        "Rechazado" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning border border-warning-subtle"
    };
}