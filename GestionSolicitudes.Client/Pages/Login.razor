@page "/login"
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<PageTitle>@(Idioma.EsEspanol ? "Inicio de Sesión - Dirección General de Migración" : "Sign In - General Directorate of Migration")</PageTitle>

<div class="divPrincipalLogin">
