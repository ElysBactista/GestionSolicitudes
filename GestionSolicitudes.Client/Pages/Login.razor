                    <text transform="matrix(1.063 0 0 1 300.1211 730.3217)" fill="#E4262F" font-family="Marion, serif" font-size="102.4415px" letter-spacing="0.94">MIGRACIÓN</text>
                </svg>
            </div>

            <!-- Icono de Usuario -->
            <div class="user__icon mb-2">
                <svg class="user__login--icon" aria-hidden="true" focusable="false" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512">
                    <path fill="#003876" d="M248 8C111 8 0 119 0 256s111 248 248 248 248-111 248-248S385 8 248 8zm0 96c48.6 0 88 39.4 88 88s-39.4 88-88 88-88-39.4-88-88 39.4-88 88-88zm0 344c-58.7 0-111.3-26.6-146.5-68.2 18.8-35.4 55.6-59.8 98.5-59.8 2.4 0 4.8.4 7.1 1.1 13 4.2 26.6 6.9 40.9 6.9 14.3 0 28-2.7 40.9-6.9 2.3-.7 4.7-1.1 7.1-1.1 42.9 0 79.7 24.4 98.5 59.8C359.3 421.4 306.7 448 248 448z"></path>
                </svg>
            </div>

            <div class="user__text">
                <span>@(Idioma.EsEspanol ? "Inicio de sesión" : "User Login")</span>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger py-2 mx-2 my-2 text-center small rounded-3" role="alert">
                    @mensajeError
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="ProcesarLogin">
                <DataAnnotationsValidator />

                <div class="form-floating mb-3">
                    <input type="email"
                           id="email"
                           class="form-control"
                           autocomplete="email"
                           placeholder="name@example.com"
                           @bind-value="loginModel.Email"
                           required />
                    <label for="email">@(Idioma.EsEspanol ? "Correo Electrónico" : "Email")</label>
                </div>

                <div class="position-relative mb-3">
                    <div class="form-floating">
                        <input type="@(mostrarPassword ? "text" : "password")"
                               id="password"
                               class="form-control pe-5"
                               autocomplete="current-password"
                               placeholder="password"
                               @bind-value="loginModel.Password"
                               required />
                        <label for="password">@(Idioma.EsEspanol ? "Contraseña" : "Password")</label>
                    </div>

                    <button type="button"
                            class="btn position-absolute top-50 end-0 translate-middle-y me-2 border-0 text-muted"
                            style="z-index: 5;"
                            @onclick="ToggleMostrarPassword"
                            tabindex="-1"
                            title="@(mostrarPassword ? (Idioma.EsEspanol ? "Ocultar contraseña" : "Hide password") : (Idioma.EsEspanol ? "Ver contraseña" : "Show password"))">
                        <i class="bi @(mostrarPassword ? "bi-eye-slash-fill" : "bi-eye-fill") fs-5"></i>
                    </button>
                </div>

                <!-- Botón Iniciar Sesión -->
                <div class="mb-3">
                    <button type="submit" class="login__button" disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>@(Idioma.EsEspanol ? "Cargando..." : "Loading...")</span>
                        }
                        else
                        {
                            <span>@(Idioma.EsEspanol ? "Iniciar sesión" : "Log in")</span>
                        }
                    </button>
                </div>

                <!-- Enlace de registro -->
                <div class="text-center">
                    <small class="text-muted">@(Idioma.EsEspanol ? "¿No tienes una cuenta?" : "Don't have an account?")</small>
                    <a href="/registro" class="text-primary fw-semibold ms-1 small text-decoration-none">
                        @(Idioma.EsEspanol ? "Regístrate aquí" : "Sign up here")
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .divPrincipalLogin {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: #f1f5f9;
        font-family: 'Poppins', sans-serif;
    }

    .curved-background {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background-color: #003876;
        clip-path: ellipse(110% 90% at 85% 100%);
        pointer-events: none;
        z-index: 1;
    }

    .image__login__logo {
        position: absolute;
        right: 6%;
        bottom: 12%;
        width: 440px;
        opacity: 0.10;
        z-index: 2;
        pointer-events: none;
    }

    .login-content-layer {
        position: relative;
        z-index: 10;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .divLogin {
        background: #ffffff;
        border-radius: 20px;
        padding: 2.2rem 2.2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 12px 35px rgba(0, 24, 51, 0.15);
        text-align: center;
        position: relative;
    }

    .logo-institucional-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .logo-institucional {
        width: 220px;
        height: auto;
    }

    .user__icon {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .user__login--icon {
        width: 52px;
        height: 52px;
    }

    .user__text {
        font-size: 1.35rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.25rem;
    }

    .form-floating > .form-control {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.95rem;
    }

        .form-floating > .form-control:focus {
            background-color: #ffffff;
