@code {
    private LoginDto loginModel = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;
    private bool mostrarPassword = false;

    protected override async Task OnInitializedAsync()
    {
        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;
        await Idioma.InicializarAsync();
        loginModel = new LoginDto();
        mensajeError = string.Empty;
        cargando = false;
        mostrarPassword = false;
    }

    private void RefrescarPorIdioma()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CambiarIdioma(ChangeEventArgs e)
    {
        var nuevo = e.Value?.ToString() ?? "ES";
        await Idioma.CambiarIdiomaAsync(nuevo);
    }

    private void ToggleMostrarPassword()
    {
        mostrarPassword = !mostrarPassword;
    }

    private async Task ProcesarLogin()
    {
        cargando = true;
        mensajeError = string.Empty;

        var credenciales = new LoginDto
        {
            Email = loginModel.Email?.Trim() ?? string.Empty,
            Password = loginModel.Password ?? string.Empty
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", credenciales);

            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<RespuestaAuthDto>();

                if (resultado != null && resultado.Exito)
                {
                    string correoGuardar = !string.IsNullOrWhiteSpace(resultado.Correo) ? resultado.Correo : credenciales.Email;
                    string nombreGuardar = !string.IsNullOrWhiteSpace(resultado.NombreCompleto) ? resultado.NombreCompleto : correoGuardar;
                    string rolServidor = resultado.Rol ?? "Residente";

                    if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                    {
                        await customAuth.MarkUserAsAuthenticated(resultado.Token);
                    }

                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", resultado.Token);
                    await JS.InvokeVoidAsync("localStorage.setItem", "token", resultado.Token);
                    await JS.InvokeVoidAsync("localStorage.setItem", "correoUsuario", correoGuardar);
                    await JS.InvokeVoidAsync("localStorage.setItem", "nombreUsuario", nombreGuardar);
                    await JS.InvokeVoidAsync("localStorage.setItem", "rolUsuario", rolServidor);

                    if (string.Equals(rolServidor, "Administrador", StringComparison.OrdinalIgnoreCase))
                    {
                        Navigation.NavigateTo("/dashboard", true);
                    }
                    else
                    {
                        Navigation.NavigateTo("/mis-solicitudes", true);
                    }
                }
                else
                {
                    mensajeError = resultado?.Mensaje ?? (Idioma.EsEspanol ? "Credenciales inválidas." : "Invalid credentials.");
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                mensajeError = Idioma.EsEspanol
                    ? "Correo o contraseña incorrectos."
                    : "Incorrect email or password.";
            }
            else
            {
                mensajeError = (Idioma.EsEspanol ? "Error del servidor: " : "Server error: ") + (int)response.StatusCode;
            }
        }
        catch (Exception ex)
        {
            mensajeError = (Idioma.EsEspanol ? "Error de conexión: " : "Connection error: ") + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    public void Dispose()
    {
        Idioma.OnIdiomaCambiado -= RefrescarPorIdioma;
    }

    public class LoginDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaAuthDto
    {
        public bool Exito { get; set; }
        public string Token { get; set; } = string.Empty;
        public string Mensaje { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public string NombreCompleto { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
    }
}