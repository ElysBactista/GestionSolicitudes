@page "/"
@page "/portal-residente"
@layout EmptyLayout
@using GestionSolicitudes.Client.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<PageTitle>@(Idioma.EsEspanol ? "Portal de Servicios Migratorios | DGM" : "Immigration Services Portal | DGM")</PageTitle>

<div class="portal-externo-container d-flex flex-column min-vh-100">

    <!-- Barra principal (72 px): branding + idioma + usuario -->
    <header class="portal-header d-flex justify-content-between align-items-center px-4 px-md-5">
        <div class="d-flex align-items-center gap-3">
            <img src="logoinstitucional.png" alt="Logo Institucional" style="height: 52px; object-fit: contain;" />
        </div>

        <div class="d-flex align-items-center gap-2 gap-md-3">
            <select class="selector-idioma form-select form-select-sm"
                    value="@Idioma.IdiomaActual"
                    @onchange="CambiarIdiomaSeleccionado">
                <option value="ES">Español</option>
                <option value="EN">English</option>
            </select>

            <PanelUsuarioHeader />
        </div>
    </header>

    @if (cargando)
    {
        <div class="text-center my-5 py-5 flex-grow-1">
            <div class="spinner-border" style="width: 3rem; height: 3rem; color: #003876;" role="status"></div>
            <p class="texto-sec mt-3 fw-semibold">
                @(Idioma.EsEspanol ? "Verificando sesión activa..." : "Verifying active session...")
            </p>
        </div>
    }
    else
    {
        <div class="flex-grow-1">

            <!-- 1. HERO (banner con imagen de nubes y texto en blanco) -->
            <section class="hero-dgm hero-parallax-cielo text-white shadow-sm">
                <div class="hero-parallax-overlay container-fluid px-4 px-md-5">
                    <div class="row align-items-center g-4 py-5">
                        <div class="col-12 col-lg-8">
                            <h1 class="titulo-dgm hero-titulo mb-3 text-white">
                                @(Idioma.EsEspanol ? "Bienvenido al Portal de Residencia de la República Dominicana" : "Welcome to the Dominican Republic Residence Portal")
                            </h1>
                            <p class="hero-texto mb-0 text-white-50">
                                @(Idioma.EsEspanol ? "Centralizamos tus trámites migratorios de forma segura, rápida y sin intermediarios." : "Centralizing your immigration procedures securely, quickly, and without intermediaries.")
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <main class="container-fluid px-4 px-md-5 py-4">

                <!-- 2. BANNER DGM: BOTONES DE ACCIÓN A LA IZQUIERDA / INFORMACIÓN A LA DERECHA -->
                <div class="seccion-dgm mb-4 overflow-hidden">
                    <div class="row g-0">

                        <!-- IZQUIERDA: Iniciar sesión o Registrarse (fondo azul oficial) -->
                        <div class="col-12 col-lg-4 banner-accion d-flex flex-column justify-content-center p-4 p-lg-5">
                            <div class="banner-accion-icono mb-3">
                                <i class="bi bi-file-earmark-plus"></i>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(correoActivo))
                            {
                                <h4 class="fw-bold text-white mb-2 fuente-titulo">
                                    @(Idioma.EsEspanol ? "Continúa con tu solicitud" : "Continue with your application")
                                </h4>
                                <p class="texto-claro small mb-4">
                                    @(Idioma.EsEspanol
                                                                ? "Ya tienes una sesión activa. Entra a tu plataforma para crear o dar seguimiento a tus solicitudes."
                                                                : "You already have an active session. Go to your platform to create or track your applications.")
                        </p>
                        <button class="btn-dgm btn-dgm-claro w-100" @onclick="IrAPlataforma">
                            @(Idioma.EsEspanol ? "Ir a mi plataforma" : "Go to my platform")
                        </button>
                                                }
                            else
                            {
                                <h4 class="fw-bold text-white mb-2 fuente-titulo">
                                    @(Idioma.EsEspanol ? "Crea tu solicitud de residencia hoy" : "Create your residence application today")
                                </h4>
                                <p class="texto-claro small mb-4">
                                    @(Idioma.EsEspanol
                                                                ? "Inicia sesión o regístrate para comenzar tu trámite 100% en línea, sin filas y sin intermediarios."
                                                                : "Sign in or register to start your 100% online process, with no lines and no intermediaries.")
                        </p>
                        <div class="d-grid gap-2">
                            <button class="btn-dgm btn-dgm-claro" @onclick='() => Navigation.NavigateTo("/login")'>
                                <i class="bi bi-box-arrow-in-right me-2"></i>@(Idioma.EsEspanol ? "Iniciar Sesión" : "Sign In")
                            </button>
                            <button class="btn-dgm btn-dgm-claro-borde" @onclick="IrAlRegistro">
                                <i class="bi bi-person-plus me-2"></i>@(Idioma.EsEspanol ? "Registrarse" : "Register")
                            </button>
                        </div>
                                                }
                    </div>

                    <!-- DERECHA: Información institucional -->
                    <div class="col-12 col-lg-8 p-4 p-lg-5">
                        <div class="d-flex align-items-center gap-3 mb-3 pb-3 linea-inferior">
                            <div class="cupula-icon-box">
                                <svg viewBox="10 20 215 195" width="46" height="46" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <g fill="#003876">
                                        <path d="M119.6 40.8v-2h4.2v-2.7H122v1.7h-2.5v-4.4h.4v-2.6h-1.8v2.6h.4v4.5H116v-1.7h-1.7v2.7h4.2v2c-7.9.3-14 6.9-13.9 14.7h28.6c.3-7.9-5.8-14.4-13.6-14.8z"></path>
                                        <path d="M101 60.5h36.1c.3 0 .6-.3.6-.6v-2.2c0-.3-.2-.6-.6-.6H101c-.3 0-.6.3-.6.6v2.2c0 .4.3.6.6.6z"></path>
                                        <path d="M101 87.8h36.1c.3 0 .6-.3.6-.6V85c0-.3-.2-.6-.6-.6H101c-.3 0-.6.3-.6.6v2.2c0 .4.3.6.6.6z"></path>
                                        <path d="M107.5 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1-1V63.2c0-.6-.5-1-1-1.1h-4.3z"></path>
                                        <path d="M116.8 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1.1-1V63.2c0-.6-.5-1-1-1.1h-4.4z"></path>
                                        <path d="M126 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1.1-1V63.2c0-.6-.5-1-1-1.1H126z"></path>
                                        <path d="M44.5 156.5c3.2-14.9 9.5-29 18.5-41.4 7.3-9.8 16.3-18.1 26.6-24.6C73.3 96.6 59 106.9 48 120.4c-13.4 17-20.9 37.9-21.2 59.5h13.9c.6-7.9 1.9-15.7 3.8-23.4z"></path>
                                        <path d="M175.3 115.1c9 12.4 15.3 26.5 18.5 41.4 1.9 7.7 3.2 15.5 3.7 23.4h13.9c-.3-21.6-7.8-42.6-21.2-59.5-10.9-13.5-25.3-23.8-41.6-29.9 10.4 6.5 19.4 14.9 26.7 24.6z"></path>
                                        <path d="M102.4 93.9c-7.9 3.9-15.3 8.9-21.7 14.9-27 25.2-30.2 59.9-30.7 71.1h24c-.7-20.7 3.5-41.3 12.2-60.1 4.3-9.2 9.8-17.9 16.2-25.9z"></path>
                                        <path d="M187.8 179.9c-.5-11.2-3.7-45.9-30.7-71.1-6.5-6-13.8-11-21.7-14.9 6.4 8 11.8 16.7 16.1 26 8.7 18.8 12.9 39.4 12.2 60.1l24.1-.1z"></path>
                                        <path d="M114.6 179.9v-86c-8.7 9.4-15.8 20.1-21 31.7-7.6 17-11.1 35.6-10.2 54.3h31.2z"></path>
                                        <path d="M123.6 93.9v86h31.2c.9-18.6-2.6-37.2-10.2-54.3-5.2-11.6-12.3-22.3-21-31.7z"></path>
                                        <path d="M197.7 186.8v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-23.2v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-30.4v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-30v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9H50.4v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9H20.9v3.5h196v-3.5h-19.2z"></path>
                                    </g>
                                </svg>
                            </div>
                            <div class="d-flex flex-column justify-content-center">
                                <h4 class="titulo-dgm mb-0" style="font-size: 1.35rem;">
                                    @(Idioma.EsEspanol ? "Dirección General de Migración | Canal Oficial" : "General Directorate of Migration | Official Channel")
                                </h4>
                                <small class="texto-sec">
                                    @(Idioma.EsEspanol ? "Plataforma digital para la regularización de estancias y residencias" : "Digital platform for residence regularization")
                                </small>
                            </div>
                        </div>

                        <p class="texto-parrafo mb-4" style="line-height: 1.7;">
                            @(Idioma.EsEspanol
                                                        ? "Este portal ciudadano centraliza todos los trámites de residencia temporal y permanente, diseñado bajo normativas de transparencia y agilidad para gestionar la permanencia legal sin intermediarios."
                                                        : "This citizen portal centralizes all temporary and permanent residence procedures, designed under transparency and agility guidelines to manage legal stay without intermediaries.")
                        </p>

                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="dato-dgm h-100" style="--acc: #003876;">
                                        <h6 class="titulo-sub mb-1">
                                            <i class="bi bi-shield-lock me-2"></i>@(Idioma.EsEspanol ? "Seguridad Jurídica" : "Legal Certainty")
                                        </h6>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Trazabilidad con códigos verificables por inspectores legales." : "Traceability with codes verifiable by legal auditors.")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="dato-dgm h-100" style="--acc: #2ECC71;">
                                        <h6 class="titulo-sub mb-1">
                                            <i class="bi bi-speedometer2 me-2"></i>@(Idioma.EsEspanol ? "Respuesta Ágil" : "Agile Response")
                                        </h6>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Evaluación documental optimizada para reducir tiempos de espera." : "Optimized review to minimize waiting times.")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="dato-dgm h-100" style="--acc: #0087FF;">
                                        <h6 class="titulo-sub mb-1">
                                            <i class="bi bi-headset me-2"></i>@(Idioma.EsEspanol ? "Soporte Continuo" : "Continuous Support")
                                        </h6>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Asistencia técnica y notificaciones del estatus de tu expediente." : "Technical assistance and notifications regarding your file status.")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 3. TIPOS DE RESIDENCIA -->
                <div class="seccion-dgm p-4 p-lg-5 mb-4">
                    <div class="mb-4">
                        <h4 class="titulo-dgm mb-1">
                            @(Idioma.EsEspanol ? "Tipos de Residencia" : "Residence Types")
                        </h4>
                        <p class="texto-sec small mb-0">
                            @(Idioma.EsEspanol ? "Elige la categoría que corresponde a tu situación e inicia tu solicitud." : "Choose the category that matches your situation and start your application.")
                        </p>
                    </div>

                    <div class="row g-4">
                    @foreach (var tipo in tiposResidencia)
                        {
                            <div class="col-12 col-md-6 col-xl-3">
                                <article class="tarjeta-tipo h-100 d-flex flex-column" style="--acc: @tipo.Color;">
                                    <div class="tarjeta-tipo-cuerpo flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div class="tarjeta-tipo-icono">
                                                <i class="bi @tipo.Icono"></i>
                                            </div>
                                            <span class="tarjeta-tipo-badge">
                                                <span class="punto"></span>@T(tipo.CategoriaEs, tipo.CategoriaEn)
                                            </span>
                                        </div>

                                        <h5 class="tarjeta-tipo-titulo mb-2">@T(tipo.TituloEs, tipo.TituloEn)</h5>
                                        <p class="texto-sec small mb-3">@T(tipo.DescripcionEs, tipo.DescripcionEn)</p>

                                        <ul class="tarjeta-tipo-lista list-unstyled mb-0">
                                            @foreach (var punto in tipo.Puntos)
                                            {
                                                <li>
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <span>@T(punto.Es, punto.En)</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>

                                    <div class="tarjeta-tipo-tiempo">
                                        <i class="bi bi-clock"></i>
                                        <span>@(Idioma.EsEspanol ? "Tiempo promedio: " : "Average time: ")<strong>@(Idioma.EsEspanol ? "15 a 30 días hábiles" : "15 to 30 business days")</strong></span>
                                    </div>

                                    <div class="tarjeta-tipo-pie">
                                        <button class="btn-dgm btn-dgm-secundario w-100" @onclick="IniciarSolicitud">
                                            @(Idioma.EsEspanol ? "Iniciar solicitud" : "Start application")
                                            <i class="bi bi-chevron-right ms-1"></i>
                                        </button>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                </div>

                <!-- 4. BOTÓN DE "MÁS INFORMACIÓN / MENOS INFORMACIÓN" -->
                <div class="text-center my-4">
                    <button class="btn-dgm btn-dgm-secundario btn-dgm-lg d-inline-flex align-items-center gap-2"
                            @onclick="ToggleInvitado">
                        <span>
                            @if (mostrarInvitado)
                            {
                                @(Idioma.EsEspanol ? "Menos información" : "Less information")
                            }
                            else
                            {
                                @(Idioma.EsEspanol ? "Más información" : "More information")
                            }
                        </span>
                        <i class="bi @(mostrarInvitado ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>

                <!-- 5. INFORMACIÓN EXTRA (SE DESPLIEGA AL DARLE A "MÁS INFORMACIÓN") -->
                @if (mostrarInvitado)
                {
                    <div class="animate__animated animate__fadeIn">

                        <!-- Banner con imagen Parallax clara y efecto -->
                        <div class="parallax-section my-3 overflow-hidden">
                            <div class="parallax-overlay py-5 px-4 px-md-5">
                                <div class="container-fluid py-4">
                                    <div class="row align-items-center">
                                        <div class="col-12">
                                            <span class="badge-precaucion mb-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-globe"></i> @(Idioma.EsEspanol ? "Trámite Internacional" : "International Process")
                                            </span>
                                            <h3 class="fw-bold text-white mb-2 fuente-titulo" style="font-size: 2.2rem;">
                                                @(Idioma.EsEspanol ? "Permanencia Reglamentada Internacional" : "International Regulated Residency")
                                            </h3>
                                            <p class="texto-claro mb-0" style="max-width: 760px; font-size: 1rem; line-height: 1.6;">
                                                @(Idioma.EsEspanol
                                                                                        ? "Proceso de radicación y regularización migratoria aplicable desde cualquier país de origen."
                                                                                        : "Residency application and migration regularization applicable from any country of origin.")
                                                                                                                                                                                  </p>
                                                                                                                                                                              </div>
                                                                                                                                                                          </div>
                                                                                                                                                                      </div>
                                                                                                                                                                  </div>
                                                                                                                                                              </div>

                        <!-- Requisitos y Tiempos Estimados -->
                        <div class="seccion-dgm p-4 p-lg-5 mb-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="icon-circle-lg">
                                    <i class="bi bi-folder-fill fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="titulo-dgm mb-0">
                                        @(Idioma.EsEspanol ? "Requisitos y Tiempos Estimados del Trámite" : "Requirements and Estimated Processing Times")
                                    </h4>
                                    <small class="texto-sec">
                                        @(Idioma.EsEspanol ? "Guía esencial para completar tu expediente sin inconvenientes" : "Essential guide to submit your file smoothly")
                                    </small>
                                </div>
                            </div>

                            <h6 class="titulo-sub mt-3 mb-3">
                                @(Idioma.EsEspanol ? "Documentación obligatoria" : "Mandatory documentation")
                            </h6>
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-4">
                                    <div class="caja-dgm h-100">
                                        <strong class="titulo-sub d-block mb-1">
                                            <i class="bi bi-person-vcard me-1"></i> @(Idioma.EsEspanol ? "Cédula o Pasaporte" : "ID or Passport")
                                        </strong>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Documento de identidad vigente (pasaporte con mínimo 6 meses de vigencia)." : "Valid identity document (passport with at least 6 months validity).")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="caja-dgm h-100">
                                        <strong class="titulo-sub d-block mb-1">
                                            <i class="bi bi-file-earmark-medical me-1"></i> @(Idioma.EsEspanol ? "Antecedentes Penales" : "Police Clearance")
                                        </strong>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Récord o certificado de buena conducta legalizado o apostillado." : "Legalized or apostilled certificate of good conduct.")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="caja-dgm h-100">
                                        <strong class="titulo-sub d-block mb-1">
                                            <i class="bi bi-file-earmark-arrow-up me-1"></i> @(Idioma.EsEspanol ? "Formato Digital" : "Digital Format")
                                        </strong>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Archivos claros en PDF, JPG o PNG (máximo 5 MB por documento)." : "Clear files in PDF, JPG, or PNG (maximum 5 MB per document).")
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="dato-dgm h-100" style="--acc: #0087FF;">
                                        <h6 class="titulo-sub mb-1">
                                            <i class="bi bi-clock me-2"></i>@(Idioma.EsEspanol ? "Tiempo Estimado de Resolución" : "Estimated Processing Time")
                                        </h6>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "De 15 a 30 días hábiles tras la auditoría satisfactoria." : "15 to 30 business days after satisfactory legal review.")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="dato-dgm h-100" style="--acc: #FFBA00;">
                                        <h6 class="titulo-sub mb-1">
                                            <i class="bi bi-cash-coin me-2"></i>@(Idioma.EsEspanol ? "Tasas e Impuestos Oficiales" : "Official Fees & Taxes")
                                        </h6>
                                        <p class="texto-sec small mb-0">
                                            @(Idioma.EsEspanol ? "Aranceles oficiales calculados según la categoría migratoria legal." : "Official government fees calculated according to residency category.")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Alerta de precaución: Visado Previo -->
                        <div class="alerta-precaucion d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-exclamation-triangle-fill fs-3 flex-shrink-0"></i>
                            <div>
                                <h6 class="titulo-sub mb-1">
                                    @(Idioma.EsEspanol ? "Aviso Importante sobre Visado Previo" : "Important Notice on Prior Visa")
                                </h6>
                                <p class="texto-parrafo small mb-0">
                                    @(Idioma.EsEspanol
                                                                ? "Para iniciar una solicitud de residencia en este portal, es requisito indispensable contar con el Visado de Residencia (RS) emitido previamente por el consulado correspondiente."
                                                                : "To initiate a residence application, it is required to have a Residence Visa (RS) previously issued by the competent consulate.")
                        </p>
                    </div>
                </div>
            </div>
                        }

            </main>
        </div>
    }

    <FooterInstitucional />
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap');

    .portal-externo-container {
        min-height: 100vh;
        background-color: #F8F8F8;
        font-family: 'Roboto', sans-serif;
        color: #000000;
    }

    .fuente-titulo {
        font-family: 'Poppins', sans-serif;
    }

    .titulo-dgm {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        color: #003876;
    }

    .titulo-sub {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        color: #003876;
    }

        .titulo-sub i {
            color: var(--acc, #003876);
        }

    .texto-parrafo {
        color: #000000;
    }

    .texto-sec {
        color: #707070;
    }

    .texto-claro {
        color: rgba(255, 255, 255, 0.85);
    }

    .linea-inferior {
        border-bottom: 1px solid #E6E7E8;
    }

    .portal-header {
        position: sticky;
        top: 0;
        z-index: 1050;
        background-color: #ffffff;
        min-height: 72px;
        border-bottom: 1px solid #E6E7E8;
    }

    .selector-idioma {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 0.85rem;
        height: 36px;
        min-width: 115px;
        color: #003876;
        background-color: #F8F8F8;
        border: 1px solid #D3D3D3;
        border-radius: 999px;
