    private string T(string es, string en) => Idioma.EsEspanol ? es : en;

    protected override async Task OnInitializedAsync()
    {
        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;
        cargando = true;
        try
        {
            correoActivo = await JS.InvokeAsync<string>("localStorage.getItem", "correoUsuario");
            rolActivo = await JS.InvokeAsync<string>("localStorage.getItem", "rolUsuario");

            if (string.IsNullOrWhiteSpace(correoActivo))
            {
                correoActivo = await JS.InvokeAsync<string>("sessionStorage.getItem", "correoUsuario");
                rolActivo = await JS.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
            }

            if (!string.IsNullOrWhiteSpace(correoActivo))
            {
                bool esAdmin = (!string.IsNullOrWhiteSpace(rolActivo) && rolActivo.Equals("Administrador", StringComparison.OrdinalIgnoreCase));
                if (esAdmin)
                {
                    Navigation.NavigateTo("/dashboard", true);
                    return;
                }
                else
                {
                    Navigation.NavigateTo("/mis-solicitudes", true);
                    return;
                }
            }
        }
        catch
        {
            correoActivo = "";
            rolActivo = "";
        }
        finally
        {
            cargando = false;
        }
    }

    private void RefrescarPorIdioma()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CambiarIdiomaSeleccionado(ChangeEventArgs e)
    {
        var nuevo = e.Value?.ToString() ?? "ES";
        await Idioma.CambiarIdiomaAsync(nuevo);
    }

    private void ToggleInvitado()
    {
        mostrarInvitado = !mostrarInvitado;
    }

    private void IniciarSolicitud()
    {
        if (string.IsNullOrWhiteSpace(correoActivo))
        {
            Navigation.NavigateTo("/registro");
        }
        else
        {
            IrAPlataforma();
        }
    }

    private void IrAPlataforma()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(correoActivo))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            bool esAdmin = (!string.IsNullOrWhiteSpace(rolActivo) && rolActivo.Equals("Administrador", StringComparison.OrdinalIgnoreCase));

            if (esAdmin)
            {
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                Navigation.NavigateTo("/mis-solicitudes", true);
            }
        }
        catch
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void IrAlRegistro()
    {
        Navigation.NavigateTo("/registro");
    }

    public void Dispose()
    {
        Idioma.OnIdiomaCambiado -= RefrescarPorIdioma;
    }
}