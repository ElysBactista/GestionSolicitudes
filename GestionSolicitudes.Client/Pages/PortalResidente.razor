@page "/"
@page "/portal-residente"
@layout EmptyLayout
@using GestionSolicitudes.Client.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Portal de Servicios Migratorios | DGM</PageTitle>

<div class="portal-externo-container d-flex flex-column min-vh-100">

    <!-- Header Institucional Fijo -->
    <header class="portal-header sticky-top d-flex justify-content-between align-items-center px-4 px-md-5 bg-white shadow-sm border-bottom">
        <div class="d-flex align-items-center gap-3">
            <img src="logoinstitucional.png" alt="Logo Institucional" style="height: 65px; object-fit: contain;" />
            <div class="d-flex align-items-center gap-2 dgm-cupula">
            </div>
        </div>
        <PanelUsuarioHeader />
    </header>

    @if (cargando)
    {
        <div class="text-center my-5 py-5 flex-grow-1">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="text-muted mt-3 fw-semibold">Verificando sesión activa...</p>
        </div>
    }
    else
    {
        <div class="flex-grow-1">
            <!-- Banner Principal Parallax con Botón Sutil de Flecha a la Derecha -->
            <div class="hero-parallax-cielo text-white shadow-sm">
                <div class="hero-parallax-overlay container-fluid px-4 px-md-5 py-5 my-banner-altura">
                    <div class="d-flex align-items-center justify-content-between">
                        <h1 class="fw-bold text-white mb-0" style="font-size: 2.5rem;">Bienvenido al portal Residencia!!</h1>

                        @if (!string.IsNullOrWhiteSpace(correoActivo))
                        {
                            <button class="btn p-0 d-flex align-items-center justify-content-center shadow-sm btn-retorno-plataforma"
                                    @onclick="IrAPlataforma"
                                    title="Ir a mi plataforma">
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Contenido Principal: Secciones Informativas -->
            <main class="container-fluid px-4 px-md-5 py-4">

                <!-- Sección 1: Información Institucional -->
                <div class="card shadow-sm rounded-4 p-4 p-lg-5 bg-white mb-4 panel-residencia-border">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="cupula-icon-box">
                            <svg viewBox="10 20 215 195" width="46" height="46" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <style type="text/css">
                                    .dgm-cupula {
                                        fill: #003876
                                    }
                                </style>
                                <path d="M119.6 40.8v-2h4.2v-2.7H122v1.7h-2.5v-4.4h.4v-2.6h-1.8v2.6h.4v4.5H116v-1.7h-1.7v2.7h4.2v2c-7.9.3-14 6.9-13.9 14.7h28.6c.3-7.9-5.8-14.4-13.6-14.8z" class="dgm-cupula"></path>
                                <path d="M101 60.5h36.1c.3 0 .6-.3.6-.6v-2.2c0-.3-.2-.6-.6-.6H101c-.3 0-.6.3-.6.6v2.2c0 .4.3.6.6.6z" class="dgm-cupula"></path>
                                <path d="M101 87.8h36.1c.3 0 .6-.3.6-.6V85c0-.3-.2-.6-.6-.6H101c-.3 0-.6.3-.6.6v2.2c0 .4.3.6.6.6z" class="dgm-cupula"></path>
                                <path d="M107.5 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1-1V63.2c0-.6-.5-1-1-1.1h-4.3z" class="dgm-cupula"></path>
                                <path d="M116.8 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1.1-1V63.2c0-.6-.5-1-1-1.1h-4.4z" class="dgm-cupula"></path>
                                <path d="M126 62.1c-.6 0-1 .5-1.1 1v18.8c0 .6.5 1 1 1.1h4.4c.6 0 1-.5 1.1-1V63.2c0-.6-.5-1-1-1.1H126z" class="dgm-cupula"></path>
                                <path d="M44.5 156.5c3.2-14.9 9.5-29 18.5-41.4 7.3-9.8 16.3-18.1 26.6-24.6C73.3 96.6 59 106.9 48 120.4c-13.4 17-20.9 37.9-21.2 59.5h13.9c.6-7.9 1.9-15.7 3.8-23.4z" class="dgm-cupula"></path>
                                <path d="M175.3 115.1c9 12.4 15.3 26.5 18.5 41.4 1.9 7.7 3.2 15.5 3.7 23.4h13.9c-.3-21.6-7.8-42.6-21.2-59.5-10.9-13.5-25.3-23.8-41.6-29.9 10.4 6.5 19.4 14.9 26.7 24.6z" class="dgm-cupula"></path>
                                <path d="M102.4 93.9c-7.9 3.9-15.3 8.9-21.7 14.9-27 25.2-30.2 59.9-30.7 71.1h24c-.7-20.7 3.5-41.3 12.2-60.1 4.3-9.2 9.8-17.9 16.2-25.9z" class="dgm-cupula"></path>
                                <path d="M187.8 179.9c-.5-11.2-3.7-45.9-30.7-71.1-6.5-6-13.8-11-21.7-14.9 6.4 8 11.8 16.7 16.1 26 8.7 18.8 12.9 39.4 12.2 60.1l24.1-.1z" class="dgm-cupula"></path>
                                <path d="M114.6 179.9v-86c-8.7 9.4-15.8 20.1-21 31.7-7.6 17-11.1 35.6-10.2 54.3h31.2z" class="dgm-cupula"></path>
                                <path d="M123.6 93.9v86h31.2c.9-18.6-2.6-37.2-10.2-54.3-5.2-11.6-12.3-22.3-21-31.7z" class="dgm-cupula"></path>
                                <path d="M197.7 186.8v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-23.2v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-30.4v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9h-30v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9H50.4v-2.9c0-.6-.5-1.1-1.1-1.1h-7.9c-.6 0-1.1.5-1.1 1.1v2.9H20.9v3.5h196v-3.5h-19.2z" class="dgm-cupula"></path>
                                <path d="M49.2 203.1c.7 0 1.2-.5 1.2-1.2v-9.3H40.3v9.3c0 .7.5 1.2 1.2 1.2h7.7z" class="dgm-cupula"></path>
                                <path d="M82.6 203.1c.7 0 1.2-.5 1.2-1.2v-9.3H73.7v9.3c0 .7.5 1.2 1.2 1.2h7.7z" class="dgm-cupula"></path>
                                <path d="M122.7 203.1c.7 0 1.2-.5 1.2-1.2v-9.3h-10.1v9.3c0 .7.5 1.2 1.2 1.2h7.7z" class="dgm-cupula"></path>
                                <path d="M163.2 203.1c.7 0 1.2-.5 1.2-1.2v-9.3h-10.2v9.3c0 .7.5 1.2 1.2 1.2h7.8z" class="dgm-cupula"></path>
                                <path d="M196.5 203.1c.7 0 1.2-.5 1.2-1.2v-9.3h-10.1v9.3c0 .7.5 1.2 1.2 1.2h7.7z" class="dgm-cupula"></path>
                                <path d="M215.5 206H22.2c-.7 0-1.3.6-1.3 1.3v5c0 .7.6 1.3 1.3 1.3h193.3c.7 0 1.3-.6 1.3-1.3v-5c0-.7-.6-1.3-1.3-1.3z" class="dgm-cupula"></path>
                            </svg>
                        </div>
                        <div class="d-flex flex-column justify-content-center">
                            <h4 class="fw-bold text-dark mb-0">Dirección General de Migración | Canal Oficial</h4>
                            <small class="text-muted">Plataforma digital para la regularización de estancias y residencias</small>
                        </div>
                    </div>

                    <p class="text-muted fs-6 mb-4" style="line-height: 1.7;">
                        Este portal ciudadano centraliza todos los trámites de residencia temporal y permanente. Diseñado bajo normativas de transparencia y agilidad, permite gestionar la permanencia legal sin intermediarios.
                    </p>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 bg-light border-start border-4 border-primary h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Seguridad Jurídica</h6>
                                <p class="text-muted small mb-0">Trazabilidad con códigos verificables por inspectores legales.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 bg-light border-start border-4 border-success h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-speedometer2 text-success me-2"></i>Respuesta Ágil</h6>
                                <p class="text-muted small mb-0">Evaluación documental optimizada para reducir tiempos de espera.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 bg-light border-start border-4 border-info h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-headset text-info me-2"></i>Soporte Continuo</h6>
                                <p class="text-muted small mb-0">Asistencia técnica y notificaciones del estatus de tu expediente.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: TIPOS DE RESIDENCIA -->
                <div class="card shadow-sm rounded-4 p-4 p-lg-5 bg-white mb-4 border-top-accent">
                    <h4 class="fw-bold text-dark mb-3"><i class="bi bi-bookmarks text-primary me-2"></i>Tipos de Residencia</h4>
                    <p class="text-muted small mb-4">Selecciona el tipo de estatus migratorio que se adapta a tu caso particular:</p>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="p-4 rounded-4 bg-light border h-100 d-flex flex-column justify-content-between card-residencia-hover">
                                <div>
                                    <span class="badge mb-2" style="background-color: #e0f2fe; color: #0369a1;">Académica</span>
                                    <h5 class="fw-bold text-dark" style="font-size: 1.1rem;">Residencia de Estudiante</h5>
                                    <p class="text-muted small mb-3">Para cursar estudios regulares en instituciones autorizadas.</p>
                                </div>
                                <div class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill me-1 text-primary"></i> Trámite Digital</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="p-4 rounded-4 bg-light border h-100 d-flex flex-column justify-content-between card-residencia-hover">
                                <div>
                                    <span class="badge mb-2" style="background-color: #dcfce7; color: #15803d;">Laboral</span>
                                    <h5 class="fw-bold text-dark" style="font-size: 1.1rem;">Residencia de Trabajo</h5>
                                    <p class="text-muted small mb-3">Para profesionales contratados por empresas legalmente establecidas.</p>
                                </div>
                                <div class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill me-1 text-success"></i> Contrato Vigente</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="p-4 rounded-4 bg-light border h-100 d-flex flex-column justify-content-between card-residencia-hover">
                                <div>
                                    <span class="badge mb-2" style="background-color: #f3e8ff; color: #7e22ce;">Familiar</span>
                                    <h5 class="fw-bold text-dark" style="font-size: 1.1rem;">Residencia por Familia</h5>
                                    <p class="text-muted small mb-3">Por vínculos de matrimonio o filiación directa con residentes.</p>
                                </div>
                                <div class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill me-1" style="color: #7e22ce;"></i> Vínculo Legal</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="p-4 rounded-4 bg-light border h-100 d-flex flex-column justify-content-between card-residencia-hover">
                                <div>
                                    <span class="badge mb-2" style="background-color: #fef08a; color: #854d0e;">Menores</span>
                                    <h5 class="fw-bold text-dark" style="font-size: 1.1rem;">Residencia de Menores</h5>
                                    <p class="text-muted small mb-3">Especial para hijos menores dependientes de titulares legales.</p>
                                </div>
                                <div class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill me-1 text-warning"></i> Protección Legal</div>
                            </div>
                        </div>
                    </div>
                </div>

            </main>

            <!-- Barra 2: Parallax con Información Global -->
            <div class="parallax-section my-3">
                <div class="parallax-overlay py-5 px-4 px-md-5">
                    <div class="container-fluid py-5 my-banner-altura">
                        <div class="row align-items-center">
                            <div class="col-12 col-lg-8">
                                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-2">
                                    <i class="bi bi-globe me-1"></i> Trámite Internacional
                                </span>
                                <h3 class="fw-bold text-white mb-2" style="font-size: 2.3rem;">Permanencia Reglamentada Internacional</h3>
                                <p class="text-white-50 mb-0" style="max-width: 760px; font-size: 1rem; line-height: 1.6;">
                                    Proceso de radicación y regularización migratoria aplicable desde cualquier país de origen.
                                </p>
                            </div>
                            <div class="col-12 col-lg-4 text-lg-end mt-3 mt-lg-0">
                                <div class="d-inline-flex gap-3 text-start bg-white bg-opacity-10 p-3 rounded-3 border border-white border-opacity-25 shadow-sm">
                                    <i class="bi bi-patch-check-fill fs-2 text-warning"></i>
                                    <div>
                                        <h6 class="text-white fw-bold mb-0">Validez Oficial</h6>
                                        <small class="text-white-50">Certificación con firma digital.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Continuación de Contenido Central: Requisitos -->
            <main class="container-fluid px-4 px-md-5 pt-3 pb-2">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white mb-4 border-top-warning">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle-lg bg-warning-subtle text-warning">
                            <i class="bi bi-folder2-open fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">Requisitos y Tiempos Estimados del Trámite</h4>
                            <small class="text-muted">Guía esencial para completar tu expediente sin inconvenientes</small>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark text-uppercase mt-3 mb-3" style="font-size: 0.82rem; letter-spacing: 0.5px; color: #003876;">
                        <i class="bi bi-file-earmark-text me-1"></i> 1. Documentación Obligatoria
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <strong class="text-dark d-block mb-1"><i class="bi bi-person-vcard text-success me-1"></i> Cédula o Pasaporte</strong>
                                <p class="text-muted small mb-0">Documento de identidad vigente (pasaporte con mínimo 6 meses de vigencia).</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <strong class="text-dark d-block mb-1"><i class="bi bi-file-earmark-medical text-success me-1"></i> Antecedentes</strong>
                                <p class="text-muted small mb-0">Récord o certificado de buena conducta legalizado o apostillado.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <strong class="text-dark d-block mb-1"><i class="bi bi-file-earmark-arrow-up text-success me-1"></i> Formato Digital</strong>
                                <p class="text-muted small mb-0">Archivos claros en PDF, JPG o PNG (máximo 10 MB por documento).</p>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 bg-light border-start border-4 border-info h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-clock text-info me-2"></i>Tiempo Estimado de Resolución</h6>
                                <p class="text-muted small mb-0">De <strong>15 a 30 días hábiles</strong> tras la auditoría satisfactoria.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 bg-light border-start border-4 border-warning h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-cash-coin text-warning me-2"></i>Tasas e Impuestos Oficiales</h6>
                                <p class="text-muted small mb-0">Aranceles oficiales calculados según la categoría migratoria legal.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Aviso de Visado Previo -->
                <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3 bg-warning-subtle text-dark">
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning flex-shrink-0"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Aviso Importante sobre Visado Previo</h6>
                        <p class="small mb-0">Para iniciar una solicitud de residencia en este portal, es requisito indispensable contar con el <strong>Visado de Residencia (RS)</strong> emitido previamente por el consulado correspondiente.</p>
                    </div>
                </div>

                <!-- Bloque Final: Redirección directa a Registro de Usuario -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-4 bg-white border-top-accent mb-4">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-center text-md-start">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">¿Estás listo para iniciar tu trámite migratorio?</h5>
                            <p class="text-muted small mb-0">Inicia sesión con tu cuenta o regístrate en segundos para dar el primer paso hacia tu residencia legal.</p>
                        </div>
                        <div>
                            <button class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm text-nowrap btn-action"
                                    style="background-color: #003876;"
                                    @onclick="IrAlRegistro">
                                <i class="bi bi-person-plus-fill me-2"></i> Crear Cuenta / Registrarse
                            </button>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <FooterInstitucional />
    }
</div>

<style>
    .portal-externo-container {
        min-height: 100vh;
        background-color: #f4f6f9;
        font-family: 'Poppins', sans-serif;
    }

    .portal-header {
        position: sticky;
        top: 0;
        z-index: 1050;
        background-color: #ffffff;
        padding-top: 0.45rem;
        padding-bottom: 0.45rem;
    }

    .card-residencia-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .card-residencia-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 56, 118, 0.12) !important;
            border-color: #003876 !important;
        }

    .hero-parallax-cielo {
        width: 100%;
        background-image: url('https://images.unsplash.com/photo-1534088568595-a066f410bcda?q=80&w=2070&auto=format&fit=crop');
        background-attachment: fixed;
        background-position: center 7%;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .my-banner-altura {
        padding-top: 6rem !important;
        padding-bottom: 6rem !important;
    }

    .hero-parallax-overlay {
        background: linear-gradient(90deg, rgba(0, 40, 85, 0.78) 0%, rgba(0, 56, 118, 0.65) 55%, rgba(0, 86, 179, 0.55) 100%);
    }

    /* Botón sutil, pequeño y translúcido de retorno */
    .btn-retorno-plataforma {
        width: 34px;
        height: 34px;
        min-width: 34px;
        background-color: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 8px;
        color: #ffffff;
        backdrop-filter: blur(4px);
        font-size: 1rem;
        transition: all 0.2s ease-in-out;
    }

        .btn-retorno-plataforma:hover {
            background-color: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.6);
            color: #ffffff;
            transform: translateX(2px);
        }

    .panel-residencia-border {
        border: 1px solid #003876 !important;
    }

    .cupula-icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .parallax-section {
        width: 100%;
        background-image: url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop');
        background-attachment: fixed;
        background-position: center 40%;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .parallax-overlay {
        background: linear-gradient(90deg, rgba(5, 15, 30, 0.55) 0%, rgba(10, 30, 55, 0.4) 60%, rgba(15, 45, 75, 0.2) 100%);
        backdrop-filter: blur(0.5px);
    }

    .border-top-accent {
        border-top: 4px solid #003876 !important;
    }

    .border-top-warning {
        border-top: 4px solid #f59e0b !important;
    }

    .icon-circle-lg {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-action {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 56, 118, 0.3) !important;
        }
</style>

@code {
    private bool cargando = true;
    private string correoActivo = "";
    private string rolActivo = "";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            correoActivo = await JS.InvokeAsync<string>("localStorage.getItem", "correoUsuario");
            rolActivo = await JS.InvokeAsync<string>("localStorage.getItem", "rolUsuario");

            if (string.IsNullOrWhiteSpace(correoActivo))
            {
                correoActivo = await JS.InvokeAsync<string>("sessionStorage.getItem", "correoUsuario");
                rolActivo = await JS.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
            }
        }
        catch
        {
            correoActivo = "";
            rolActivo = "";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrAPlataforma()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(correoActivo))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            bool esAdmin = (!string.IsNullOrWhiteSpace(rolActivo) && rolActivo.Contains("admin", StringComparison.OrdinalIgnoreCase)) ||
                           correoActivo.Contains("admin", StringComparison.OrdinalIgnoreCase);

            if (esAdmin)
            {
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                Navigation.NavigateTo("/mis-solicitudes", true);
            }
        }
        catch
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void IrAlRegistro()
    {
        Navigation.NavigateTo("/registro");
    }
}