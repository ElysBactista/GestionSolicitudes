@code {
    private RegistroUsuarioModelo modelo = new();
    private string tipoDocumentoSeleccionado = "Cedula";
    private string codigoPais = "+1-DO";
    private bool menuPaisesAbierto = false;
    private string telefonoFormateado = string.Empty;
    private string confirmarPassword = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool cargando = false;

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private string ObtenerBandera(string codigo)
    {
        return codigo switch
        {
            "+1-DO" => "https://flagcdn.com/w40/do.png",
            "+1-US" => "https://flagcdn.com/w40/us.png",
            "+44-GB" => "https://flagcdn.com/w40/gb.png",
            _ => "https://flagcdn.com/w40/do.png"
        };
    }

    private string ObtenerPrefijoTexto(string codigo)
    {
        return codigo switch
        {
            "+1-DO" => "+1",
            "+1-US" => "+1",
            "+44-GB" => "+44",
            _ => "+1"
        };
    }

    private void SeleccionarPais(string codigo)
    {
        codigoPais = codigo;
        menuPaisesAbierto = false;
        telefonoFormateado = string.Empty;
        modelo.Telefono = string.Empty;
    }

    private void OnDocumentoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (tipoDocumentoSeleccionado == "Cedula")
        {
            var digitos = new string(raw.Where(char.IsDigit).Take(11).ToArray());
            if (digitos.Length <= 3)
            {
                modelo.NumeroPasaporte = digitos;
            }
            else if (digitos.Length <= 10)
            {
                modelo.NumeroPasaporte = $"{digitos.Substring(0, 3)}-{digitos.Substring(3)}";
            }
            else
            {
                modelo.NumeroPasaporte = $"{digitos.Substring(0, 3)}-{digitos.Substring(3, 7)}-{digitos.Substring(10)}";
            }
        }
        else
        {
            modelo.NumeroPasaporte = new string(raw.Where(char.IsLetterOrDigit).Take(12).ToArray()).ToUpper();
        }
    }

    private void OnTelefonoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digitos = new string(raw.Where(char.IsDigit).ToArray());

        if (codigoPais.Contains("+1"))
        {
            var clean = new string(digitos.Take(10).ToArray());
            if (clean.Length <= 3)
                telefonoFormateado = clean;
            else if (clean.Length <= 6)
                telefonoFormateado = $"({clean.Substring(0, 3)}) {clean.Substring(3)}";
            else
                telefonoFormateado = $"({clean.Substring(0, 3)}) {clean.Substring(3, 3)}-{clean.Substring(6)}";
        }
        else
        {
            var clean = new string(digitos.Take(11).ToArray());
            if (clean.Length <= 5)
                telefonoFormateado = clean;
            else
                telefonoFormateado = $"{clean.Substring(0, 5)} {clean.Substring(5)}";
        }

        var prefijoLimpio = codigoPais.Split('-')[0];
        modelo.Telefono = $"{prefijoLimpio} {telefonoFormateado}".Trim();
    }

    private async Task ProcesarRegistro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (modelo.Password != confirmarPassword)
        {
            mensajeError = "Las contraseñas no coinciden.";
            return;
        }

        if (modelo.Password.Length < 6)
        {
            mensajeError = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        cargando = true;

        try
        {
            var esAdmin = modelo.Email.Trim().EndsWith("@admin.do.gob", StringComparison.OrdinalIgnoreCase);
            var rolAsignado = esAdmin ? "Administrador" : "Residente";

            var payload = new
            {
                Email = modelo.Email.Trim(),
                Password = modelo.Password,
                Rol = rolAsignado
            };

            var response = await Http.PostAsJsonAsync("api/auth/registro", payload);

            if (response.IsSuccessStatusCode)
            {
                var respuesta = await response.Content.ReadFromJsonAsync<RespuestaApiDto>();

                await JS.InvokeVoidAsync("localStorage.setItem", "nombreUsuario", modelo.NombreCompleto);
                await JS.InvokeVoidAsync("localStorage.setItem", "correoUsuario", modelo.Email);
                await JS.InvokeVoidAsync("localStorage.setItem", "rolUsuario", rolAsignado);
                if (!string.IsNullOrEmpty(respuesta?.Token))
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", respuesta.Token);
                }

                if (esAdmin)
                {
                    mensajeExito = "¡Cuenta de Administrador creada! Ingresando a la plataforma...";
                    StateHasChanged();
                    await Task.Delay(1000);
                    Navigation.NavigateTo("/dashboard");
                }
                else
                {
                    mensajeExito = "¡Cuenta creada exitosamente! Accediendo al portal de trámites...";
                    StateHasChanged();
                    await Task.Delay(1000);
                    Navigation.NavigateTo("/portal-residente");
                }
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<RespuestaApiDto>();
                mensajeError = errorObj?.Mensaje ?? "No se pudo completar el registro.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class RegistroUsuarioModelo
    {
        public string NombreCompleto { get; set; } = string.Empty;
        public string NumeroPasaporte { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaApiDto
    {
        public bool Exito { get; set; }
        public string Mensaje { get; set; } = string.Empty;
        public string? Token { get; set; }
        public string? Rol { get; set; }
    }
}