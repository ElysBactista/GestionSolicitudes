@page "/registro"
@layout EmptyLayout
@using GestionSolicitudes.Client.Layout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<PageTitle>@(Idioma.EsEspanol ? "Registro de Nuevo Usuario - Dirección General de Migración" : "New User Registration - General Directorate of Migration")</PageTitle>

<div class="divPrincipalRegistro">

    <!-- Selector discreto de idioma superior -->
    <div class="position-absolute top-0 end-0 p-3" style="z-index: 25;">
        <select class="form-select form-select-sm border-0 bg-white shadow-sm fw-semibold text-secondary rounded-pill px-3 py-1 cursor-pointer"
                style="font-size: 0.85rem; height: 36px; min-width: 115px;"
                value="@Idioma.IdiomaActual"
                @onchange="CambiarIdioma">
            <option value="ES">Español</option>
            <option value="EN">English</option>
        </select>
    </div>

