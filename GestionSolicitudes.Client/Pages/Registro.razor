@page "/registro"
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Registro de Nuevo Usuario - Dirección General de Migración</PageTitle>

<div class="divPrincipalRegistro">
    <!-- Fondo Curvado Institucional -->
    <div class="curved-background" aria-hidden="true">
        <div class="image__registro__logo">
            <svg class="registro__main__image" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1238 759.96">
                <text transform="matrix(1.1561 0 0 1 283.3885 434.893)" fill="#fff" font-family="Gotham-Light" font-size="64.999px">
                    <tspan x="0" y="0">G</tspan><tspan x="50.18" y="0">OBI</tspan><tspan x="168.02" y="0">E</tspan><tspan x="210.79" y="0">R</tspan><tspan x="257.07" y="0">N</tspan><tspan x="307.64" y="0">O </tspan><tspan x="380.95" y="0">DE</tspan><tspan x="473.77" y="0"> L</tspan><tspan x="532.08" y="0">A</tspan>
                </text>
                <text transform="matrix(1.0006 0 0 1 25.3106 535.0453)" fill="#fff" font-family="Marion" font-size="96.8px">REPÚBLICA DOMINICANA</text>
                <rect x="455.21" y="598.03" fill="#E4262F" width="330.84" height="11"></rect>
                <text transform="matrix(1.063 0 0 1 300.1211 730.3217)" fill="#E4262F" font-family="Marion" font-size="102.4415px" letter-spacing="0.94">MIGRACIÓN</text>
            </svg>
        </div>
    </div>

    <!-- Contenedor de la Tarjeta de Registro -->
    <div class="registro-content-layer">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden w-100 mx-3 my-4" style="max-width: 960px; background: #ffffff;">
            <div class="row g-0">

                <!-- Panel Lateral Informativo DGM -->
                <div class="col-lg-4 d-none d-lg-flex flex-column justify-content-between p-4 text-white" style="background-color: #003876;">

                    <!-- 1. Header: Logo Oficial Completo de Migración en Blanco -->
                    <div style="margin-top: 50px;">
                        <img loading="lazy"
                             src="https://migracion.gob.do/wp-content/themes/dgm/img/logo_blanco.svg"
                             alt="Logo de la Dirección General de Migración"
                             style="max-width: 100%; height: 58px; object-fit: contain; display: block;" />
                    </div>
                    
                    <!-- 2. Contenido Informativo Posicionado Más Abajo -->
                    <div class="mb-auto py-2" style="margin-top: 50px;">
                        <h6 class="fw-bold text-white mb-2" style="font-size: 0.88rem;">Portal de Servicios Digitales</h6>
                        <p class="text-white-50 lh-sm mb-3" style="font-size: 0.75rem;">
                            Cree su cuenta para acceder a la plataforma, gestionar solicitudes y dar seguimiento a sus trámites de forma segura.
                        </p>

                        @* <div class="pt-3 border-top border-white border-opacity-25 d-flex flex-column gap-2"> *@
                            <div>
                                <strong class="d-block text-white" style="font-size: 0.75rem;">Seguridad Garantizada</strong>
                                <span class="text-white-50" style="font-size: 0.70rem; line-height: 1.25; display: block;">Tus datos personales y credenciales están cifrados.</span>
                            </div>
                            <div>
                                <strong class="d-block text-white" style="font-size: 0.75rem;">Acceso 24/7</strong>
                                <span class="text-white-50" style="font-size: 0.70rem; line-height: 1.25; display: block;">Consulta el estado de tus procesos en cualquier momento.</span>
                            </div>
                      @*   </div> *@
                    </div>

                    <!-- 3. Footer: Contacto para Asistencia con Icono Pequeño -->
                    <div class="pt-3 border-top border-white border-opacity-25 d-flex align-items-center gap-2">
                        <i class="bi bi-telephone-fill text-warning flex-shrink-0" style="font-size: 0.85rem;"></i>
                        <div class="lh-1">
                            <strong class="text-white d-block mb-1" style="font-size: 0.75rem;">Contacto para asistencia</strong>
                            <span class="text-white-50 d-block" style="font-size: 0.68rem; line-height: 1.3;">
                                Tel: (809) 508-2555<br />
                                info@migracion.gob.do
                            </span>
                        </div>
                    </div>

                </div>

                <!-- Formulario de Registro -->
                <div class="col-lg-8 p-4 p-md-5">
                    <div class="mb-4">
                        <h4 class="fw-bold mb-1" style="color: #003876;">Registro de Nuevo Usuario</h4>
                        <p class="text-muted small mb-0">Complete la información requerida para habilitar su acceso a la plataforma.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@mensajeError</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <div>@mensajeExito</div>
                        </div>
                    }

                    <EditForm Model="modelo" OnValidSubmit="ProcesarRegistro">
                        <DataAnnotationsValidator />

                        <!-- Sección: Datos Personales -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">
                           
                            <i class="bi bi-person-vcard me-2" style="color: #003876;"></i> DATOS PERSONALES
                        </h6>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">NOMBRE COMPLETO *</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Nombres y Apellidos completos"
                                       @bind-value="modelo.NombreCompleto"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">DOCUMENTO / PASAPORTE *</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Ej. P0948214"
                                       @bind-value="modelo.NumeroPasaporte"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">TELÉFONO DE CONTACTO *</label>
                                <input type="tel"
                                       class="form-control"
                                       placeholder="Ej. +1 (809) 000-0000"
                                       @bind-value="modelo.Telefono"
                                       required />
                            </div>
                        </div>

                        <!-- Sección: Credenciales -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3 mt-4">
                            <i class="bi bi-key-fill me-2" style="color: #003876;"></i> CREDENCIALES DE ACCESO
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">CORREO ELECTRÓNICO (USUARIO) *</label>
                                <input type="email"
                                       class="form-control"
                                       placeholder="correo@ejemplo.com"
                                       @bind-value="modelo.Email"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">CONTRASEÑA *</label>
                                <input type="password"
                                       class="form-control"
                                       placeholder="Mínimo 6 caracteres"
                                       @bind-value="modelo.Password"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">CONFIRMAR CONTRASEÑA *</label>
                                <input type="password"
                                       class="form-control"
                                       placeholder="Repita su contraseña"
                                       @bind-value="confirmarPassword"
                                       required />
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" @onclick="VolverAlLogin">
                                <i class="bi bi-x-circle me-1"></i> Cancelar y volver
                            </button>
                            <button type="submit" class="btn text-white px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background-color: #003876;" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creando cuenta...</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-check-fill me-1"></i>
                                    <span>Crear Cuenta</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .divPrincipalRegistro {
        position: relative;
        min-height: 100vh;
        width: 100vw;
        overflow-x: hidden;
        background-color: #f8f9fa;
        font-family: 'Poppins', sans-serif;
    }

    .curved-background {
        position: fixed;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background-color: #003876;
        clip-path: ellipse(110% 90% at 85% 100%);
        pointer-events: none;
        z-index: 1;
    }

    .image__registro__logo {
        position: absolute;
        right: 6%;
        bottom: 12%;
        width: 440px;
        opacity: 0.10;
        z-index: 2;
        pointer-events: none;
    }

    .registro-content-layer {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-control {
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        font-size: 0.9rem;
        border: 1px solid #CBD5E1;
    }

    .form-control:focus {
        border-color: #003876;
        box-shadow: 0 0 0 0.2rem rgba(0, 56, 118, 0.15);
    }
</style>

@code {
    private RegistroUsuarioModelo modelo = new();
    private string confirmarPassword = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool cargando = false;

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task ProcesarRegistro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (modelo.Password != confirmarPassword)
        {
            mensajeError = "Las contraseñas no coinciden.";
            return;
        }

        if (modelo.Password.Length < 6)
        {
            mensajeError = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        cargando = true;

        try
        {
            var payload = new
            {
                Email = modelo.Email,
                Password = modelo.Password,
                Rol = "Residente"
            };

            var response = await Http.PostAsJsonAsync("api/auth/registro", payload);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "nombreUsuario", modelo.NombreCompleto);
                await JS.InvokeVoidAsync("sessionStorage.setItem", "correoUsuario", modelo.Email);

                mensajeExito = "¡Cuenta creada exitosamente! Redirigiendo al inicio de sesión...";
                StateHasChanged();

                await Task.Delay(1400);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<RespuestaApiDto>();
                mensajeError = errorObj?.Mensaje ?? "No se pudo completar el registro.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class RegistroUsuarioModelo
    {
        public string NombreCompleto { get; set; } = string.Empty;
        public string NumeroPasaporte { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaApiDto
    {
        public bool Exito { get; set; }
        public string Mensaje { get; set; } = string.Empty;
    }
}