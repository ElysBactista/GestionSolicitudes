@code {
    private RegistroUsuarioModelo modelo = new();
    private string tipoDocumentoSeleccionado = "Cedula";
    private string codigoPais = "+1-DO";
    private bool menuPaisesAbierto = false;
    private string telefonoFormateado = string.Empty;
    private string confirmarPassword = string.Empty;
    private bool mostrarPassword = false;
    private bool mostrarConfirmarPassword = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool cargando = false;

    private int MaxLongitudTelefono => codigoPais.Contains("+1") ? 14 : 12;

    protected override async Task OnInitializedAsync()
    {
        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;
        await Idioma.InicializarAsync();
    }

    private void RefrescarPorIdioma()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CambiarIdioma(ChangeEventArgs e)
    {
        var nuevo = e.Value?.ToString() ?? "ES";
        await Idioma.CambiarIdiomaAsync(nuevo);
    }

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private string ObtenerBandera(string codigo) => codigo switch
    {
        "+1-DO" => "https://flagcdn.com/w40/do.png",
        "+1-US" => "https://flagcdn.com/w40/us.png",
        "+44-GB" => "https://flagcdn.com/w40/gb.png",
        _ => "https://flagcdn.com/w40/do.png"
    };

    private string ObtenerPrefijoTexto(string codigo) => codigo switch
    {
        "+1-DO" => "+1",
        "+1-US" => "+1",
        "+44-GB" => "+44",
        _ => "+1"
    };

    private void SeleccionarPais(string codigo)
    {
        codigoPais = codigo;
        menuPaisesAbierto = false;
        telefonoFormateado = string.Empty;
        modelo.Telefono = string.Empty;
    }

    private void OnNombreInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        modelo.NombreCompleto = new string(raw.Where(c => char.IsLetter(c) || char.IsWhiteSpace(c) || c == '\'' || c == '-').ToArray());
    }

    private void OnDocumentoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (tipoDocumentoSeleccionado == "Cedula")
        {
            var digitos = new string(raw.Where(char.IsDigit).Take(11).ToArray());
            if (digitos.Length <= 3)
            {
                modelo.NumeroPasaporte = digitos;
            }
            else if (digitos.Length <= 10)
            {
                modelo.NumeroPasaporte = $"{digitos.Substring(0, 3)}-{digitos.Substring(3)}";
            }
            else
            {
                modelo.NumeroPasaporte = $"{digitos.Substring(0, 3)}-{digitos.Substring(3, 7)}-{digitos.Substring(10, 1)}";
            }
        }
        else
        {
            modelo.NumeroPasaporte = new string(raw.Where(char.IsLetterOrDigit).Take(9).ToArray()).ToUpper();
        }
    }

    private void OnTelefonoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digitos = new string(raw.Where(char.IsDigit).ToArray());

        if (codigoPais.Contains("+1"))
        {
            var clean = new string(digitos.Take(10).ToArray());
            if (clean.Length == 0)
            {
                telefonoFormateado = string.Empty;
            }
            else if (clean.Length <= 3)
            {
                telefonoFormateado = clean;
            }
            else if (clean.Length <= 6)
            {
                telefonoFormateado = $"({clean.Substring(0, 3)}) {clean.Substring(3)}";
            }
            else
            {
                int digitosFinales = Math.Min(4, clean.Length - 6);
                telefonoFormateado = $"({clean.Substring(0, 3)}) {clean.Substring(3, 3)}-{clean.Substring(6, digitosFinales)}";
            }
        }
        else
        {
            var clean = new string(digitos.Take(11).ToArray());
            if (clean.Length <= 5)
                telefonoFormateado = clean;
            else
                telefonoFormateado = $"{clean.Substring(0, 5)} {clean.Substring(5)}";
        }

        var prefijoLimpio = codigoPais.Split('-')[0];
        modelo.Telefono = $"{prefijoLimpio} {telefonoFormateado}".Trim();
    }

    private async Task ProcesarRegistro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (modelo.Password != confirmarPassword)
        {
            mensajeError = Idioma.EsEspanol ? "Las contraseñas no coinciden." : "Passwords do not match.";
            return;
        }

        if (modelo.Password.Length < 6)
        {
            mensajeError = Idioma.EsEspanol ? "La contraseña debe tener al menos 6 caracteres." : "Password must be at least 6 characters.";
            return;
        }

        cargando = true;

        try
        {
            var payload = new
            {
                Email = modelo.Email.Trim(),
                Password = modelo.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/registro", payload);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = Idioma.EsEspanol
                    ? "¡Cuenta creada exitosamente! Redirigiendo al inicio de sesión..."
                    : "Account created successfully! Redirecting to sign in...";
                StateHasChanged();
                await Task.Delay(600);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<RespuestaApiDto>();
                mensajeError = errorObj?.Mensaje ?? (Idioma.EsEspanol ? "No se pudo completar el registro." : "Could not complete registration.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = (Idioma.EsEspanol ? "Error de comunicación con el servidor: " : "Server communication error: ") + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    public void Dispose()
    {
        Idioma.OnIdiomaCambiado -= RefrescarPorIdioma;
    }

    public class RegistroUsuarioModelo
    {
        public string NombreCompleto { get; set; } = string.Empty;
        public string NumeroPasaporte { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaApiDto
    {
        public bool Exito { get; set; }
        public string Mensaje { get; set; } = string.Empty;
        public string? Token { get; set; }
        public string? Rol { get; set; }
    }
}