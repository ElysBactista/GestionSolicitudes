                        <div class="pe-md-1">
                            <h6 class="fw-bold text-white mb-2" style="font-size: 0.95rem;">
                                @(Idioma.EsEspanol ? "Portal de Servicios Digitales" : "Digital Services Portal")
                            </h6>
                            <p class="text-white-50 lh-base mb-4" style="font-size: 0.78rem;">
                                @(Idioma.EsEspanol
                                                                ? "Plataforma oficial para la emisión, renovación y control de trámites migratorios con atención ciudadana en línea."
                                                                : "Official platform for issuance, renewal, and oversight of immigration files with online citizen service.")
                            </p>

                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <strong class="d-block text-white mb-1" style="font-size: 0.80rem;">
                                        <i class="bi bi-shield-check text-warning me-1"></i> @(Idioma.EsEspanol ? "Seguridad y Cifrado" : "Security & Encryption")
                                    </strong>
                                    <span class="text-white-50" style="font-size: 0.72rem; line-height: 1.35; display: block;">
                                        @(Idioma.EsEspanol
                                                                                ? "Tus datos personales y documentación confidencial están protegidos con altos estándares de seguridad institucional."
                                                                                : "Your personal data and sensitive documents are protected under institutional security standards.")
                                    </span>
                                </div>

                                <div>
                                    <strong class="d-block text-white mb-1" style="font-size: 0.80rem;">
                                        <i class="bi bi-clock-history text-warning me-1"></i> @(Idioma.EsEspanol ? "Disponibilidad 24/7" : "24/7 Availability")
                                    </strong>
                                    <span class="text-white-50" style="font-size: 0.72rem; line-height: 1.35; display: block;">
                                        @(Idioma.EsEspanol
                                                                                ? "Envía solicitudes y verifica el estado de tus expedientes en tiempo real sin límites de horario."
                                                                                : "Submit applications and verify your file status in real time around the clock.")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 border-top border-white border-opacity-25" style="margin-top: 50px !important; padding-top: 12px !important;">
                        <i class="bi bi-telephone-fill text-warning flex-shrink-0" style="font-size: 0.70rem;"></i>
                        <div class="lh-1">
                            <strong class="text-white d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.2px;">
                                @(Idioma.EsEspanol ? "Contacto para asistencia" : "Support Contact")
                            </strong>
                            <span class="text-white-50 d-block" style="font-size: 0.60rem; line-height: 1.25;">
                                Tel: (809) 508-2555<br />
                                info@migracion.gob.do
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Formulario de Registro -->
                <div class="col-12 col-lg-8 p-4 p-md-5 bg-white">
                    <div class="d-lg-none text-center mb-3">
                        <img src="logoinstitucional.png" alt="Logo Institucional" style="max-height: 52px; object-fit: contain;" />
                    </div>

                    <div class="mb-4">
                        <h4 class="fw-bold mb-1" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Registro de Nuevo Usuario" : "New User Registration")
                        </h4>
                        <p class="small mb-0 text-texto-negro">
                            @(Idioma.EsEspanol ? "Complete la información requerida para habilitar su acceso a la plataforma." : "Fill in the required information to activate your account.")
                        </p>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@mensajeError</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <div>@mensajeExito</div>
                        </div>
                    }

                    <EditForm Model="modelo" OnValidSubmit="ProcesarRegistro">
                        <DataAnnotationsValidator />

                        <!-- Título limpio sin icono -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="fw-bold text-dark text-uppercase small" style="letter-spacing: 0.5px; font-size: 0.8rem;">
                                @(Idioma.EsEspanol ? "DATOS PERSONALES" : "PERSONAL INFORMATION")
                            </span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label text-texto-negro small mb-1">
                                    @(Idioma.EsEspanol ? "Nombre Completo *" : "Full Name *")
                                </label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="@(Idioma.EsEspanol ? "Ej. Juana Pérez González" : "e.g., Juana Perez Gonzalez")"
                                       value="@modelo.NombreCompleto"
                                       @oninput="OnNombreInput"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small mb-1"></label>
                                <div class="input-group">
                                    <select class="form-select border-secondary-subtle text-texto-negro"
                                            style="max-width: 125px; font-size: 0.85rem;"
                                            @bind="tipoDocumentoSeleccionado">
                                        <option value="Cedula">@(Idioma.EsEspanol ? "Cédula" : "ID Card")</option>
                                        <option value="Pasaporte">@(Idioma.EsEspanol ? "Pasaporte" : "Passport")</option>
                                    </select>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="@(tipoDocumentoSeleccionado == "Cedula" ? "Ej. 402-0000000-0" : "Ej. P0948214")"
                                           value="@modelo.NumeroPasaporte"
                                           @oninput="OnDocumentoInput"
                                           maxlength="@(tipoDocumentoSeleccionado == "Cedula" ? 13 : 9)"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-texto-negro small mb-1"> </label>
                                <div class="input-group position-relative">
                                    <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 bg-light px-2"
                                            type="button"
                                            style="border-color: #CBD5E1; font-size: 0.85rem; color: #111827;"
                                            @onclick="() => menuPaisesAbierto = !menuPaisesAbierto">
                                        <img src="@ObtenerBandera(codigoPais)" alt="Bandera" style="width: 20px; height: 14px; object-fit: cover; border-radius: 2px;" />
                                        <span>@ObtenerPrefijoTexto(codigoPais)</span>
                                    </button>

                                    @if (menuPaisesAbierto)
                                    {
                                        <div class="dropdown-menu show shadow-sm border p-1 position-absolute"
                                             style="z-index: 1050; top: 100%; left: 0; min-width: 140px; border-radius: 8px;">
                                            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 small"
                                                    @onclick='() => SeleccionarPais("+1-DO")'>
                                                <img src="https://flagcdn.com/w40/do.png" alt="DO" style="width: 20px; height: 14px; object-fit: cover; border-radius: 2px;" />
                                                <span class="text-texto-negro">+1 (DO)</span>
                                            </button>
                                            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 small"
                                                    @onclick='() => SeleccionarPais("+1-US")'>
                                                <img src="https://flagcdn.com/w40/us.png" alt="US" style="width: 20px; height: 14px; object-fit: cover; border-radius: 2px;" />
                                                <span class="text-texto-negro">+1 (US)</span>
                                            </button>
                                            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 small"
                                                    @onclick='() => SeleccionarPais("+44-GB")'>
                                                <img src="https://flagcdn.com/w40/gb.png" alt="GB" style="width: 20px; height: 14px; object-fit: cover; border-radius: 2px;" />
                                                <span class="text-texto-negro">+44 (UK)</span>
                                            </button>
                                        </div>
                                    }

                                    <input type="tel"
                                           class="form-control"
                                           placeholder="@(codigoPais.Contains("+1") ? "(809) 000-0000" : "07000 000000")"
                                           value="@telefonoFormateado"
                                           @oninput="OnTelefonoInput"
                                           maxlength="@MaxLongitudTelefono"
                                           required />
                                </div>
                            </div>
                        </div>

                        <!-- Título limpio sin icono -->
                        <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                            <span class="fw-bold text-dark text-uppercase small" style="letter-spacing: 0.5px; font-size: 0.8rem;">
                                @(Idioma.EsEspanol ? "CREDENCIALES DE ACCESO" : "ACCESS CREDENTIALS")
                            </span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label text-texto-negro small mb-1">
                                    @(Idioma.EsEspanol ? "Correo electrónico (Usuario) *" : "Email Address (Username) *")
                                </label>
                                <input type="email"
                                       class="form-control"
                                       placeholder="correo@ejemplo.com"
                                       @bind-value="modelo.Email"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-texto-negro small mb-1">
                                    @(Idioma.EsEspanol ? "Contraseña *" : "Password *")
                                </label>
                                <div class="password-wrapper-custom">
                                    <input type="@(mostrarPassword ? "text" : "password")"
                                           class="form-control border-0 bg-transparent flex-grow-1"
                                           placeholder="••••••"
                                           @bind-value="modelo.Password"
                                           required />
                                    <button class="btn-toggle-eye"
                                            type="button"
                                            @onclick="() => mostrarPassword = !mostrarPassword"
                                            tabindex="-1"
                                            title="@(mostrarPassword ? (Idioma.EsEspanol ? "Ocultar" : "Hide") : (Idioma.EsEspanol ? "Mostrar" : "Show"))">
                                        <i class="bi @(mostrarPassword ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-texto-negro small mb-1">
                                    @(Idioma.EsEspanol ? "Confirmar Contraseña *" : "Confirm Password *")
                                </label>
                                <div class="password-wrapper-custom">
                                    <input type="@(mostrarConfirmarPassword ? "text" : "password")"
                                           class="form-control border-0 bg-transparent flex-grow-1"
                                           placeholder="@(Idioma.EsEspanol ? "Repita su contraseña" : "Repeat password")"
                                           @bind-value="confirmarPassword"
                                           required />
                                    <button class="btn-toggle-eye"
                                            type="button"
                                            @onclick="() => mostrarConfirmarPassword = !mostrarConfirmarPassword"
                                            tabindex="-1"
                                            title="@(mostrarConfirmarPassword ? (Idioma.EsEspanol ? "Ocultar" : "Hide") : (Idioma.EsEspanol ? "Mostrar" : "Show"))">
                                        <i class="bi @(mostrarConfirmarPassword ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end align-items-center gap-3 pt-4 mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3 text-texto-negro" @onclick="VolverAlLogin" style="border-radius: 8px;">
                                <i class="bi bi-x-circle me-1"></i> @(Idioma.EsEspanol ? "Cancelar" : "Cancel")
                            </button>
                            <!-- Botón con solo texto Registrarse -->
                            <button type="submit" class="btn text-white px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background-color: #003876; border-radius: 8px;" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>@(Idioma.EsEspanol ? "Registrando usuario..." : "Registering user...")</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-check-fill me-1"></i>
                                    <span>@(Idioma.EsEspanol ? "Registrarse" : "Register")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Institucional -->
    <div class="w-100 mt-auto" style="position: relative; z-index: 20;">
        <GestionSolicitudes.Client.Layout.FooterInstitucional />
    </div>
</div>

