                        <!-- 2. Información Institucional Ampliada -->
                        <div class="pe-md-1">
                            <h6 class="fw-bold text-white mb-2" style="font-size: 0.95rem;">Portal de Servicios Digitales</h6>
                            <p class="text-white-50 lh-base mb-4" style="font-size: 0.78rem;">
                                Plataforma oficial para la emisión, renovación y control de trámites migratorios con atención ciudadana en línea.
                            </p>

                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <strong class="d-block text-white mb-1" style="font-size: 0.80rem;">
                                        <i class="bi bi-shield-check text-warning me-1"></i> Seguridad y Cifrado
                                    </strong>
                                    <span class="text-white-50" style="font-size: 0.72rem; line-height: 1.35; display: block;">
                                        Tus datos personales y documentación confidencial están protegidos con altos estándares de seguridad institucional.
                                    </span>
                                </div>

                                <div>
                                    <strong class="d-block text-white mb-1" style="font-size: 0.80rem;">
                                        <i class="bi bi-clock-history text-warning me-1"></i> Disponibilidad 24/7
                                    </strong>
                                    <span class="text-white-50" style="font-size: 0.72rem; line-height: 1.35; display: block;">
                                        Envía solicitudes y verifica el estado de tus expedientes en tiempo real sin límites de horario.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Footer: Contacto para Asistencia (Anclado al fondo con mayor separación) -->
                    <div class="d-flex align-items-center gap-2 border-top border-white border-opacity-25" style="margin-top: 50px !important; padding-top: 12px !important;">
                        <i class="bi bi-telephone-fill text-warning flex-shrink-0" style="font-size: 0.70rem;"></i>
                        <div class="lh-1">
                            <strong class="text-white d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.2px;">Contacto para asistencia</strong>
                            <span class="text-white-50 d-block" style="font-size: 0.60rem; line-height: 1.25;">
                                Tel: (809) 508-2555<br />
                                info@migracion.gob.do
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Formulario de Registro -->
                <div class="col-lg-8 p-4 p-md-5">
                    <div class="mb-4">
                        <h4 class="fw-bold mb-1" style="color: #003876;">Registro de Nuevo Usuario</h4>
                        <p class="text-muted small mb-0">Complete la información requerida para habilitar su acceso a la plataforma.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@mensajeError</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <div>@mensajeExito</div>
                        </div>
                    }

                    <EditForm Model="modelo" OnValidSubmit="ProcesarRegistro">
                        <DataAnnotationsValidator />

                        <!-- Sección: Datos Personales -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">
                            <i class="bi bi-person-vcard me-2" style="color: #003876;"></i> DATOS PERSONALES
                        </h6>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">NOMBRE COMPLETO *</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Nombres y Apellidos completos"
                                       @bind-value="modelo.NombreCompleto"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">DOCUMENTO / PASAPORTE *</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Ej. P0948214"
                                       @bind-value="modelo.NumeroPasaporte"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">TELÉFONO DE CONTACTO *</label>
                                <input type="tel"
                                       class="form-control"
                                       placeholder="Ej. +1 (809) 000-0000"
                                       @bind-value="modelo.Telefono"
                                       required />
                            </div>
                        </div>

                        <!-- Sección: Credenciales -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3 mt-4">
                            <i class="bi bi-key-fill me-2" style="color: #003876;"></i> CREDENCIALES DE ACCESO
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">CORREO ELECTRÓNICO (USUARIO) *</label>
                                <input type="email"
                                       class="form-control"
                                       placeholder="correo@ejemplo.com"
                                       @bind-value="modelo.Email"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">CONTRASEÑA *</label>
                                <input type="password"
                                       class="form-control"
                                       placeholder="Mínimo 6 caracteres"
                                       @bind-value="modelo.Password"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">CONFIRMAR CONTRASEÑA *</label>
                                <input type="password"
                                       class="form-control"
                                       placeholder="Repita su contraseña"
                                       @bind-value="confirmarPassword"
                                       required />
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" @onclick="VolverAlLogin">
                                <i class="bi bi-x-circle me-1"></i> Cancelar y volver
                            </button>
                            <button type="submit" class="btn text-white px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background-color: #003876;" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creando cuenta...</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-check-fill me-1"></i>
                                    <span>Crear Cuenta</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

