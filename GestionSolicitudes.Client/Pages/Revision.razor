 @page "/revision"

@page "/revision/{Id:int}"

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

@layout MainLayout

@inject NavigationManager Navigation

@inject IJSRuntime JS

@inject HttpClient Http

@inject GestionSolicitudes.Client.Services.IdiomaService Idioma

@using GestionSolicitudes.Client.DTOs

@implements IDisposable



<PageTitle>@(Idioma.EsEspanol ? "Módulo de Revisión y Validación Documental | DGM" : "Document Review and Validation Module | DGM")</PageTitle>



@if (cargando)

{

    <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">

        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>

        <h5 class="fw-bold text-dark">@(Idioma.EsEspanol ? "Cargando Expediente Oficial..." : "Loading Official File...")</h5>

        <p class="text-muted small">@(Idioma.EsEspanol ? "Consultando recaudos e información legal en la base de datos." : "Retrieving documents and legal information from the database.")</p>

    </div>

}

else if (expediente == null)

{

    <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center my-5 mx-auto" style="max-width: 600px;">

        <i class="bi bi-file-earmark-x text-danger fs-1 mb-3"></i>

        <h4 class="fw-bold text-dark">@(Idioma.EsEspanol ? "Expediente no encontrado" : "File Not Found")</h4>

        <p class="text-muted small mb-4">@(Idioma.EsEspanol ? "No se localizó el registro solicitado o la lista de expedientes se encuentra vacía." : "The requested record could not be found or the file list is empty.")</p>

        <div>

            <button class="btn text-white rounded-pill px-4 py-2" style="background-color: #003876;" @onclick="IrALista">

                <i class="bi bi-arrow-left me-1"></i> @(Idioma.EsEspanol ? "Volver a Gestión" : "Back to Management")

            </button>

        </div>

    </div>

}

else

{

    <div class="container-fluid py-4 px-3 px-md-4 animate__animated animate__fadeIn" style="max-width: 1400px; margin: 0 auto;">



        <!-- CABECERA LIMPIA -->

        <div class="mb-4 pb-3 border-bottom">

            <h2 class="fw-bold mb-1 text-dark" style="color: #003876 !important;">

                @(Idioma.EsEspanol ? "Revisión y Validación Documental" : "Document Review and Validation")

            </h2>

            <p class="text-muted small mb-0">

                @(Idioma.EsEspanol ? "Inspección de recaudos depositados y resolución legal de expedientes institucionales." : "Inspection of filed documents and legal resolution of institutional records.")

            </p>

        </div>



        @if (!string.IsNullOrWhiteSpace(notificacionAccion))

        {

            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">

                <i class="bi bi-check-circle-fill fs-5 text-success"></i>

                <div>@notificacionAccion</div>

                <button type="button" class="btn-close" @onclick='() => notificacionAccion = ""'></button>

            </div>

        }



        <div class="row g-4">

            <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y DICTAMEN -->

            <div class="col-12 col-lg-5 d-flex flex-column gap-4">

                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white flex-grow-1">

                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">

                        <div>

                            <span class="badge bg-light text-dark border px-2 py-1 mb-1 fw-bold" style="font-size: 0.75rem;">@expediente.Radicado</span>

                            <h4 class="fw-bold mb-0 text-dark">@expediente.NombreTitular</h4>

                            <span class="text-muted small">@expediente.CategoriaResidencia</span>

                        </div>

                        <span class="badge @ObtenerBadgeEstado(expediente.EstadoGeneral) px-3 py-2 rounded-pill fs-6 fw-semibold shadow-xs">

                            @FormatearEstado(expediente.EstadoGeneral)

                        </span>

                    </div>



                    <div class="row g-3 small">

                        <div class="col-6">

                            <span class="text-muted d-block">@(Idioma.EsEspanol ? "No. Pasaporte:" : "Passport No.:")</span>

                            <strong class="text-dark fs-6">@expediente.NumeroPasaporte</strong>

                        </div>

                        <div class="col-6">

                            <span class="text-muted d-block">@(Idioma.EsEspanol ? "Nacionalidad:" : "Nationality:")</span>

                            <strong class="text-dark fs-6">@expediente.Nacionalidad</strong>

                        </div>

                        <div class="col-12">

                            <span class="text-muted d-block">@(Idioma.EsEspanol ? "Correo Registrado:" : "Registered Email:")</span>

                            <strong class="text-dark fs-6">@expediente.Correo</strong>

                        </div>

                        <div class="col-12">

                            <span class="text-muted d-block">@(Idioma.EsEspanol ? "Fecha de Radicación:" : "Submission Date:")</span>

                            <strong class="text-dark fs-6">@expediente.FechaRegistro</strong>

                        </div>

                    </div>

                </div>



                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                    <h5 class="fw-bold text-dark mb-1" style="color: #003876 !important;">

                        @(Idioma.EsEspanol ? "Dictamen Legal" : "Legal Ruling")

                    </h5>

                    <p class="text-muted small mb-3">

                        @(Idioma.EsEspanol ? "Emitir la resolución definitiva una vez auditados todos los documentos." : "Issue the final decision after auditing all submitted records.")

                    </p>



                    <!-- BOTONES DE DICTAMEN DINÁMICOS (SIN RELLENO A MENOS QUE SE SELECCIONEN) -->

                    <div class="d-flex flex-column gap-2">

                        <button class="btn @(EsEstadoAprobado() ? "btn-success shadow-sm fw-bold" : "btn-outline-success fw-semibold") rounded-pill py-2 px-4 w-100"

                                @onclick="AprobarExpedienteCompleto" disabled="@procesandoDictamen">

                            <i class="bi bi-patch-check-fill me-1"></i> @(Idioma.EsEspanol ? "Aprobar Expediente y Emitir Resolución" : "Approve File and Issue Resolution")

                        </button>



                        <button class="btn @(EsEstadoSubsanacion() ? "btn-warning text-dark shadow-sm fw-bold" : "btn-outline-warning text-dark fw-semibold") rounded-pill py-2 px-4 w-100"

                                @onclick="SolicitarSubsanacionGeneral" disabled="@procesandoDictamen">

                            <i class="bi bi-envelope-exclamation-fill me-1"></i> @(Idioma.EsEspanol ? "Notificar Requerimientos al Residente" : "Notify Requirements to Resident")

                        </button>



                        <button class="btn @(EsEstadoRechazado() ? "btn-danger shadow-sm fw-bold" : "btn-outline-danger fw-semibold") rounded-pill py-2 px-4 w-100"

                                @onclick="RechazarExpediente" disabled="@procesandoDictamen">

                            <i class="bi bi-x-circle-fill me-1"></i> @(Idioma.EsEspanol ? "Rechazar Expediente por Incumplimiento" : "Reject File Due to Non-Compliance")

                        </button>

                    </div>

                </div>

            </div>



            <!-- COLUMNA DERECHA: RECAUDOS PRESENTADOS -->

            <div class="col-12 col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">

                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">

                        <h5 class="fw-bold text-dark mb-0" style="color: #003876 !important;">

                            @(Idioma.EsEspanol ? "Recaudos Presentados" : "Submitted Documents")

                        </h5>

                        <span class="text-muted small">

                            @(Idioma.EsEspanol ? "Haga clic en \"Ver\" para abrir el visor integrado" : "Click \"View\" to open the built-in viewer")

                        </span>

                    </div>



                    <div class="d-flex flex-column gap-3">

                        @if (expediente.Documentos.Count == 0)

                        {

                            <div class="text-center py-5 text-muted small">

                                <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>

                                @(Idioma.EsEspanol ? "No se registran documentos adjuntos para este expediente." : "No documents attached to this file.")

                            </div>

                        }

                        else

                        {

                            @foreach (var doc in expediente.Documentos)

                            {

                                <div class="doc-item-row p-3 rounded-4 border d-flex align-items-center justify-content-between bg-light">

                                    <div class="d-flex align-items-center gap-3 text-truncate">

                                        <div class="doc-icon-square @ObtenerClaseIcono(doc.Estado)">

                                            <i class="bi @doc.Icono fs-5"></i>

                                        </div>

                                        <div class="text-truncate">

                                            <strong class="d-block text-dark text-truncate">@doc.TipoDocumento</strong>

                                            <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">@doc.NombreArchivo</small>

                                        </div>

                                    </div>



                                    <div class="d-flex align-items-center gap-3">

                                        <span class="badge @ObtenerBadgeEstado(doc.Estado) px-3 py-1 rounded-pill" style="font-size: 0.75rem;">

                                            @FormatearEstadoDoc(doc.Estado)

                                        </span>

                                        <button class="btn btn-sm btn-primary rounded-pill px-4 py-1 fw-semibold shadow-xs d-flex align-items-center gap-1"

                                                @onclick="() => AbrirModalDocumento(doc)" style="background-color: #003876; border-color: #003876;">

                                            <i class="bi bi-eye"></i> @(Idioma.EsEspanol ? "Ver" : "View")

                                        </button>

                                    </div>

                                </div>

                            }

                        }

                    </div>

                </div>

            </div>

        </div>



        <!-- ========================================================= -->

        <!-- 4. BARRA DE NAVEGACIÓN UBICADA AL FINAL DE LA VISTA       -->

        <!-- ========================================================= -->

        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mt-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <button class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold"

                        @onclick="IrExpedienteAnterior" disabled="@(!TieneAnterior())">

                    <i class="bi bi-arrow-left me-1"></i> @(Idioma.EsEspanol ? "Anterior" : "Previous")

                </button>



                <div class="d-flex align-items-center gap-2">

                    <select class="form-select form-select-sm rounded-pill px-3 border" @onchange="SeleccionarExpedientePorSelect">

                        @for (int i = 0; i < listaExpedientes.Count; i++)

                        {

                            var item = listaExpedientes[i];

                            <option value="@item.Id" selected="@(i == indiceActual)">

                                @item.NumeroExpediente - @item.NombreCompleto

                            </option>

                        }

                    </select>

                </div>



                <div class="d-flex align-items-center gap-2">

                    <button class="btn text-white rounded-pill px-4 py-2 fw-semibold shadow-sm"

                            style="background-color: #003876;"

                            @onclick="IrExpedienteSiguiente" disabled="@(!TieneSiguiente())">

                        @(Idioma.EsEspanol ? "Siguiente" : "Next") <i class="bi bi-arrow-right ms-1"></i>

                    </button>

                    <button class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold"

                            @onclick="IrALista">

                        <i class="bi bi-list-ul me-1"></i> @(Idioma.EsEspanol ? "Lista" : "List")

                    </button>

                </div>

            </div>

        </div>

    </div>



    <!-- MODAL VISOR INTEGRADO DE RECAUDOS -->

    @if (mostrarModalDoc && docSeleccionado != null)

    {

        <div class="modal-backdrop-custom fade show"></div>

        <div class="modal fade show d-block" tabindex="-1" role="dialog">

            <div class="modal-dialog modal-dialog-centered modal-xl" role="document">

                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">

                    <div class="modal-header bg-light border-bottom px-4 py-3">

                        <div class="d-flex align-items-center gap-2 text-truncate">

                            <i class="bi @(docSeleccionado.EsImagen ? "bi-image" : "bi-file-earmark-pdf-fill text-danger") fs-5"></i>

                            <h5 class="modal-title fw-bold text-dark mb-0 text-truncate" style="font-size: 1rem;">@docSeleccionado.TipoDocumento - @docSeleccionado.NombreArchivo</h5>

                        </div>

                        <button type="button" class="btn-close" @onclick="CerrarModalDoc"></button>

                    </div>



                    <div class="modal-body p-3 bg-dark bg-opacity-10 text-center" style="min-height: 520px; max-height: 75vh; overflow-y: auto;">

                        @if (!string.IsNullOrEmpty(docSeleccionado.UrlPreview))

                        {

                            @if (docSeleccionado.EsImagen)

                            {

                                <img src="@docSeleccionado.UrlPreview" alt="Documento" class="img-fluid rounded-3 shadow border bg-white" style="max-height: 68vh; object-fit: contain;" />

                            }

                            else

                            {

                                <iframe src="@docSeleccionado.UrlPreview" class="w-100 rounded-3 shadow-sm border bg-white" style="height: 68vh; min-height: 500px;" frameborder="0"></iframe>

                            }

                        }

                        else

                        {

                            <div class="text-muted py-5">

                                <i class="bi bi-file-earmark-x fs-1"></i>

                                <p class="small mt-2">@(Idioma.EsEspanol ? "No hay archivo adjunto para previsualizar." : "No attached file to preview.")</p>

                            </div>

                        }

                    </div>



                    <div class="modal-footer px-4 py-3 bg-white border-top d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">

                        <div>

                            <span class="small text-muted d-block">@(Idioma.EsEspanol ? "Estatus del Recaudo:" : "Document Status:")</span>

                            <span class="badge @ObtenerBadgeEstado(docSeleccionado.Estado) px-3 py-1 rounded-pill">

                                @FormatearEstadoDoc(docSeleccionado.Estado)

                            </span>

                        </div>



                        <div class="d-flex flex-wrap gap-2">

                            @if (!string.IsNullOrEmpty(docSeleccionado.UrlPreview))

                            {

                                <a href="@docSeleccionado.UrlPreview" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">

                                    <i class="bi bi-box-arrow-up-right me-1"></i> @(Idioma.EsEspanol ? "Abrir Pestaña" : "Open Tab")

                                </a>

                                <a href="@docSeleccionado.UrlPreview" download="@docSeleccionado.NombreArchivo" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">

                                    <i class="bi bi-download me-1"></i> @(Idioma.EsEspanol ? "Descargar" : "Download")

                                </a>

                            }

                            <button class="btn btn-sm btn-success rounded-pill px-3 fw-semibold" @onclick="AprobarDocumentoActual">

                                <i class="bi bi-check2-circle me-1"></i> @(Idioma.EsEspanol ? "Aprobar" : "Approve")

                            </button>

                            <button class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold" @onclick="PedirNuevaFoto">

                                <i class="bi bi-camera-fill me-1"></i> @(Idioma.EsEspanol ? "Solicitar Reemplazo" : "Request Replacement")

                            </button>

                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" @onclick="MarcarNoVigente">

                                <i class="bi bi-calendar-x me-1"></i> @(Idioma.EsEspanol ? "No Vigente" : "Invalid")

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    }

}



<style>

    .doc-item-row {

        transition: all 0.2s ease;

    }



        .doc-item-row:hover {

            background-color: #f1f5f9 !important;

            border-color: #003876 !important;

        }



    .doc-icon-square {

        width: 42px;

        height: 42px;

        min-width: 42px;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

    }



    .icon-pending {

        background-color: #fef3c7;

        color: #d97706;

    }



    .icon-approved {

        background-color: #dcfce7;

        color: #15803d;

    }



    .icon-rejected {

        background-color: #fee2e2;

        color: #b91c1c;

    }



    .icon-warning {

        background-color: #ffedd5;

        color: #c2410c;

    }



    .modal-backdrop-custom {

        position: fixed;

        top: 0;

        left: 0;

        width: 100vw;

        height: 100vh;

        background-color: rgba(0, 0, 0, 0.55);

        z-index: 1050;

    }

</style>



@code {

    [Parameter] public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "filtro")] public string? FiltroEstado { get; set; }



    private bool cargando = true;

    private bool procesandoDictamen = false;

    private bool mostrarModalDoc = false;

    private string notificacionAccion = string.Empty;



    private ExpedienteRevisionDto? expediente;

    private DocumentoItemDto? docSeleccionado;

    private List<SolicitudItemDtoExtendido> listaExpedientes = new();

    private int indiceActual = 0;



    protected override void OnInitialized()

    {

        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;

    }



    private void RefrescarPorIdioma()

    {

        InvokeAsync(StateHasChanged);

    }



    protected override async Task OnParametersSetAsync()

    {

        await CargarListaYNavegar();

    }



    private async Task CargarListaYNavegar()

    {

        cargando = true;

        try

        {

            var res = await Http.GetFromJsonAsync<List<SolicitudItemDtoExtendido>>("api/solicitud/filtradas");

            listaExpedientes = res ?? new();



            if (!string.IsNullOrWhiteSpace(FiltroEstado))

            {

                listaExpedientes = listaExpedientes

                    .Where(e => e.Estado.Equals(FiltroEstado, StringComparison.OrdinalIgnoreCase))

                    .ToList();

            }



            int idObjetivo = Id ?? (listaExpedientes.FirstOrDefault()?.Id ?? 0);

            if (idObjetivo > 0)

            {

                await CargarExpedientePorId(idObjetivo);

            }

            else

            {

                expediente = null;

            }

        }

        catch

        {

            expediente = null;

        }

        finally

        {

            cargando = false;

        }

    }



    private async Task CargarExpedientePorId(int expedienteId)

    {

        try

        {

            indiceActual = listaExpedientes.FindIndex(e => e.Id == expedienteId);

            if (indiceActual < 0) indiceActual = 0;



            var itemLista = listaExpedientes.FirstOrDefault(e => e.Id == expedienteId);

            var sol = await Http.GetFromJsonAsync<SolicitudDtoModel>($"api/solicitud/{expedienteId}");



            if (sol != null)

            {

                string pasaporteReal = !string.IsNullOrWhiteSpace(sol.NumeroPasaporte)

                    ? sol.NumeroPasaporte

                    : (!string.IsNullOrWhiteSpace(itemLista?.NumeroPasaporte) ? itemLista.NumeroPasaporte : (Idioma.EsEspanol ? "En trámite" : "In process"));



                string nacionalidadReal = !string.IsNullOrWhiteSpace(sol.Nacionalidad)

                    ? sol.Nacionalidad

                    : (!string.IsNullOrWhiteSpace(sol.PaisOrigen) ? sol.PaisOrigen : (Idioma.EsEspanol ? "Registrada" : "Registered"));



                string correoReal = !string.IsNullOrWhiteSpace(sol.Correo)

                    ? sol.Correo

                    : (!string.IsNullOrWhiteSpace(sol.Email) ? sol.Email : (!string.IsNullOrWhiteSpace(itemLista?.Email) ? itemLista.Email : (Idioma.EsEspanol ? "Sin registrar" : "Unregistered")));



                expediente = new ExpedienteRevisionDto

                {

                    Id = sol.Id,

                    Radicado = !string.IsNullOrWhiteSpace(sol.Codigo) ? sol.Codigo : (!string.IsNullOrWhiteSpace(sol.NumeroExpediente) ? sol.NumeroExpediente : $"EXP-{sol.FechaCreacion.Year}-{sol.Id:D4}"),

                    NombreTitular = !string.IsNullOrWhiteSpace(sol.Solicitante) ? sol.Solicitante : (itemLista?.NombreCompleto ?? (Idioma.EsEspanol ? "Residente" : "Resident")),

                    CategoriaResidencia = !string.IsNullOrWhiteSpace(sol.Titulo) ? sol.Titulo : (itemLista?.TipoTramite ?? (Idioma.EsEspanol ? "Residencia Temporal" : "Temporary Residence")),

                    NumeroPasaporte = pasaporteReal,

                    Nacionalidad = nacionalidadReal,

                    Correo = correoReal,

                    FechaRegistro = sol.FechaCreacion.ToString("dd/MM/yyyy HH:mm"),

                    EstadoGeneral = sol.Estado?.ToString() ?? "Pendiente"

                };



                try

                {

                    var docs = await Http.GetFromJsonAsync<List<DocumentoApiModel>>($"api/solicitud/{expedienteId}/documentos");

                    if (docs != null)

                    {

                        expediente.Documentos = docs.Select(d => new DocumentoItemDto

                        {

                            Id = d.Id,

                            TipoDocumento = d.Nombre,

                            NombreArchivo = Path.GetFileName(d.UrlDescarga),

                            Estado = d.Estado,

                            EsImagen = d.Icono.Contains("image") || d.UrlDescarga.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || d.UrlDescarga.EndsWith(".png", StringComparison.OrdinalIgnoreCase),

                            Icono = d.Icono,

                            UrlPreview = d.UrlDescarga

                        }).ToList();

                    }

                }

                catch { }

            }

        }

        catch

        {

            expediente = null;

        }

    }



    private bool TieneAnterior() => indiceActual > 0;

    private bool TieneSiguiente() => indiceActual >= 0 && indiceActual < listaExpedientes.Count - 1;



    private void IrExpedienteAnterior()

    {

        if (TieneAnterior())

        {

            Navigation.NavigateTo($"/revision/{listaExpedientes[indiceActual - 1].Id}");

        }

    }



    private void IrExpedienteSiguiente()

    {

        if (TieneSiguiente())

        {

            Navigation.NavigateTo($"/revision/{listaExpedientes[indiceActual + 1].Id}");

        }

    }



    private void SeleccionarExpedientePorSelect(ChangeEventArgs e)

    {

        if (int.TryParse(e.Value?.ToString(), out int id))

        {

            Navigation.NavigateTo($"/revision/{id}");

        }

    }



    private void IrALista()

    {

        Navigation.NavigateTo("/solicitudes");

    }



    private void AbrirModalDocumento(DocumentoItemDto doc)

    {

        docSeleccionado = doc;

        mostrarModalDoc = true;

    }



    private void CerrarModalDoc()

    {

        mostrarModalDoc = false;

        docSeleccionado = null;

    }



    private async Task AprobarDocumentoActual()

    {

        if (docSeleccionado != null)

        {

            await CambiarEstadoDocApi(docSeleccionado.Id, "Aprobado");

            docSeleccionado.Estado = "Aprobado";

            notificacionAccion = Idioma.EsEspanol

                ? $"Documento '{docSeleccionado.TipoDocumento}' validado y aprobado legalmente."

                : $"Document '{docSeleccionado.TipoDocumento}' officially validated and approved.";

        }

    }



    private async Task PedirNuevaFoto()

    {

        if (docSeleccionado != null)

        {

            await CambiarEstadoDocApi(docSeleccionado.Id, "EnRevision");

            docSeleccionado.Estado = "En Revisión";

            notificacionAccion = Idioma.EsEspanol

                ? $"Se ha generado requerimiento de reemplazo para '{docSeleccionado.TipoDocumento}'."

                : $"Replacement requirement generated for '{docSeleccionado.TipoDocumento}'.";

        }

    }



    private async Task MarcarNoVigente()

    {

        if (docSeleccionado != null)

        {

            await CambiarEstadoDocApi(docSeleccionado.Id, "Rechazado");

            docSeleccionado.Estado = "Rechazado";

            notificacionAccion = Idioma.EsEspanol

                ? $"Documento '{docSeleccionado.TipoDocumento}' marcado como no vigente/rechazado."

                : $"Document '{docSeleccionado.TipoDocumento}' marked as invalid/rejected.";

        }

    }



