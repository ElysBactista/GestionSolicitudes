    private bool EsEstadoAprobado() => expediente != null && (expediente.EstadoGeneral == "3" || expediente.EstadoGeneral.Equals("Aprobada", StringComparison.OrdinalIgnoreCase) || expediente.EstadoGeneral.Equals("Aprobado", StringComparison.OrdinalIgnoreCase));

    private bool EsEstadoSubsanacion() => expediente != null && (expediente.EstadoGeneral == "6" || expediente.EstadoGeneral.Equals("RequiereCorreccion", StringComparison.OrdinalIgnoreCase));

    private bool EsEstadoRechazado() => expediente != null && (expediente.EstadoGeneral == "4" || expediente.EstadoGeneral.Equals("Rechazada", StringComparison.OrdinalIgnoreCase) || expediente.EstadoGeneral.Equals("Rechazado", StringComparison.OrdinalIgnoreCase));



    private async Task AprobarExpedienteCompleto()

    {

        if (expediente == null) return;

        procesandoDictamen = true;

        try

        {

            var nombreAdmin = await JS.InvokeAsync<string>("localStorage.getItem", "nombreUsuario") ?? "Administrador DGM";

            await JS.InvokeVoidAsync("localStorage.setItem", "ultimoAdminRevisor", nombreAdmin);



            var res = await Http.PatchAsJsonAsync($"api/solicitud/{expediente.Id}/estado", new { nuevoEstado = 3 });

            if (res.IsSuccessStatusCode)

            {

                expediente.EstadoGeneral = "Aprobada";

                notificacionAccion = Idioma.EsEspanol

                    ? $"Expediente {expediente.Radicado} APROBADO por {nombreAdmin}."

                    : $"File {expediente.Radicado} APPROVED by {nombreAdmin}.";

            }

        }

        catch { }

        finally { procesandoDictamen = false; }

    }



    private async Task SolicitarSubsanacionGeneral()

    {

        if (expediente == null) return;

        procesandoDictamen = true;

        try

        {

            var res = await Http.PatchAsJsonAsync($"api/solicitud/{expediente.Id}/estado", new { nuevoEstado = 6 });

            if (res.IsSuccessStatusCode)

            {

                expediente.EstadoGeneral = "RequiereCorreccion";

                notificacionAccion = Idioma.EsEspanol

                    ? "Se ha notificado al solicitante que el expediente REQUIERE CORRECCIÓN."

                    : "The applicant has been notified that the file REQUIRES CORRECTION.";

            }

        }

        catch { }

        finally { procesandoDictamen = false; }

    }



    private async Task RechazarExpediente()

    {

        if (expediente == null) return;

        procesandoDictamen = true;

        try

        {

            var res = await Http.PatchAsJsonAsync($"api/solicitud/{expediente.Id}/estado", new { nuevoEstado = 4 });

            if (res.IsSuccessStatusCode)

            {

                expediente.EstadoGeneral = "Rechazada";

                notificacionAccion = Idioma.EsEspanol

                    ? "Expediente dictaminado como RECHAZADO."

                    : "File officially resolved as REJECTED.";

            }

        }

        catch { }

        finally { procesandoDictamen = false; }

    }



    private string FormatearEstado(string estado)

    {

        bool esEs = Idioma.EsEspanol;

        return estado switch

        {

            "1" or "Pendiente" => esEs ? "Pendiente" : "Pending",

            "2" or "EnProceso" or "En Proceso" => esEs ? "En Proceso" : "In Process",

            "3" or "Aprobada" or "Aprobado" => esEs ? "Aprobada" : "Approved",

            "4" or "Rechazada" or "Rechazado" => esEs ? "Rechazada" : "Rejected",

            "5" or "Cancelada" or "Cancelado" => esEs ? "Cancelada" : "Cancelled",

            "6" or "RequiereCorreccion" => esEs ? "Requiere Corrección" : "Requires Correction",

            _ => estado

        };

    }



    private string FormatearEstadoDoc(string estado)

    {

        bool esEs = Idioma.EsEspanol;

        return estado switch

        {

            "Aprobado" or "Aprobada" => esEs ? "Aprobado" : "Approved",

            "Rechazado" or "Rechazada" => esEs ? "Rechazado" : "Rejected",

            "EnRevision" or "En Revisión" => esEs ? "En Revisión" : "Under Review",

            _ => esEs ? "Pendiente" : "Pending"

        };

    }



    private string ObtenerBadgeEstado(string estado) => estado switch

    {

        "3" or "Aprobada" or "Aprobado" => "bg-success text-white",

        "2" or "EnProceso" or "En Proceso" or "En Revisión" => "bg-primary text-white",

        "6" or "RequiereCorreccion" or "Requiere Corrección" or "Subsanación Requerida" or "Requiere Subsanación" => "bg-warning text-dark",

        "4" or "Rechazada" or "Rechazado" or "No Vigente" => "bg-danger text-white",

        _ => "bg-secondary text-white"

    };



    private string ObtenerClaseIcono(string estado) => estado switch

    {

        "Aprobado" or "Aprobada" => "icon-approved",

        "Requiere Corrección" or "Requiere Subsanación" or "En Revisión" => "icon-warning",

        "Rechazado" or "Rechazada" or "No Vigente" => "icon-rejected",

        _ => "icon-pending"

    };



