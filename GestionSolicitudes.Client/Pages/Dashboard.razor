    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestaurarEstadoDesdeStorage();
            await CargarDatosDashboard();
        }
    }

    private void ToggleCalendario(string tipo)
    {
        if (calendarioAbierto == tipo)
        {
            calendarioAbierto = string.Empty;
        }
        else
        {
            calendarioAbierto = tipo;
            mesVistaCalendario = tipo == "desde" ? fechaInicio : fechaFin;
        }
    }

    private async Task GuardarEstadoEnStorage()
    {
        try
        {
            var estado = new EstadoPersistenciaDashboard
            {
                FiltroFechaAplicado = filtroFechaAplicado,
                FechaInicio = fechaInicio,
                FechaFin = fechaFin,
                TxtFechaInicio = txtFechaInicio,
                TxtFechaFin = txtFechaFin,
                FiltroEstado = filtroEstado,
                FiltroTipoTramite = filtroTipoTramite
            };

            var json = JsonSerializer.Serialize(estado);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "dashboard_filtros", json);
        }
        catch { }
    }

    private async Task RestaurarEstadoDesdeStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("sessionStorage.getItem", "dashboard_filtros");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var estado = JsonSerializer.Deserialize<EstadoPersistenciaDashboard>(json);
                if (estado != null)
                {
                    filtroFechaAplicado = estado.FiltroFechaAplicado;
                    fechaInicio = estado.FechaInicio;
                    fechaFin = estado.FechaFin;
                    txtFechaInicio = string.IsNullOrWhiteSpace(estado.TxtFechaInicio) ? fechaInicio.ToString("dd/MM/yyyy") : estado.TxtFechaInicio;
                    txtFechaFin = string.IsNullOrWhiteSpace(estado.TxtFechaFin) ? fechaFin.ToString("dd/MM/yyyy") : estado.TxtFechaFin;
                    filtroEstado = estado.FiltroEstado;
                    filtroTipoTramite = estado.FiltroTipoTramite;
                    mesVistaCalendario = fechaFin;
                }
            }
        }
        catch { }
    }

    private bool FiltrosActivos() =>
        filtroFechaAplicado ||
        !string.IsNullOrEmpty(filtroEstado) ||
        !string.IsNullOrEmpty(filtroTipoTramite);

    private string ObtenerNombreMes(int mes)
    {
        return new DateTime(2026, mes, 1).ToString("MMMM", new System.Globalization.CultureInfo("es-ES")).ToUpper();
    }

    private void ActualizarFechaEscrita(bool esInicio, string? valor)
    {
        if (esInicio)
        {
            txtFechaInicio = valor ?? string.Empty;
            if (DateTime.TryParseExact(txtFechaInicio, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime f))
            {
                fechaInicio = f;
                mesVistaCalendario = f;
                filtroFechaAplicado = true;
            }
        }
        else
        {
            txtFechaFin = valor ?? string.Empty;
            if (DateTime.TryParseExact(txtFechaFin, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime f))
            {
                fechaFin = f;
                mesVistaCalendario = f;
                filtroFechaAplicado = true;
            }
        }
    }

    private void CambiarMesMiniCal(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoMes))
        {
            mesVistaCalendario = new DateTime(mesVistaCalendario.Year, nuevoMes, 1);
            ActualizarFechaSegunVista();
        }
    }

    private void CambiarAnioMiniCal(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoAnio))
        {
            mesVistaCalendario = new DateTime(nuevoAnio, mesVistaCalendario.Month, 1);
            ActualizarFechaSegunVista();
        }
    }

    private void AvanzarRetrocederMesManual(int meses)
    {
        mesVistaCalendario = mesVistaCalendario.AddMonths(meses);
        ActualizarFechaSegunVista();
    }

    private void ActualizarFechaSegunVista()
    {
        if (calendarioAbierto == "desde")
        {
            int diasEnMes = DateTime.DaysInMonth(mesVistaCalendario.Year, mesVistaCalendario.Month);
            int diaAjustado = Math.Min(fechaInicio.Day, diasEnMes);
            fechaInicio = new DateTime(mesVistaCalendario.Year, mesVistaCalendario.Month, diaAjustado);
            txtFechaInicio = fechaInicio.ToString("dd/MM/yyyy");
            filtroFechaAplicado = true;
        }
        else if (calendarioAbierto == "hasta")
        {
            int diasEnMes = DateTime.DaysInMonth(mesVistaCalendario.Year, mesVistaCalendario.Month);
            int diaAjustado = Math.Min(fechaFin.Day, diasEnMes);
            fechaFin = new DateTime(mesVistaCalendario.Year, mesVistaCalendario.Month, diaAjustado);
            txtFechaFin = fechaFin.ToString("dd/MM/yyyy");
            filtroFechaAplicado = true;
        }
    }

    private async Task AplicarPreset(int opcion)
    {
        var hoy = DateTime.Today;
        switch (opcion)
        {
            case 1: // Hoy
                fechaInicio = hoy; fechaFin = hoy; break;
            case 2: // Ayer
                fechaInicio = hoy.AddDays(-1); fechaFin = hoy.AddDays(-1); break;
            case 7: // Esta Semana
                fechaInicio = hoy.AddDays(-(int)hoy.DayOfWeek); fechaFin = hoy; break;
            case 30: // Este Mes
                fechaInicio = new DateTime(hoy.Year, hoy.Month, 1); fechaFin = hoy; break;
            case 365: // Este Año
                fechaInicio = new DateTime(hoy.Year, 1, 1); fechaFin = hoy; break;
        }
        filtroFechaAplicado = true;
        txtFechaInicio = fechaInicio.ToString("dd/MM/yyyy");
        txtFechaFin = fechaFin.ToString("dd/MM/yyyy");
        mesVistaCalendario = fechaFin;
        calendarioAbierto = string.Empty;

        await GuardarEstadoEnStorage();
    }

    private void SeleccionarDia(DateTime fecha)
    {
        if (calendarioAbierto == "desde")
        {
            fechaInicio = fecha;
            if (fechaInicio > fechaFin)
                fechaFin = fechaInicio;

            txtFechaInicio = fechaInicio.ToString("dd/MM/yyyy");
            txtFechaFin = fechaFin.ToString("dd/MM/yyyy");
            calendarioAbierto = string.Empty;
        }
        else if (calendarioAbierto == "hasta")
        {
            if (fecha < fechaInicio)
                fechaInicio = fecha;

            fechaFin = fecha;
            txtFechaInicio = fechaInicio.ToString("dd/MM/yyyy");
            txtFechaFin = fechaFin.ToString("dd/MM/yyyy");
            calendarioAbierto = string.Empty;
        }
        filtroFechaAplicado = true;
    }

    private RenderFragment RenderizarMiniDia(DateTime fecha, int d) => builder =>
    {
        bool esSeleccionado = (calendarioAbierto == "desde" && fecha.Date == fechaInicio.Date) ||
                              (calendarioAbierto == "hasta" && fecha.Date == fechaFin.Date);
        bool enRango = fecha.Date >= fechaInicio.Date && fecha.Date <= fechaFin.Date;

        string circuloEstilo = "width: 24px; height: 24px; border-radius: 50%; font-size: 0.70rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.15s;";

        if (esSeleccionado)
            circuloEstilo += " background-color: #003876; color: #ffffff !important; font-weight: 700;";
        else if (enRango)
            circuloEstilo += " background-color: #e0f2fe; color: #003876 !important; font-weight: 600;";
        else
            circuloEstilo += " color: #000000;";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "d-flex align-items-center justify-content-center dia-mini");
        builder.AddAttribute(2, "style", "height: 26px;");
        builder.AddAttribute(3, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SeleccionarDia(fecha)));

        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", "dia-circle");
        builder.AddAttribute(6, "style", circuloEstilo);
        builder.AddContent(7, d);
        builder.CloseElement();

        builder.CloseElement();
    };

    private async Task AplicarFiltrosYConsultar()
    {
        if (DateTime.TryParseExact(txtFechaInicio, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime fIni))
        {
            fechaInicio = fIni;
        }

        if (DateTime.TryParseExact(txtFechaFin, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime fFin))
        {
            fechaFin = fFin;
        }

        filtroFechaAplicado = true;
        mostrarPanelFiltros = false;
        calendarioAbierto = string.Empty;
        await GuardarEstadoEnStorage();
        await CargarDatosDashboard();
    }

