@page "/dashboard"
@page "/home"
@using System.Text.Json
@using GestionSolicitudes.Client.Layout
@inject HttpClient Http
@inject IJSRuntime JS
@inject GestionSolicitudes.Client.Services.ExpedienteStateService StateService
<PageTitle>HOME - DGM</PageTitle>

<div class="portal-externo-container w-100" style="background-color: #f8fafc; font-family: 'Poppins', sans-serif;">

    <div class="container-fluid px-2 px-md-3 py-2">

        <!-- ========================================================= -->
        <!-- 1. ENCABEZADO CON COMPONENTE DE FILTRO REUTILIZABLE       -->
        <!-- ========================================================= -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h4 class="fw-bold mb-1" style="color: #003876;">Panel de Control Institucional</h4>
                <p class="small mb-0 text-dark">Resumen operativo y métricas estadísticas de trámites migratorios</p>
            </div>

            <!-- COMPONENTE REUTILIZABLE DE FILTROS -->
            <FiltroAvanzadoPanel FiltroFechaAplicado="filtroFechaAplicado"
                                 FechaInicio="fechaInicio"
                                 FechaFin="fechaFin"
                                 FiltroEstado="filtroEstado"
                                 FiltroTipoTramite="filtroTipoTramite"
                                 OnAplicarFiltros="ManejarAplicarFiltros"
                                 OnLimpiar="ManejarLimpiarFiltros" />
        </div>

        <!-- ========================================================= -->
        <!-- 2. TARJETAS KPI HORIZONTALES (ESTADOS OPERATIVOS)         -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #003876 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #003876;">@totalSolicitudes</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(0, 56, 118, 0.08); color: #003876;">
                            <i class="bi bi-folder2 fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #f59e0b !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Pendientes</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #b45309;">@totalPendientes</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #fef3c7; color: #d97706;">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #0284c7 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">En Proceso</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #0369a1;">@totalEnProceso</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #e0f2fe; color: #0284c7;">
                            <i class="bi bi-hourglass-split fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #10b981 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Aprobadas</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #047857;">@totalAprobadas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #d1fae5; color: #059669;">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #EE2A24 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Rechazadas</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #b91c1c;">@totalRechazadas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #fee2e2; color: #dc2626;">
                            <i class="bi bi-x-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #64748b !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Canceladas</span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #475569;">@totalCanceladas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #f1f5f9; color: #64748b;">
                            <i class="bi bi-slash-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- 3. TARJETAS DE INVENTARIO POR CATEGORÍA (EFECTO CRISTAL)  -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-4 mt-2">
            <!-- Residencia de Estudiante -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card rounded-3 shadow-xs px-3 py-2 h-100 text-center" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.18) 0%, rgba(59, 130, 246, 0.04) 100%); border: 1px solid rgba(59, 130, 246, 0.4) !important;">
                    <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.68rem; letter-spacing: 0.5px;">Residencia de Estudiante</span>
                    <h3 class="fw-bold mb-0 mt-1" style="color: #1d4ed8;">@totalEstudiante</h3>
                </div>
            </div>

            <!-- Residencia de Trabajo -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card rounded-3 shadow-xs px-3 py-2 h-100 text-center" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(16, 185, 129, 0.04) 100%); border: 1px solid rgba(16, 185, 129, 0.4) !important;">
                    <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.68rem; letter-spacing: 0.5px;">Residencia de Trabajo</span>
                    <h3 class="fw-bold mb-0 mt-1" style="color: #047857;">@totalTrabajo</h3>
                </div>
            </div>

            <!-- Residencia por Familia -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card rounded-3 shadow-xs px-3 py-2 h-100 text-center" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.18) 0%, rgba(168, 85, 247, 0.04) 100%); border: 1px solid rgba(168, 85, 247, 0.4) !important;">
                    <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.68rem; letter-spacing: 0.5px;">Residencia por Familia</span>
                    <h3 class="fw-bold mb-0 mt-1" style="color: #7e22ce;">@totalFamilia</h3>
                </div>
            </div>

            <!-- Residencia de Menores -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card rounded-3 shadow-xs px-3 py-2 h-100 text-center" style="background: linear-gradient(135deg, rgba(234, 179, 8, 0.18) 0%, rgba(234, 179, 8, 0.04) 100%); border: 1px solid rgba(234, 179, 8, 0.4) !important;">
                    <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.68rem; letter-spacing: 0.5px;">Residencia de Menores</span>
                    <h3 class="fw-bold mb-0 mt-1" style="color: #b45309;">@totalMenores</h3>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- 4. FILA 1 DE GRÁFICAS (VOLUMEN Y DISTRIBUCIÓN POR ESTADO) -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">Volumen Operativo por Estado</h6>
                        <small class="text-dark">Distribución cuantitativa de expedientes</small>
                    </div>
                    <div class="card-body px-4 pb-3 pt-2">
                        <ApexChart @ref="miGrafico" TItem="DatoGrafico" Options="opcionesGraficoBarras">
                            <ApexPointSeries TItem="DatoGrafico"
                                             Items="datosDelGrafico"
                                             Name="Cantidad"
                                             SeriesType="SeriesType.Bar"
                                             XValue="@(e => e.Estado)"
                                             YValue="@(e => e.Cantidad)"
                                             PointColor="@(e => ObtenerColorCristal(e.Estado))" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">Distribución Porcentual</h6>
                        <small class="text-dark">Proporción relativa de trámites</small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2 text-center">
                        <ApexChart @ref="miGraficoCircular" TItem="DatoGrafico" Options="opcionesGraficoCircular">
                            <ApexPointSeries TItem="DatoGrafico"
                                             Items="datosDelGrafico"
                                             Name="Solicitudes"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(e => e.Estado)"
                                             YValue="@(e => e.Cantidad)"
                                             PointColor="@(e => ObtenerColorCristal(e.Estado))" />
                        </ApexChart>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- 5. FILA 2 DE GRÁFICAS (INVENTARIO POR CATEGORÍA Y FRECUENTES)-->
        <!-- ========================================================= -->
        <div class="row g-3 mb-4">
            <!-- Gráfica de Categorías Oficiales -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0" style="color: #003876;">Inventario por Categoría Oficial</h6>
                            <small class="text-dark">Volumen según modalidad de residencia</small>
                        </div>
                        <i class="bi bi-pie-chart fs-5" style="color: #003876;"></i>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2 text-center">
                        <ApexChart @ref="miGraficoCategorias" TItem="DatoGrafico" Options="opcionesGraficoCategorias">
                            <ApexPointSeries TItem="DatoGrafico"
                                             Items="datosCategorias"
                                             Name="Expedientes"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(e => e.Estado)"
                                             YValue="@(e => e.Cantidad)"
                                             PointColor="@(e => ObtenerColorCristalCategoria(e.Estado))" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <!-- Trámites más Frecuentes -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0" style="color: #003876;">Trámites más Frecuentes</h6>
                            <small class="text-dark">Demanda por tipo de servicio migratorio</small>
                        </div>
                        <i class="bi bi-bar-chart-steps fs-5" style="color: #003876;"></i>
                    </div>
                    <div class="card-body px-4 pb-3 pt-2">
                        <ApexChart @ref="miGraficoTipos" TItem="DatoGrafico" Options="opcionesGraficoTipos">
                            <ApexPointSeries TItem="DatoGrafico"
                                             Items="datosCategorias"
                                             Name="Solicitudes"
                                             SeriesType="SeriesType.Bar"
                                             XValue="@(e => e.Estado)"
                                             YValue="@(e => e.Cantidad)"
                                             PointColor="@(e => ObtenerColorCristalCategoria(e.Estado))" />
                        </ApexChart>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- 6. FILA 3 DE GRÁFICAS (EVOLUCIÓN DE REGISTRO / TENDENCIA)   -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-3 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0" style="color: #003876;">Evolución de Registro</h6>
                            <small class="text-dark">Ingreso cronológico de solicitudes</small>
                        </div>
                        <i class="bi bi-graph-up-arrow fs-5" style="color: #003876;"></i>
                    </div>
                    <div class="card-body px-4 pb-3 pt-2">
                        <ApexChart @ref="miGraficoTendencia" TItem="DatoGrafico" Options="opcionesGraficoTendencia">
                            <ApexPointSeries TItem="DatoGrafico"
                                             Items="datosTendencia"
                                             Name="Solicitudes"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Estado)"
                                             YValue="@(e => e.Cantidad)" />
                        </ApexChart>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    public class EstadisticaItemDto
    {
        public string Etiqueta { get; set; } = string.Empty;
        public int Cantidad { get; set; }
    }

    public class DashboardDto
    {
        public int TotalSolicitudes { get; set; }
        public int Aprobadas { get; set; }
        public int EnProceso { get; set; }
        public int Pendientes { get; set; }
        public int Canceladas { get; set; }
        public int Rechazadas { get; set; }
        public List<EstadisticaItemDto> PorTipoTramite { get; set; } = new();
        public List<EstadisticaItemDto> TendenciaMensual { get; set; } = new();
    }

    public class DatoGrafico
    {
        public string? Estado { get; set; }
        public int Cantidad { get; set; }
    }

    private ApexChart<DatoGrafico>? miGrafico;
    private ApexChart<DatoGrafico>? miGraficoCircular;
    private ApexChart<DatoGrafico>? miGraficoCategorias;
    private ApexChart<DatoGrafico>? miGraficoTipos;
    private ApexChart<DatoGrafico>? miGraficoTendencia;

    private ApexChartOptions<DatoGrafico> opcionesGraficoBarras = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoCircular = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoCategorias = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTipos = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTendencia = new();

    private List<DatoGrafico> datosDelGrafico = new();
    private List<DatoGrafico> datosCategorias = new();
    private List<DatoGrafico> datosPorTipo = new();
    private List<DatoGrafico> datosTendencia = new();

    private bool filtroFechaAplicado = false;
    private DateTime fechaInicio = DateTime.Today;
    private DateTime fechaFin = DateTime.Today;
    private string filtroEstado = string.Empty;
    private string filtroTipoTramite = string.Empty;

    private int totalSolicitudes = 0;
    private int totalPendientes = 0;
    private int totalEnProceso = 0;
    private int totalAprobadas = 0;
    private int totalRechazadas = 0;
    private int totalCanceladas = 0;

    private int totalEstudiante = 0;
    private int totalTrabajo = 0;
    private int totalFamilia = 0;
    private int totalMenores = 0;

    protected override void OnInitialized()
    {
        opcionesGraficoBarras.Chart = new Chart { Height = 280, Toolbar = new Toolbar { Show = false } };
        opcionesGraficoBarras.PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                BorderRadius = 6,
                ColumnWidth = "42%"
            }
        };

        opcionesGraficoCircular = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 300, Toolbar = new Toolbar { Show = false } },
            Legend = new Legend { Position = LegendPosition.Bottom, HorizontalAlign = Align.Center, FontSize = "12px" },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    CustomScale = 1.0,
                    Donut = new PlotOptionsDonut { Size = "65%" }
                }
            }
        };

        opcionesGraficoCategorias = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 300, Toolbar = new Toolbar { Show = false } },
            Legend = new Legend { Position = LegendPosition.Bottom, HorizontalAlign = Align.Center, FontSize = "12px" },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    CustomScale = 1.0,
                    Donut = new PlotOptionsDonut { Size = "65%" }
                }
            }
        };

        opcionesGraficoTipos = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 300, Toolbar = new Toolbar { Show = false } },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = true,
                    BorderRadius = 5,
                    BarHeight = "48%"
                }
            }
        };

        opcionesGraficoTendencia = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 260, Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#0284C7" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Fill = new Fill { Type = new List<FillType> { FillType.Gradient }, Gradient = new FillGradient { ShadeIntensity = 1, OpacityFrom = 0.45, OpacityTo = 0.05 } }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestaurarEstadoDesdeStorage();
            await CargarDatosDashboard();
        }
    }

    private async Task RestaurarEstadoDesdeStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("sessionStorage.getItem", "dashboard_filtros");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var estado = JsonSerializer.Deserialize<FiltroAvanzadoPanel.FiltroDataModel>(json);
                if (estado != null)
                {
                    filtroFechaAplicado = estado.FiltroFechaAplicado;
                    fechaInicio = estado.FechaInicio;
                    fechaFin = estado.FechaFin;
                    filtroEstado = estado.FiltroEstado;
                    filtroTipoTramite = estado.FiltroTipoTramite;
                }
            }
        }
        catch { }
    }

    private async Task ManejarAplicarFiltros(FiltroAvanzadoPanel.FiltroDataModel modelo)
    {
        filtroFechaAplicado = modelo.FiltroFechaAplicado;
        fechaInicio = modelo.FechaInicio;
        fechaFin = modelo.FechaFin;
        filtroEstado = modelo.FiltroEstado;
        filtroTipoTramite = modelo.FiltroTipoTramite;

        try
        {
            var json = JsonSerializer.Serialize(modelo);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "dashboard_filtros", json);
        }
        catch { }

        await CargarDatosDashboard();
    }

  private async Task ManejarLimpiarFiltros()
    {
        filtroFechaAplicado = false;
        filtroEstado = string.Empty;
        filtroTipoTramite = string.Empty;
        fechaInicio = DateTime.Today;
        fechaFin = DateTime.Today;

        try
        {
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "dashboard_filtros");
        }
        catch { }

        await CargarDatosDashboard();
    }

    private async Task CargarDatosDashboard()
    {
        try
        {
            var queryParams = new List<string>();

            if (filtroFechaAplicado)
            {
                queryParams.Add($"fechaInicio={fechaInicio:yyyy-MM-dd}");
                queryParams.Add($"fechaFin={fechaFin:yyyy-MM-dd}");
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
                queryParams.Add($"estado={Uri.EscapeDataString(filtroEstado)}");
            if (!string.IsNullOrWhiteSpace(filtroTipoTramite))
                queryParams.Add($"tipoTramite={Uri.EscapeDataString(filtroTipoTramite)}");

            string url = "api/solicitud/dashboard";
            if (queryParams.Any())
                url += "?" + string.Join("&", queryParams);

            var resumen = await Http.GetFromJsonAsync<DashboardDto>(url);

            if (resumen != null)
            {
                totalSolicitudes = resumen.TotalSolicitudes;
                totalPendientes = resumen.Pendientes;
                totalEnProceso = resumen.EnProceso;
                totalAprobadas = resumen.Aprobadas;
                totalRechazadas = resumen.Rechazadas;
                totalCanceladas = resumen.Canceladas;

                totalEstudiante = resumen.PorTipoTramite.Where(t => t.Etiqueta.Contains("Estudiante", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Cantidad);
                totalTrabajo = resumen.PorTipoTramite.Where(t => t.Etiqueta.Contains("Trabajo", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Cantidad);
                totalFamilia = resumen.PorTipoTramite.Where(t => t.Etiqueta.Contains("Familia", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Cantidad);
                totalMenores = resumen.PorTipoTramite.Where(t => t.Etiqueta.Contains("Menores", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Cantidad);

                // Integrar expediente local si existe
                var titularGuardado = !string.IsNullOrWhiteSpace(StateService.Titular)
                    ? StateService.Titular
                    : await JS.InvokeAsync<string>("localStorage.getItem", "expediente_titular");

                if (!string.IsNullOrWhiteSpace(titularGuardado))
                {
                    totalSolicitudes += 1;
                    var estadoActual = !string.IsNullOrWhiteSpace(StateService.EstadoGeneral)
                        ? StateService.EstadoGeneral
                        : (await JS.InvokeAsync<string>("localStorage.getItem", "expediente_estado") ?? "Pendiente");

                    if (estadoActual == "Aprobado") totalAprobadas += 1;
                    else if (estadoActual == "Rechazado") totalRechazadas += 1;
                    else totalPendientes += 1;

                    var catLocal = !string.IsNullOrWhiteSpace(StateService.Categoria)
                        ? StateService.Categoria
                        : (await JS.InvokeAsync<string>("localStorage.getItem", "expediente_categoria") ?? "Residencia de Estudiante");

                    if (catLocal.Contains("Estudiante", StringComparison.OrdinalIgnoreCase)) totalEstudiante += 1;
                    else if (catLocal.Contains("Trabajo", StringComparison.OrdinalIgnoreCase)) totalTrabajo += 1;
                    else if (catLocal.Contains("Familia", StringComparison.OrdinalIgnoreCase)) totalFamilia += 1;
                    else if (catLocal.Contains("Menores", StringComparison.OrdinalIgnoreCase)) totalMenores += 1;
                }

                datosDelGrafico = new List<DatoGrafico>
                {
                    new DatoGrafico { Estado = "Pendientes", Cantidad = totalPendientes },
                    new DatoGrafico { Estado = "En Proceso", Cantidad = totalEnProceso },
                    new DatoGrafico { Estado = "Aprobadas", Cantidad = totalAprobadas },
                    new DatoGrafico { Estado = "Rechazadas", Cantidad = totalRechazadas },
                    new DatoGrafico { Estado = "Canceladas", Cantidad = totalCanceladas }
                };

                datosCategorias = new List<DatoGrafico>
                {
                    new DatoGrafico { Estado = "Residencia de Estudiante", Cantidad = totalEstudiante },
                    new DatoGrafico { Estado = "Residencia de Trabajo", Cantidad = totalTrabajo },
                    new DatoGrafico { Estado = "Residencia por Familia", Cantidad = totalFamilia },
                    new DatoGrafico { Estado = "Residencia de Menores", Cantidad = totalMenores }
                };

                datosTendencia = resumen.TendenciaMensual.Select(m => new DatoGrafico
                {
                    Estado = m.Etiqueta,
                    Cantidad = m.Cantidad
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de conexión: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);

        if (miGrafico != null) await miGrafico.RenderAsync();
        if (miGraficoCircular != null) await miGraficoCircular.RenderAsync();
        if (miGraficoCategorias != null) await miGraficoCategorias.RenderAsync();
        if (miGraficoTipos != null) await miGraficoTipos.RenderAsync();
        if (miGraficoTendencia != null) await miGraficoTendencia.RenderAsync();
    }

    private string ObtenerColorCristal(string? estado)
    {
        return estado switch
        {
            "Pendientes" => "#fde047",
            "En Proceso" => "#38bdf8",
            "Aprobadas" => "#4ade80",
            "Rechazadas" => "#f87171",
            "Canceladas" => "#94a3b8",
            _ => "#003876"
        };
    }

    private string ObtenerColorCristalCategoria(string? categoria)
    {
        return categoria switch
        {
            "Residencia de Estudiante" => "#93c5fd",
            "Residencia de Trabajo" => "#86efac",
            "Residencia por Familia" => "#d8b4fe",
            "Residencia de Menores" => "#fde047",
            _ => "#003876"
        };
    }
}