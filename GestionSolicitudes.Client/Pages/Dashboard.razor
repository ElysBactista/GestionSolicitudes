@page "/dashboard"
@page "/home"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>HOME - DGM</PageTitle>

<div class="container-fluid px-4 py-3" style="font-family: 'Poppins', sans-serif; background-color: #f8fafc; min-height: 100vh;">

    <!-- ========================================================= -->
    <!-- 1. ENCABEZADO CON PANEL UNIFICADO Y ACCIONES DIRECTAS     -->
    <!-- ========================================================= -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: #003876;">Panel de Control Institucional</h4>
            <p class="small mb-0 text-dark">Resumen operativo y métricas estadísticas de trámites migratorios</p>
        </div>

        <!-- Barra Superior Compacta -->
        <div class="d-flex align-items-center gap-2 bg-white p-2 rounded-3 shadow-sm border border-light-subtle position-relative">

            <!-- Indicador Visual del Periodo Activo -->
            <div class="d-none d-sm-flex align-items-center gap-2 px-2 small">
                <i class="bi bi-calendar3" style="color: #003876;"></i>
                <span class="fw-medium text-dark">
                    @(filtroFechaAplicado ? $"{fechaInicio.ToString("dd/MM/yyyy")} - {fechaFin.ToString("dd/MM/yyyy")}" : "Histórico Completo")
                </span>
            </div>

            <div class="vr d-none d-sm-block my-1"></div>

            <!-- Botón Filtros -->
            <button class="btn btn-sm btn-light border border-secondary border-opacity-25 text-dark fw-medium px-3 position-relative d-flex align-items-center gap-2"
                    @onclick="() => mostrarPanelFiltros = !mostrarPanelFiltros"
                    style="background-color: #ffffff; font-size: 0.82rem; border-radius: 6px;">
                <i class="bi bi-sliders" style="color: #003876;"></i> Filtros
                @if (FiltrosActivos())
                {
                    <span class="p-1 rounded-circle position-relative" style="background-color: #003876; width: 7px; height: 7px; display: inline-block;"></span>
                }
            </button>

            <!-- Botón Exterior Limpiar -->
            <button class="btn btn-sm text-white d-flex align-items-center justify-content-center shadow-sm"
                    @onclick="LimpiarFiltrosExterior"
                    title="Restablecer filtros al historial completo"
                    style="background-color: #003876; width: 34px; height: 31px; border-radius: 6px;">
                <i class="bi bi-arrow-counterclockwise fs-6"></i>
            </button>

            <!-- ========================================================= -->
            <!-- PANEL FLOTANTE COMPACTO Y ARMONIOSO                       -->
            <!-- ========================================================= -->
            @if (mostrarPanelFiltros)
            {
                <div class="card shadow-lg border rounded-4 position-absolute end-0 p-3 bg-white"
                     style="top: 115%; width: 355px; z-index: 1055; border-color: #e2e8f0 !important; box-shadow: 0 14px 30px rgba(0,0,0,0.15) !important;">

                    <!-- Cabecera -->
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold small text-dark">
                            <i class="bi bi-funnel-fill me-1" style="color: #003876;"></i> Filtros del Panel
                        </span>
                        <button type="button" class="btn-close btn-sm" @onclick="() => { mostrarPanelFiltros = false; calendarioAbierto = string.Empty; }"></button>
                    </div>

                    <!-- 1. Rango de Fechas con Apertura Dinámica -->
                    <div class="mb-2">
                        <label class="fw-bold mb-1 d-block text-dark" style="font-size: 0.72rem;">RANGO DE FECHAS (Día/Mes/Año)</label>
                        <div class="d-flex gap-2">
                            <!-- Campo Desde -->
                            <div class="flex-fill position-relative">
                                <input type="text" class="form-control form-control-sm border text-center fw-medium bg-light text-dark @(calendarioAbierto == "desde" ? "border-primary shadow-xs" : "")"
                                       style="font-size: 0.78rem; cursor: pointer;"
                                       value="@txtFechaInicio"
                                       placeholder="DD/MM/AAAA"
                                       @onclick='() => ToggleCalendario("desde")'
                                       @oninput="(e) => ActualizarFechaEscrita(true, e.Value?.ToString())" />
                            </div>
                            <!-- Campo Hasta -->
                            <div class="flex-fill position-relative">
                                <input type="text" class="form-control form-control-sm border text-center fw-medium bg-light text-dark @(calendarioAbierto == "hasta" ? "border-primary shadow-xs" : "")"
                                       style="font-size: 0.78rem; cursor: pointer;"
                                       value="@txtFechaFin"
                                       placeholder="DD/MM/AAAA"
                                       @onclick='() => ToggleCalendario("hasta")'
                                       @oninput="(e) => ActualizarFechaEscrita(false, e.Value?.ToString())" />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Accesos Rápidos -->
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-xs btn-chip" @onclick="() => AplicarPreset(1)">Hoy</button>
                        <button type="button" class="btn btn-xs btn-chip" @onclick="() => AplicarPreset(2)">Ayer</button>
                        <button type="button" class="btn btn-xs btn-chip" @onclick="() => AplicarPreset(7)">Esta Semana</button>
                        <button type="button" class="btn btn-xs btn-chip" @onclick="() => AplicarPreset(30)">Este Mes</button>
                        <button type="button" class="btn btn-xs btn-chip" @onclick="() => AplicarPreset(365)">Este Año</button>
                    </div>

                    <!-- 3. Mini Calendario Interactivo -->
                    @if (!string.IsNullOrEmpty(calendarioAbierto))
                    {
                        <div class="p-2 mb-2 rounded-3 bg-light border border-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-1 px-1">
                                <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.68rem;">
                                    Modificando fecha: <strong>@(calendarioAbierto == "desde" ? "Desde" : "Hasta")</strong>
                                </span>
                                <button type="button" class="btn-close btn-sm" style="font-size: 0.6rem;" @onclick='() => calendarioAbierto = string.Empty'></button>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <button type="button" class="btn btn-sm btn-light border-0 rounded-circle p-0 d-flex align-items-center justify-content-center bg-white shadow-xs"
                                        style="width: 24px; height: 24px;" @onclick="() => AvanzarRetrocederMesManual(-1)">
                                    <i class="bi bi-chevron-left" style="color: #003876; font-size: 0.7rem;"></i>
                                </button>

                                <div class="d-flex align-items-center gap-1">
                                    <select class="form-select form-select-sm select-sin-flecha fw-medium text-capitalize text-dark"
                                            style="width: auto; cursor: pointer; font-size: 0.76rem; padding: 2px 8px;"
                                            value="@mesVistaCalendario.Month"
                                            @onchange="CambiarMesMiniCal">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m">@ObtenerNombreMes(m)</option>
                                        }
                                    </select>

                                    <select class="form-select form-select-sm select-sin-flecha fw-medium text-dark"
                                            style="width: 72px; cursor: pointer; font-size: 0.76rem; padding: 2px 6px;"
                                            value="@mesVistaCalendario.Year"
                                            @onchange="CambiarAnioMiniCal">
                                        @for (int a = 2020; a <= DateTime.Today.Year + 5; a++)
                                        {
                                            <option value="@a">@a</option>
                                        }
                                    </select>
                                </div>

                                <button type="button" class="btn btn-sm btn-light border-0 rounded-circle p-0 d-flex align-items-center justify-content-center bg-white shadow-xs"
                                        style="width: 24px; height: 24px;" @onclick="() => AvanzarRetrocederMesManual(1)">
                                    <i class="bi bi-chevron-right" style="color: #003876; font-size: 0.7rem;"></i>
                                </button>
                            </div>

                            <div class="d-grid text-center mb-1" style="grid-template-columns: repeat(7, 1fr); font-size: 0.62rem; color: #000000; font-weight: 700;">
                                <div>DO</div><div>LU</div><div>MA</div><div>MI</div><div>JU</div><div>VI</div><div>SA</div>
                            </div>

                            <div class="d-grid text-center" style="grid-template-columns: repeat(7, 1fr); row-gap: 1px;">
                                @for (int i = 0; i < (int)(new DateTime(mesVistaCalendario.Year, mesVistaCalendario.Month, 1).DayOfWeek); i++)
                                {
                                    <div style="height: 24px;"></div>
                                }
                                @for (int d = 1; d <= DateTime.DaysInMonth(mesVistaCalendario.Year, mesVistaCalendario.Month); d++)
                                {
                                    var fecha = new DateTime(mesVistaCalendario.Year, mesVistaCalendario.Month, d);
                                    @RenderizarMiniDia(fecha, d)
                                }
                            </div>
                        </div>
                    }

                    <hr class="my-2" />

                    <!-- 4. Filtros de Estado y Trámite -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold mb-1 text-dark" style="font-size: 0.72rem;">ESTADO</label>
                            <select class="form-select form-select-sm bg-light border text-dark fw-normal" @bind="filtroEstado" style="font-size: 0.78rem;">
                                <option value="">Todos</option>
                                <option value="Pendiente">Pendientes</option>
                                <option value="En Proceso">En Proceso</option>
                                <option value="Aprobada">Aprobadas</option>
                                <option value="Rechazada">Rechazadas</option>
                                <option value="Cancelada">Canceladas</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold mb-1 text-dark" style="font-size: 0.72rem;">TRÁMITE</label>
                            <select class="form-select form-select-sm bg-light border text-dark fw-normal" @bind="filtroTipoTramite" style="font-size: 0.78rem;">
                                <option value="">Todos</option>
                                <option value="Residencia Temporal">Temporal</option>
                                <option value="Residencia Definitiva">Definitiva</option>
                                <option value="Renovación">Renovación</option>
                                <option value="Permiso de Reingreso">Reingreso</option>
                            </select>
                        </div>
                    </div>

                    <!-- 5. Acciones Internas del Panel -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <button type="button" class="btn btn-sm text-white fw-semibold px-3"
                                style="background-color: #003876; font-size: 0.78rem; border-radius: 6px;"
                                @onclick="LimpiarCamposPanel">
                            Limpiar
                        </button>
                        <button type="button" class="btn btn-sm text-white px-4 fw-semibold shadow-sm"
                                style="background-color: #003876; font-size: 0.78rem; border-radius: 6px;"
                                @onclick="AplicarFiltrosYConsultar">
                            Aplicar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. TARJETAS KPI HORIZONTALES                              -->
    <!-- ========================================================= -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #003876 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #003876;">@totalSolicitudes</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(0, 56, 118, 0.08); color: #003876;">
                        <i class="bi bi-folder2 fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Pendientes</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #b45309;">@totalPendientes</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #fef3c7; color: #d97706;">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #0284c7 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">En Proceso</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #0369a1;">@totalEnProceso</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #e0f2fe; color: #0284c7;">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #10b981 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Aprobadas</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #047857;">@totalAprobadas</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #d1fae5; color: #059669;">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #EE2A24 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Rechazadas</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #b91c1c;">@totalRechazadas</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #fee2e2; color: #dc2626;">
                        <i class="bi bi-x-circle fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #64748b !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">Canceladas</span>
                        <h3 class="fw-bold mb-0 mt-1" style="color: #475569;">@totalCanceladas</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: #f1f5f9; color: #64748b;">
                        <i class="bi bi-slash-circle fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 3. FILA 1 DE GRÁFICAS (ESTADOS OPERATIVOS)                -->
    <!-- ========================================================= -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                    <h6 class="fw-bold mb-0" style="color: #003876;">Volumen Operativo por Estado</h6>
                    <small class="text-dark">Distribución cuantitativa de expedientes</small>
                </div>
                <div class="card-body px-4 pb-3 pt-2">
                    <ApexChart @ref="miGrafico" TItem="DatoGrafico" Options="opcionesGraficoBarras">
                        <ApexPointSeries TItem="DatoGrafico"
                                         Items="datosDelGrafico"
                                         Name="Cantidad"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.Estado)"
                                         YValue="@(e => e.Cantidad)"
                                         PointColor="@(e => ObtenerColorSolido(e.Estado))" />
                    </ApexChart>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                    <h6 class="fw-bold mb-0" style="color: #003876;">Distribución Porcentual</h6>
                    <small class="text-dark">Proporción relativa de trámites</small>
                </div>
                <div class="card-body px-3 pb-3 pt-2 text-center">
                    <ApexChart @ref="miGraficoCircular" TItem="DatoGrafico" Options="opcionesGraficoCircular">
                        <ApexPointSeries TItem="DatoGrafico"
                                         Items="datosDelGrafico"
                                         Name="Solicitudes"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(e => e.Estado)"
                                         YValue="@(e => e.Cantidad)"
                                         PointColor="@(e => ObtenerColorSolido(e.Estado))" />
                    </ApexChart>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 4. FILA 2 DE GRÁFICAS (TIPO DE TRÁMITE Y TENDENCIA)       -->
    <!-- ========================================================= -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0" style="color: #003876;">Trámites más Frecuentes</h6>
                        <small class="text-dark">Demanda por tipo de servicio migratorio</small>
                    </div>
                    <i class="bi bi-pie-chart fs-5" style="color: #003876;"></i>
                </div>
                <div class="card-body px-4 pb-3 pt-2">
                    <ApexChart @ref="miGraficoTipos" TItem="DatoGrafico" Options="opcionesGraficoTipos">
                        <ApexPointSeries TItem="DatoGrafico"
                                         Items="datosPorTipo"
                                         Name="Expedientes"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.Estado)"
                                         YValue="@(e => e.Cantidad)" />
                    </ApexChart>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0" style="color: #003876;">Evolución de Registro</h6>
                        <small class="text-dark">Ingreso cronológico de solicitudes</small>
                    </div>
                    <i class="bi bi-graph-up-arrow fs-5" style="color: #003876;"></i>
                </div>
                <div class="card-body px-4 pb-3 pt-2">
                    <ApexChart @ref="miGraficoTendencia" TItem="DatoGrafico" Options="opcionesGraficoTendencia">
                        <ApexPointSeries TItem="DatoGrafico"
                                         Items="datosTendencia"
                                         Name="Solicitudes"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(e => e.Estado)"
                                         YValue="@(e => e.Cantidad)" />
                    </ApexChart>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    public class EstadisticaItemDto
    {
        public string Etiqueta { get; set; } = string.Empty;
        public int Cantidad { get; set; }
    }

    public class DashboardDto
    {
        public int TotalSolicitudes { get; set; }
        public int Aprobadas { get; set; }
        public int EnProceso { get; set; }
        public int Pendientes { get; set; }
        public int Canceladas { get; set; }
        public int Rechazadas { get; set; }
        public List<EstadisticaItemDto> PorTipoTramite { get; set; } = new();
        public List<EstadisticaItemDto> TendenciaMensual { get; set; } = new();
    }

    public class DatoGrafico
    {
        public string? Estado { get; set; }
        public int Cantidad { get; set; }
    }

    public class EstadoPersistenciaDashboard
    {
        public bool FiltroFechaAplicado { get; set; }
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public string TxtFechaInicio { get; set; } = string.Empty;
        public string TxtFechaFin { get; set; } = string.Empty;
        public string FiltroEstado { get; set; } = string.Empty;
        public string FiltroTipoTramite { get; set; } = string.Empty;
    }

    private ApexChart<DatoGrafico>? miGrafico;
    private ApexChart<DatoGrafico>? miGraficoCircular;
    private ApexChart<DatoGrafico>? miGraficoTipos;
    private ApexChart<DatoGrafico>? miGraficoTendencia;

    private ApexChartOptions<DatoGrafico> opcionesGraficoBarras = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoCircular = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTipos = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTendencia = new();

    private List<DatoGrafico> datosDelGrafico = new();
    private List<DatoGrafico> datosPorTipo = new();
    private List<DatoGrafico> datosTendencia = new();

    private bool filtroFechaAplicado = false;
    private DateTime fechaInicio = DateTime.Today;
    private DateTime fechaFin = DateTime.Today;

    private string txtFechaInicio = DateTime.Today.ToString("dd/MM/yyyy");
    private string txtFechaFin = DateTime.Today.ToString("dd/MM/yyyy");

    // Control de calendario interactivo para "desde" y "hasta"
    private string calendarioAbierto = string.Empty;
    private DateTime mesVistaCalendario = DateTime.Today;

    private bool mostrarPanelFiltros = false;
    private string filtroEstado = string.Empty;
    private string filtroTipoTramite = string.Empty;

    private int totalSolicitudes = 0;
    private int totalPendientes = 0;
    private int totalEnProceso = 0;
    private int totalAprobadas = 0;
    private int totalRechazadas = 0;
    private int totalCanceladas = 0;

    protected override void OnInitialized()
    {
        opcionesGraficoBarras.Chart = new Chart { Height = 280, Toolbar = new Toolbar { Show = false } };
        opcionesGraficoBarras.PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                BorderRadius = 6,
                ColumnWidth = "42%"
            }
        };

        opcionesGraficoCircular = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 340, Toolbar = new Toolbar { Show = false } },
            Legend = new Legend { Position = LegendPosition.Bottom, HorizontalAlign = Align.Center, FontSize = "13px" },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    CustomScale = 1.0,
                    Donut = new PlotOptionsDonut { Size = "65%" }
                }
            }
        };

