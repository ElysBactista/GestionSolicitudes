    private void RefrescarPorIdioma()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ManejarAplicarFiltros(FiltroAvanzadoPanel.FiltroDataModel modelo)
    {
        filtroFechaAplicado = modelo.FiltroFechaAplicado;
        fechaInicio = modelo.FechaInicio;
        fechaFin = modelo.FechaFin;
        filtroEstado = modelo.FiltroEstado;
        filtroTipoTramite = modelo.FiltroTipoTramite;

        await CargarDatosDashboard();
    }

    private async Task ManejarLimpiarFiltros()
    {
        filtroFechaAplicado = false;
        filtroEstado = string.Empty;
        filtroTipoTramite = string.Empty;
        fechaInicio = DateTime.Today.AddMonths(-1);
        fechaFin = DateTime.Today;

        await CargarDatosDashboard();
    }

    private async Task CargarDatosDashboard()
    {
        cargandoGlobal = true;
        cargandoTipos = true;
        cargandoCircular = true;
        cargandoBarras = true;
        cargandoCategorias = true;
        cargandoTiposGrafico = true;
        cargandoTendencia = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var queryParams = new List<string>();

            if (filtroFechaAplicado)
            {
                queryParams.Add($"fechaInicio={fechaInicio:yyyy-MM-dd}");
                queryParams.Add($"fechaFin={fechaFin:yyyy-MM-dd}");
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                queryParams.Add($"estado={Uri.EscapeDataString(filtroEstado)}");
            }

            if (!string.IsNullOrWhiteSpace(filtroTipoTramite))
            {
                queryParams.Add($"tipoTramite={Uri.EscapeDataString(filtroTipoTramite)}");
            }

            string url = "api/solicitud/dashboard";
            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }

            var resumen = await Http.GetFromJsonAsync<DashboardRespuestaDto>(url);
            if (resumen != null)
            {
                totalSolicitudes = resumen.TotalSolicitudes;
                totalPendientes = resumen.Pendientes;
                totalEnProceso = resumen.EnProceso;
                totalAprobadas = resumen.Aprobadas;
                totalRechazadas = resumen.Rechazadas;
                totalCanceladas = resumen.Canceladas;

                datosDelGrafico = new List<DatoGrafico>
                {
                    new() { Estado = "Pendientes", Cantidad = totalPendientes },
                    new() { Estado = "En Proceso", Cantidad = totalEnProceso },
                    new() { Estado = "Aprobadas", Cantidad = totalAprobadas },
                    new() { Estado = "Rechazadas", Cantidad = totalRechazadas },
                    new() { Estado = "Canceladas", Cantidad = totalCanceladas }
                };
                cargandoCircular = false;
                cargandoBarras = false;
                StateHasChanged();

                if (resumen.PorTipoTramite != null && resumen.PorTipoTramite.Any())
                {
                    datosCategorias = resumen.PorTipoTramite.Select(t => new DatoGrafico
                    {
                        Estado = t.Etiqueta,
                        Cantidad = t.Cantidad
                    }).ToList();

                    totalEstudiante = resumen.PorTipoTramite.FirstOrDefault(t => t.Etiqueta.Contains("Estudiante", StringComparison.OrdinalIgnoreCase))?.Cantidad ?? 0;
                    totalTrabajo = resumen.PorTipoTramite.FirstOrDefault(t => t.Etiqueta.Contains("Trabajo", StringComparison.OrdinalIgnoreCase))?.Cantidad ?? 0;
                    totalFamilia = resumen.PorTipoTramite.FirstOrDefault(t => t.Etiqueta.Contains("Familia", StringComparison.OrdinalIgnoreCase))?.Cantidad ?? 0;
                    totalInversionista = resumen.PorTipoTramite.FirstOrDefault(t => t.Etiqueta.Contains("Inversionista", StringComparison.OrdinalIgnoreCase) || t.Etiqueta.Contains("Menor", StringComparison.OrdinalIgnoreCase))?.Cantidad ?? 0;
                }
                cargandoTipos = false;
                cargandoCategorias = false;
                cargandoTiposGrafico = false;
                StateHasChanged();

                if (resumen.TendenciaMensual != null && resumen.TendenciaMensual.Any())
                {
                    datosTendencia = resumen.TendenciaMensual.Select(t => new DatoGrafico
                    {
                        Estado = t.Etiqueta,
                        Cantidad = t.Cantidad
                    }).ToList();
                }
                cargandoTendencia = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al sincronizar dashboard con la API: {ex.Message}");
        }
        finally
        {
            cargandoGlobal = false;
            cargandoTipos = false;
            cargandoCircular = false;
            cargandoBarras = false;
            cargandoCategorias = false;
            cargandoTiposGrafico = false;
            cargandoTendencia = false;
            cargaInicial = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private string TraducirEtiqueta(string estado)
    {
        if (Idioma.EsEspanol) return estado;
        return estado switch
        {
            "Pendientes" => "Pending",
            "En Proceso" => "In Process",
            "Aprobadas" => "Approved",
            "Rechazadas" => "Rejected",
            "Canceladas" => "Cancelled",
            _ => estado
        };
    }

    private string TraducirCategoria(string categoria)
    {
        if (Idioma.EsEspanol) return categoria;
        if (categoria.Contains("Estudiante", StringComparison.OrdinalIgnoreCase)) return "Student Residence";
        if (categoria.Contains("Trabajo", StringComparison.OrdinalIgnoreCase)) return "Work Residence";
        if (categoria.Contains("Familia", StringComparison.OrdinalIgnoreCase)) return "Family Residence";
        if (categoria.Contains("Inversionista", StringComparison.OrdinalIgnoreCase)) return "Investor Residence";
        return categoria;
    }

    // Colores del Kit Visual: advertencia, información, éxito, error y gris de texto desactivado
    private string ObtenerColorCristal(string? estado) => estado switch
    {
        "Pendientes" => "#FFBA00",
        "En Proceso" => "#0087FF",
        "Aprobadas" => "#2ECC71",
        "Rechazadas" => "#EE2A24",
        "Canceladas" => "#707070",
        _ => "#003876"
    };

    // Estudiante = azul información, Trabajo = azul primario, Familia = amarillo, Inversionista = verde
    private string ObtenerColorCristalContainer(string? categoria) => categoria switch
    {
        var c when c != null && c.Contains("Estudiante", StringComparison.OrdinalIgnoreCase) => "#0087FF",
        var c when c != null && c.Contains("Trabajo", StringComparison.OrdinalIgnoreCase) => "#003876",
        var c when c != null && c.Contains("Familia", StringComparison.OrdinalIgnoreCase) => "#FFBA00",
        _ => "#2ECC71"
    };

    private string ObtenerColorCristalCategoria(string? categoria) => ObtenerColorCristalContainer(categoria);

    public void Dispose()
    {
        Idioma.OnIdiomaCambiado -= RefrescarPorIdioma;
    }

