@page "/dashboard"
@page "/home"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using System.Text.Json
@using System.Net.Http.Json
@using GestionSolicitudes.Client.Layout
@inject HttpClient Http
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<PageTitle>@(Idioma.EsEspanol ? "Panel de Control Institucional | DGM" : "Institutional Dashboard | DGM")</PageTitle>

<div class="portal-externo-container w-100" style="position: relative; background-color: #f8fafc; font-family: 'Poppins', sans-serif; min-height: 90vh;">

    <!-- ========================================================= -->
    <!-- OVERLAY GENERAL DE CARGA INICIAL -->
    <!-- ========================================================= -->
    @if (cargandoGlobal)
    {
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1050;
                            display: flex; justify-content: center; align-items: flex-start;
                            background-color: rgba(248, 250, 252, 0.3);
                            backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);">
            <div class="text-center bg-white rounded-4 shadow-sm px-4 py-3 border"
                 style="position: sticky; top: 32vh; border-color: rgba(0, 56, 118, 0.1) !important;">
                <div class="spinner-border text-primary" role="status"
                     style="width: 2.2rem; height: 2.2rem; color: #003876 !important; border-width: 0.25rem;">
                    <span class="visually-hidden">@(Idioma.EsEspanol ? "Cargando..." : "Loading...")</span>
                </div>
                <div class="fw-bold mt-2" style="color: #003876; font-size: 0.9rem;">
                    @(Idioma.EsEspanol ? "Cargando métricas..." : "Loading metrics...")
                </div>
            </div>
        </div>
    }

    <div class="container-fluid px-3 px-md-4 py-4">

        <!-- ========================================================= -->
        <!-- 1. ENCABEZADO: TÍTULO (IZQUIERDA) + FILTRO (DERECHA) EN LA MISMA FILA -->
        <!-- ========================================================= -->
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 pt-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: #003876; font-size: 1.85rem; line-height: 1.2;">
                    @(Idioma.EsEspanol ? "Panel de Control Institucional" : "Institutional Dashboard")
                </h2>
                <p class="small mb-0 fs-6" style="color: #707070;">
                    @(Idioma.EsEspanol
                                        ? "Resumen operativo y métricas estadísticas de trámites migratorios"
                                        : "Operational summary and statistical metrics of immigration procedures")
                </p>
            </div>

            <div class="flex-shrink-0">
                <FiltroAvanzadoPanel FiltroFechaAplicado="filtroFechaAplicado"
                                     FechaInicio="fechaInicio"
                                     FechaFin="fechaFin"
                                     FiltroEstado="filtroEstado"
                                     FiltroTipoTramite="filtroTipoTramite"
                                     OnAplicarFiltros="ManejarAplicarFiltros"
                                     OnLimpiar="ManejarLimpiarFiltros" />
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- 2. TARJETAS KPI HORIZONTALES -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #003876 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "Total" : "Total")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #003876;">@totalSolicitudes</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(0, 56, 118, 0.08); color: #003876;">
                            <i class="bi bi-folder2 fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #FFBA00 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "Pendientes" : "Pending")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #B37F00;">@totalPendientes</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(255, 186, 0, 0.16); color: #B37F00;">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #0087FF !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "En Proceso" : "In Process")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #0066C4;">@totalEnProceso</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(0, 135, 255, 0.12); color: #0087FF;">
                            <i class="bi bi-hourglass-split fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #2ECC71 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "Aprobadas" : "Approved")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #1E9E55;">@totalAprobadas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(46, 204, 113, 0.16); color: #1E9E55;">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #EE2A24 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "Rechazadas" : "Rejected")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #EE2A24;">@totalRechazadas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(238, 42, 36, 0.12); color: #EE2A24;">
                            <i class="bi bi-x-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-2">
                <div class="card border-0 rounded-3 shadow-sm bg-white p-3 h-100" style="border-left: 4px solid #707070 !important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold d-block text-uppercase text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @(Idioma.EsEspanol ? "Canceladas" : "Cancelled")
                            </span>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #707070;">@totalCanceladas</h3>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(112, 112, 112, 0.12); color: #707070;">
                            <i class="bi bi-slash-circle fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- GRILLA DE 6 BLOQUES (TRES POR FILA EN ESCRITORIO) -->
        <!-- ========================================================= -->
        <div class="row g-3 mb-4">

            <!-- 1. Tipos de Trámite -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Residencias por Tipos de Trámite" : "Residences by Procedure Types")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Distribución por modalidad migratoria" : "Distribution by migratory modality")
                        </small>
                    </div>
                    <div class="card-body px-4 pb-4 pt-3 d-flex flex-column">
                        @if (cargandoTipos)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 flex-grow-1">
                                <div class="col-6">
                                    <div class="p-2 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center text-center" style="background: linear-gradient(135deg, rgba(0, 135, 255, 0.16) 0%, rgba(0, 135, 255, 0.03) 100%); border: 1px solid rgba(0, 135, 255, 0.4) !important; min-height: 78px;">
                                        <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(Idioma.EsEspanol ? "Estudiante" : "Student")
                                        </span>
                                        <h5 class="fw-bold mb-0 mt-1" style="color: #0087FF;">@totalEstudiante</h5>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="p-2 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center text-center" style="background: linear-gradient(135deg, rgba(0, 56, 118, 0.16) 0%, rgba(0, 56, 118, 0.03) 100%); border: 1px solid rgba(0, 56, 118, 0.4) !important; min-height: 78px;">
                                        <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(Idioma.EsEspanol ? "Trabajo" : "Work")
                                        </span>
                                        <h5 class="fw-bold mb-0 mt-1" style="color: #003876;">@totalTrabajo</h5>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="p-2 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center text-center" style="background: linear-gradient(135deg, rgba(255, 186, 0, 0.2) 0%, rgba(255, 186, 0, 0.04) 100%); border: 1px solid rgba(255, 186, 0, 0.5) !important; min-height: 78px;">
                                        <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(Idioma.EsEspanol ? "Familia" : "Family")
                                        </span>
                                        <h5 class="fw-bold mb-0 mt-1" style="color: #B37F00;">@totalFamilia</h5>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="p-2 rounded-3 h-100 d-flex flex-column align-items-center justify-content-center text-center" style="background: linear-gradient(135deg, rgba(46, 204, 113, 0.18) 0%, rgba(46, 204, 113, 0.04) 100%); border: 1px solid rgba(46, 204, 113, 0.45) !important; min-height: 78px;">
                                        <span class="small fw-bold text-uppercase text-dark" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                            @(Idioma.EsEspanol ? "Inversionista" : "Investor")
                                        </span>
                                        <h5 class="fw-bold mb-0 mt-1" style="color: #1E9E55;">@totalInversionista</h5>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. Gráfica Circular / Donut - Distribución Porcentual -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Distribución Porcentual" : "Percentage Distribution")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Proporción relativa de trámites" : "Relative proportion of procedures")
                        </small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2 text-center">
                        @if (cargandoCircular)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5" style="height: 250px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else if (datosDelGrafico.Any())
                        {
                            <ApexChart TItem="DatoGrafico" Options="opcionesGraficoCircular">
                                <ApexPointSeries TItem="DatoGrafico"
                                                 Items="datosDelGrafico"
                                                 Name="@(Idioma.EsEspanol ? "Solicitudes" : "Applications")"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="@(e => TraducirEtiqueta(e.Estado))"
                                                 YValue="@(e => e.Cantidad)"
                                                 PointColor="@(e => ObtenerColorCristal(e.Estado))" />
                            </ApexChart>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. Gráfica de Barras - Volumen Operativo por Estado -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Volumen Operativo por Estado" : "Operational Volume by Status")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Distribución cuantitativa de expedientes" : "Quantitative distribution of files")
                        </small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2">
                        @if (cargandoBarras)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5" style="height: 250px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else if (datosDelGrafico.Any())
                        {
                            <ApexChart TItem="DatoGrafico" Options="opcionesGraficoBarras">
                                <ApexPointSeries TItem="DatoGrafico"
                                                 Items="datosDelGrafico"
                                                 Name="@(Idioma.EsEspanol ? "Cantidad" : "Count")"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(e => TraducirEtiqueta(e.Estado))"
                                                 YValue="@(e => e.Cantidad)"
                                                 PointColor="@(e => ObtenerColorCristal(e.Estado))" />
                            </ApexChart>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. Gráfica Donut - Inventario por Categoría Oficial -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Inventario por Categoría Oficial" : "Inventory by Official Category")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Volumen según modalidad" : "Volume by modality")
                        </small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2 text-center">
                        @if (cargandoCategorias)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5" style="height: 250px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else if (datosCategorias.Any())
                        {
                            <ApexChart TItem="DatoGrafico" Options="opcionesGraficoCategorias">
                                <ApexPointSeries TItem="DatoGrafico"
                                                 Items="datosCategorias"
                                                 Name="@(Idioma.EsEspanol ? "Expedientes" : "Files")"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="@(e => TraducirCategoria(e.Estado))"
                                                 YValue="@(e => e.Cantidad)"
                                                 PointColor="@(e => ObtenerColorCristalCategoria(e.Estado))" />
                            </ApexChart>
                        }
                    </div>
                </div>
            </div>

            <!-- 5. Gráfica de Barras Horizontales - Trámites más Frecuentes -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Trámites más Frecuentes" : "Most Frequent Procedures")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Demanda por tipo de servicio" : "Demand by service type")
                        </small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2">
                        @if (cargandoTiposGrafico)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5" style="height: 250px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else if (datosCategorias.Any())
                        {
                            <ApexChart TItem="DatoGrafico" Options="opcionesGraficoTipos">
                                <ApexPointSeries TItem="DatoGrafico"
                                                 Items="datosCategorias"
                                                 Name="@(Idioma.EsEspanol ? "Solicitudes" : "Applications")"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(e => TraducirCategoria(e.Estado))"
                                                 YValue="@(e => e.Cantidad)"
                                                 PointColor="@(e => ObtenerColorCristalCategoria(e.Estado))" />
                            </ApexChart>
                        }
                    </div>
                </div>
            </div>

            <!-- 6. Gráfica de Área - Evolución de Registro -->
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                        <h6 class="fw-bold mb-0" style="color: #003876;">
                            @(Idioma.EsEspanol ? "Evolución de Registro" : "Registration Trend")
                        </h6>
                        <small class="text-dark">
                            @(Idioma.EsEspanol ? "Ingreso cronológico" : "Chronological entry")
                        </small>
                    </div>
                    <div class="card-body px-3 pb-3 pt-2">
                        @if (cargandoTendencia)
                        {
                            <div class="d-flex justify-content-center align-items-center py-5" style="height: 250px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small fw-semibold">@(Idioma.EsEspanol ? "Cargando datos..." : "Loading data...")</span>
                            </div>
                        }
                        else if (datosTendencia.Any())
                        {
                            <ApexChart TItem="DatoGrafico" Options="opcionesGraficoTendencia">
                                <ApexPointSeries TItem="DatoGrafico"
                                                 Items="datosTendencia"
                                                 Name="@(Idioma.EsEspanol ? "Solicitudes" : "Applications")"
                                                 SeriesType="SeriesType.Area"
                                                 XValue="@(e => e.Estado)"
                                                 YValue="@(e => e.Cantidad)" />
                            </ApexChart>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@code {
    public class DatoGrafico
    {
        public string Estado { get; set; } = string.Empty;
        public int Cantidad { get; set; }
    }

    private ApexChartOptions<DatoGrafico> opcionesGraficoBarras = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoCircular = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoCategorias = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTipos = new();
    private ApexChartOptions<DatoGrafico> opcionesGraficoTendencia = new();

    private List<DatoGrafico> datosDelGrafico = new();
    private List<DatoGrafico> datosCategorias = new();
    private List<DatoGrafico> datosTendencia = new();

    private bool cargandoGlobal = true;
    private bool cargandoTipos = true;
    private bool cargandoCircular = true;
    private bool cargandoBarras = true;
    private bool cargandoCategorias = true;
    private bool cargandoTiposGrafico = true;
    private bool cargandoTendencia = true;
    private bool cargaInicial = true;

    private bool filtroFechaAplicado = false;
    private DateTime fechaInicio = DateTime.Today.AddMonths(-1);
    private DateTime fechaFin = DateTime.Today;
    private string filtroEstado = string.Empty;
    private string filtroTipoTramite = string.Empty;

    private int totalSolicitudes = 0;
    private int totalPendientes = 0;
    private int totalEnProceso = 0;
    private int totalAprobadas = 0;
    private int totalRechazadas = 0;
    private int totalCanceladas = 0;

    private int totalEstudiante = 0;
    private int totalTrabajo = 0;
    private int totalFamilia = 0;
    private int totalInversionista = 0;

    protected override async Task OnInitializedAsync()
    {
        Idioma.OnIdiomaCambiado += RefrescarPorIdioma;

        opcionesGraficoBarras.Chart = new Chart { Height = 250, Toolbar = new Toolbar { Show = false } };
        opcionesGraficoBarras.PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 6, ColumnWidth = "42%" } };
        opcionesGraficoBarras.Yaxis = new List<YAxis> { new YAxis { TickAmount = 3, Min = 0, Labels = new YAxisLabels { Formatter = "function (val) { return Math.floor(val); }" } } };

        opcionesGraficoCircular = new ApexChartOptions<DatoGrafico>
        {
            Chart = new Chart { Height = 250, Toolbar = new Toolbar { Show = false } },
