@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="container py-5 text-center">
                        <div class="card shadow-sm border-0 rounded-4 p-5 mx-auto" style="max-width: 520px;">
                            <div class="mb-3">
                                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 3rem;"></i>
                            </div>
                            <h4 class="fw-bold text-dark">Acceso Restringido</h4>
                            <p class="text-muted small mb-4">
                                No posee los permisos necesarios o debe iniciar sesión para visualizar este recurso.
                            </p>
                            <a href="/login" class="btn text-white rounded-pill px-4 py-2 fw-semibold" style="background-color: #003876;">
                                Iniciar Sesión
                            </a>
                        </div>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Validando autorización...</span>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página no encontrada</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="container py-5 text-center">
                    <p class="fs-5 text-muted" role="alert">Lo sentimos, no hay nada en esta dirección.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>