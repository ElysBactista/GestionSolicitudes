@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex flex-column min-vh-100 w-100" style="background-color: #F8F9FA;">

    <!-- 1. HEADER INSTITUCIONAL FIJO (Limpiando cualquier doble línea inferior) -->
    <header class="w-100 bg-white app-fixed-header">
        <HeaderInstitucional />
    </header>

    <!-- 2. CUERPO CENTRAL (Sidebar + Contenido) -->
    <div class="d-flex flex-grow-1 w-100 position-relative app-body-container">

        <!-- SIDEBAR AZUL FIJO (Se extiende verticalmente sin espacios vacíos hacia el footer) -->
        <aside class="app-sidebar" style="width: @(sidebarColapsado ? "75px" : "240px"); min-width: @(sidebarColapsado ? "75px" : "240px"); background-color: #003876; flex-shrink: 0; transition: all 0.25s ease; z-index: 1020;">
            <NavMenu Colapsado="@sidebarColapsado" OnToggleSidebar="ToggleSidebar" />
        </aside>

        <!-- ÁREA DE CONTENIDO PRINCIPAL -->
        <main class="flex-grow-1 p-3 p-md-4" style="background-color: #F8F9FA; overflow-x: hidden;">
            @Body
        </main>
    </div>

    <!-- 3. FOOTER INSTITUCIONAL GLOBAL (De extremo a extremo al fondo de todo) -->
    <footer class="w-100 mt-auto" style="position: relative; z-index: 1040; background-color: #003876;">
        <FooterInstitucional />
    </footer>

</div>

<style>
    html, body {
        height: 100% !important;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background-color: #F8F9FA;
    }

    /* Header fijo superior limpio */
    .app-fixed-header {
        position: fixed;
        top: 0;
        left: 0;
        height: 70px;
        z-index: 1050;
        border-bottom: 1px solid #e2e8f0 !important;
        box-shadow: none !important;
    }

        /* Forzar a que el Header interno no genere líneas o sombras dobles */
        .app-fixed-header * {
            border-bottom: none !important;
            box-shadow: none !important;
        }

    /* Compensar el espacio superior del contenido por el header fijo */
    .app-body-container {
        margin-top: 70px;
        min-height: calc(100vh - 70px);
    }

    /* Sidebar fijo con altura total para abrazar el footer perfectamente */
    .app-sidebar {
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        overflow-y: auto;
    }
</style>

@code {
    private bool sidebarColapsado = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void ToggleSidebar() => sidebarColapsado = !sidebarColapsado;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}