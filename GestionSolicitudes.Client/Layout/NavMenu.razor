@inject NavigationManager Navigation
@inject GestionSolicitudes.Client.Services.IdiomaService Idioma
@implements IDisposable

<div class="d-flex flex-column justify-content-between h-100 py-3" style="background-color: #003876;">

    <!-- Zona Superior: Marca y Menú de Navegación -->
    <div>
        <div class="d-flex align-items-center @(Colapsado ? "justify-content-center" : "justify-content-end") px-3 mb-4 w-100">
            <button class="btn btn-sm text-white border-0 p-1" @onclick="Toggle" title="Alternar menú">
                <i class="bi @(Colapsado ? "bi-chevron-right" : "bi-chevron-left") fs-5"></i>
            </button>
        </div>

        <nav class="nav flex-column gap-1 px-2">
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <!-- 1. Dashboard -->
                    <NavLink class="nav-link text-white text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link" href="dashboard" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-fill fs-5 flex-shrink-0"></i>
                        @if (!Colapsado)
                        {
                            <span>@(Idioma.EsEspanol ? "Dashboard" : "Dashboard")</span>
                        }
                    </NavLink>

                    <!-- 2. Gestión Solicitudes -->
                    <NavLink class="nav-link text-white text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link" href="solicitudes">
                        <i class="bi bi-folder2-open fs-5 flex-shrink-0"></i>
                        @if (!Colapsado)
                        {
                            <span>@(Idioma.EsEspanol ? "Gestión Solicitudes" : "Applications")</span>
                        }
                    </NavLink>

                    <!-- 3. Revisión -->
                    <NavLink class="nav-link text-white text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link" href="revision">
                        <i class="bi bi-check2-square fs-5 flex-shrink-0"></i>
                        @if (!Colapsado)
                        {
                            <span>@(Idioma.EsEspanol ? "Revisión" : "Review")</span>
                        }
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link text-white text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link" href="mis-solicitudes" Match="NavLinkMatch.All">
                        <i class="bi bi-card-checklist fs-5 flex-shrink-0"></i>
                        @if (!Colapsado)
                        {
                            <span>@(Idioma.EsEspanol ? "Mi Expediente" : "My File")</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link text-white text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link" href="nueva-solicitud">
                        <i class="bi bi-file-earmark-plus fs-5 flex-shrink-0"></i>
                        @if (!Colapsado)
                        {
                            <span>@(Idioma.EsEspanol ? "Nueva Solicitud" : "New Application")</span>
                        }
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    <!-- Zona Inferior -->
    <div class="px-2 pt-3 border-top border-white border-opacity-10">
        <NavLink class="nav-link text-white-50 text-decoration-none d-flex align-items-center gap-3 py-2 px-3 rounded-3 custom-nav-link-portal" href="" Match="NavLinkMatch.All">
            <i class="bi bi-arrow-left-circle fs-5 flex-shrink-0 text-white"></i>
            @if (!Colapsado)
            {
                <span class="text-white small fw-semibold">@(Idioma.EsEspanol ? "Portal Residente" : "Resident Portal")</span>
            }
        </NavLink>
    </div>

</div>

<style>
    .custom-nav-link {
        transition: all 0.2s ease-in-out;
        opacity: 0.85;
        font-weight: 500;
        font-size: 0.9rem;
    }

        .custom-nav-link:hover {
            background-color: rgba(255, 255, 255, 0.12);
            opacity: 1;
            color: #ffffff !important;
        }

        .custom-nav-link.active {
            background-color: rgba(255, 255, 255, 0.22) !important;
            font-weight: 600;
            opacity: 1;
            color: #ffffff !important;
        }
</style>

@code {
    [Parameter] public bool Colapsado { get; set; } = false;
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    protected override void OnInitialized() => Idioma.OnIdiomaCambiado += RefrescarPorIdioma;
    private void RefrescarPorIdioma() => InvokeAsync(StateHasChanged);
    private async Task Toggle() => await OnToggleSidebar.InvokeAsync();
    public void Dispose() => Idioma.OnIdiomaCambiado -= RefrescarPorIdioma;
}